---
import Sculpture, { type CategoryKey } from './Sculpture.astro';
import AmbientVideo from './AmbientVideo.astro';
import VideoWall from './VideoWall.astro';
import LectureScreen from './LectureScreen.astro';
import StyleSwitch from './StyleSwitch.astro';
import MotionToggle from './MotionToggle.astro';
import { useT, type Lang } from '../i18n/ui';
import { gallery } from '../i18n/routing';
import { lectures, catName, catNameAlt, categoryList, introParts, INTRO } from '../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

/** Hall order comes from the catalogue, so it is decided in one place. */
const ORDER: CategoryKey[] = categoryList().map((c) => c.key);
/** Plinths nearer the middle of the hall stand slightly forward. */
const DEPTH = [0.86, 0.95, 1.04, 1.04, 0.95, 0.86];

const counts = lectures.reduce<Record<string, number>>((a, l) => {
  a[l.prize.category] = (a[l.prize.category] ?? 0) + 1;
  return a;
}, {});

const [introA, introConj, introB] = introParts(lang);

const cats = ORDER.map((key, i) => ({
  key,
  name: catName(key, lang),
  nameAlt: catNameAlt(key, lang),
  n: counts[key] ?? 0,
  href: gallery(lang, key),
  depth: DEPTH[i],
}));
---

<section class="hall" aria-labelledby="hall-title">
  <StyleSwitch lang={lang} current="flat" />
  <MotionToggle lang={lang} />
  <VideoWall count={11} opacity={0.5} depth={780} />
  <LectureScreen opacity={0.5} />
  <AmbientVideo opacity={0.16} />
  <div class="hall__scene" data-parallax aria-hidden="true">
    <div class="layer layer--vault" data-depth="6">
      <svg viewBox="0 0 1600 500" preserveAspectRatio="xMidYMin slice">
        <defs>
          <radialGradient id="dome" cx="0.5" cy="0.08" r="0.75">
            <stop offset="0%" stop-color="#4a3115" stop-opacity="0.95" />
            <stop offset="45%" stop-color="#2a1a0d" stop-opacity="0.7" />
            <stop offset="100%" stop-color="#120c06" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="1600" height="500" fill="url(#dome)" />
        {[300, 420, 540, 660, 780].map((r, i) => (
          <ellipse cx="800" cy="-40" rx={r * 1.9} ry={r} fill="none"
                   stroke="rgba(232,198,142,0.10)" stroke-width={i === 0 ? 1.8 : 1} />
        ))}
        {Array.from({ length: 13 }, (_, i) => {
          const a = (Math.PI * (i + 1)) / 14;
          return <line x1="800" y1="-40" x2={800 - Math.cos(a) * 1500} y2={-40 + Math.sin(a) * 790}
                       stroke="rgba(232,198,142,0.07)" stroke-width="1" />;
        })}
      </svg>
    </div>

    <div class="layer layer--glow" data-depth="4"></div>
    <div class="layer layer--colonnade" data-depth="14"></div>
    <div class="layer layer--shaft" data-depth="8"></div>
    <div class="layer layer--floor" data-depth="20"></div>
    <div class="layer layer--motes" data-depth="26">
      {Array.from({ length: 18 }, (_, i) => (
        <span style={`--x:${(i * 53) % 100}%; --d:${9 + (i % 7) * 2.4}s; --y:${(i * 37) % 70 + 15}%; --s:${0.7 + (i % 4) * 0.35};`}></span>
      ))}
    </div>
    <div class="layer layer--vignette"></div>
  </div>

  <div class="veil" data-veil aria-hidden="true"></div>

  <div class="hall__masthead">
    <h1 id="hall-title" class="hall__title">{t('site.tagline')}</h1>
    <p class="hall__hint">{t('hall.hint')}</p>
  </div>

  <nav class="hall__plinths" aria-label={t('hall.enter')}>
    {cats.map((c) => (
      <a class="plinth" href={c.href} data-cat={c.key} style={`--depth:${c.depth}`}>
        <span class="plinth__art">
          <Sculpture cat={c.key} size={185} id={`hall-${c.key}`} />
          <span class="plinth__mirror" aria-hidden="true">
            <Sculpture cat={c.key} size={185} id={`mir-${c.key}`} />
          </span>
        </span>
        <span class="plinth__name">{c.name}</span>
          <span class="plinth__name-en">{c.nameAlt}</span>
        <span class="plinth__n">{c.n > 0 ? t('hall.count', { n: c.n }) : t('hall.soon')}</span>
      </a>
    ))}
  </nav>

  <a class="intro" href={gallery(lang, INTRO)} data-cat={INTRO}>
    <span class="intro__medal" aria-hidden="true">
      <Sculpture cat={INTRO} size={150} id="hall-intro" />
    </span>
    <span class="intro__text">
      <span class="intro__eyebrow">{t('hall.nobelRoom')}</span>
      <span class="intro__title">{introA}<span class="conj">{introConj}</span>{introB}</span>
      <span class="intro__desc">{t('hall.introDesc')}</span>
    </span>
    <span class="intro__cta" aria-hidden="true">{t('hall.introCta')} →</span>
  </a>
</section>

<style>
  .hall {
    position: relative;
    min-block-size: min(100svh, 60rem);
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    padding-block: max(clamp(1.5rem, 4vh, 3.5rem), 4.4rem) clamp(3rem, 8vh, 6rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- scene ---------- */
  .hall__scene { position: absolute; inset: -6% -4%; z-index: -1; }
  .layer { position: absolute; inset: 0; will-change: transform; }

  .layer--vault svg { inline-size: 100%; block-size: min(52%, 26rem); }

  .layer--glow {
    background:
      radial-gradient(52% 40% at 50% 6%, rgba(255, 196, 106, 0.20), transparent 70%),
      radial-gradient(80% 60% at 50% 42%, rgba(150, 92, 30, 0.14), transparent 75%);
  }

  .layer--colonnade {
    background:
      linear-gradient(90deg,
        rgba(10, 6, 3, 0.96) 0%, rgba(38, 24, 12, 0.6) 5%, transparent 11%,
        transparent 89%, rgba(38, 24, 12, 0.6) 95%, rgba(10, 6, 3, 0.96) 100%),
      repeating-linear-gradient(90deg,
        transparent 0 3.2%, rgba(232, 198, 142, 0.045) 3.2% 3.35%, transparent 3.35% 6.5%);
    mask-image: linear-gradient(to bottom, #000 0 62%, transparent 88%);
  }

  .layer--shaft {
    background:
      conic-gradient(from 168deg at 50% -14%,
        transparent 0deg, rgba(255, 206, 128, 0.10) 8deg, transparent 17deg,
        transparent 343deg, rgba(255, 206, 128, 0.08) 352deg, transparent 360deg);
    mask-image: linear-gradient(to bottom, #000 0 55%, transparent 80%);
  }

  .layer--floor {
    inset-block-start: auto;
    block-size: 46%;
    inset-block-end: 0;
    background:
      linear-gradient(to bottom, rgba(58, 36, 16, 0.55), rgba(16, 10, 5, 0.98) 72%),
      repeating-linear-gradient(to bottom,
        transparent 0 5%, rgba(232, 198, 142, 0.035) 5% 5.2%, transparent 5.2% 10%);
    box-shadow: inset 0 1px 0 rgba(232, 198, 142, 0.16);
  }

  .layer--motes span {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    inline-size: 3px; block-size: 3px;
    border-radius: 50%;
    background: rgba(255, 216, 150, 0.55);
    scale: var(--s);
    animation: drift var(--d) linear infinite;
    filter: blur(0.4px);
  }
  @keyframes drift {
    0%   { transform: translate3d(0, 14px, 0); opacity: 0; }
    18%  { opacity: 0.85; }
    82%  { opacity: 0.6; }
    100% { transform: translate3d(18px, -110px, 0); opacity: 0; }
  }

  .layer--vignette {
    background: radial-gradient(78% 68% at 50% 42%, transparent 42%, rgba(9, 6, 3, 0.82) 100%);
  }

  .veil {
    position: absolute; inset: 0; z-index: 40; pointer-events: none; opacity: 0;
    background: radial-gradient(62% 62% at 50% 52%,
      color-mix(in srgb, var(--veil, #e0aa53) 92%, #fff) 0%,
      color-mix(in srgb, var(--veil, #e0aa53) 55%, #120c06) 52%,
      #120c06 100%);
    transition: opacity .55s ease-in;
  }
  .veil[data-on] { opacity: 1; }
  .hall[data-walking] .hall__plinths {
    transform: translate3d(var(--wx,0), var(--wy,0), 0) scale(2.2);
    opacity: .3;
  }
  .hall[data-walking] .hall__masthead, .hall[data-walking] .intro { opacity: 0; }
  .hall__plinths, .hall__masthead, .intro {
    transition: opacity .5s ease, transform .78s cubic-bezier(.5,0,.75,0);
  }

  /* ---------- masthead ---------- */
  .hall__masthead { text-align: center; display: grid; justify-items: center; gap: 0.45rem; padding-inline: 1rem; }
  .hall__title {
    font-size: var(--step-4);
    color: var(--cream);
    text-shadow: 0 2px 40px rgba(255, 190, 100, 0.25);
    max-inline-size: 22ch;
  }
  .hall__hint {
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.18em;
    margin-block-start: 0.6rem;
  }

  /* ---------- plinths ---------- */
  .hall__plinths {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: end;
    gap: clamp(0.25rem, 1.4vw, 1.6rem);
    inline-size: min(100% - 2rem, 82rem);
    margin: clamp(1rem, 3vh, 2.5rem) auto 0;
  }

  .plinth {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--text);
    padding: 0.5rem 0.2rem 1rem;
    border-radius: var(--radius);
    scale: var(--depth);
    transform-origin: bottom center;
    transition: scale 0.5s var(--ease), filter 0.5s var(--ease);
    --sculpt-hi: #ffe9c2;
    --sculpt-lo: #6d451a;
  }
  .plinth:focus-visible { scale: calc(var(--depth) * 1.07); filter: brightness(1.12); }
  @media (hover: hover) and (pointer: fine) {
    .plinth:hover { scale: calc(var(--depth) * 1.07); filter: brightness(1.12); }
    .hall__plinths:hover .plinth:not(:hover) { filter: brightness(0.62) saturate(0.7); }
  }

  .plinth__art { position: relative; display: block; }
  .plinth__mirror {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: 0;
    scale: 1 -1;
    opacity: 0.16;
    mask-image: linear-gradient(to top, transparent 8%, #000 78%);
    pointer-events: none;
  }

  /* the other language, set under the first — the halls name a prize the

     same way a lecture page names its laureate */

  .plinth__name-en {

    font-size: var(--step--2);

    letter-spacing: 0.06em;

    color: var(--muted);

    margin-block-start: 0.1rem;

  }


  .plinth__name {
    font-family: var(--font-han-serif);
    font-size: var(--step-0);
    color: var(--cream);
    letter-spacing: 0.06em;
    margin-block-start: 0.4rem;
    text-align: center;
  }
  .plinth:hover .plinth__name, .plinth:focus-visible .plinth__name { color: var(--accent); }
  .plinth__n { font-size: var(--step--1); color: var(--muted-dim); letter-spacing: 0.08em; }

  /* ---------- the introduction room ---------- */
  .intro {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 2rem);
    inline-size: min(100% - 2rem, 54rem);
    margin: clamp(1.75rem, 4vh, 3rem) auto 0;
    padding: 0.6rem clamp(1rem, 3vw, 1.9rem) 0.6rem 0.6rem;
    text-decoration: none;
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 999px;
    background:
      radial-gradient(60% 180% at 8% 50%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 70%),
      color-mix(in srgb, var(--bg-1) 82%, transparent);
    backdrop-filter: blur(6px);
    transition: border-color 0.4s var(--ease), transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .intro:hover, .intro:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }
  .intro__medal {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: clamp(4.2rem, 9vw, 6.2rem);
    --sculpt-hi: #ffeccb;
    --sculpt-lo: #8a6224;
  }
  /* the medal reads as an emblem here, not a statue — drop the plinth */
  .intro__medal :global(.sculpt__plinth) { display: none; }
  .intro__medal :global(.sculpt) { margin-block-end: -16%; }
  .intro__text { display: grid; gap: 0.1rem; flex: 1 1 auto; min-inline-size: 0; }
  .intro__eyebrow {
    font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent);
  }
  .intro__title { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); line-height: 1.3; }
  /* the connector is not a subject — shrink it so the two names read apart */
  .intro__title .conj {
    font-size: 0.62em; opacity: 0.7; margin-inline: 0.18em; vertical-align: 0.08em;
  }
  .intro__desc { font-size: var(--step--1); color: var(--muted); line-height: 1.6; }
  .intro__cta {
    flex: none; font-size: var(--step--1); letter-spacing: 0.1em; color: var(--gold);
    transition: translate 0.35s var(--ease);
  }
  .intro:hover .intro__cta { translate: 0.25rem 0; }
  @media (max-width: 40rem) {
    .intro { border-radius: var(--radius); padding: 1rem; flex-wrap: wrap; }
    .intro__cta { inline-size: 100%; }
  }

  @media (max-width: 60rem) {
    .hall__plinths { grid-template-columns: repeat(3, 1fr); row-gap: 1.5rem; --sculpt-w: 130px; }
    .plinth { scale: 1; }
    .plinth:hover, .plinth:focus-visible { scale: 1.05; }
    .plinth__mirror { display: none; }
  }
  @media (max-width: 30rem) {
    .hall__plinths { grid-template-columns: repeat(2, 1fr); --sculpt-w: 104px; gap: 0.5rem; }
    .hall { min-block-size: 0; }
  }

  /* clear the style switcher and the motion toggle, which stack down the
     left on narrow screens */
  @media (max-width: 34rem) {
    .hall { padding-block-start: 8.7rem; }
  }
</style>

<script>
  import { wireWalkIn } from '../scripts/walkin';
  import { motionOn } from '../scripts/motion';
  const hallEl = document.querySelector<HTMLElement>('.hall');
  const veilEl = document.querySelector<HTMLElement>('[data-veil]');
  const plinthLinks = document.querySelectorAll<HTMLAnchorElement>('.plinth[data-cat]');
  if (hallEl && veilEl && plinthLinks.length) wireWalkIn({ scene: hallEl, veil: veilEl, links: plinthLinks });

  // Pointer parallax. Cheap: one rAF, transform only, off when the visitor has turned motion off.
  const scene = document.querySelector<HTMLElement>('[data-parallax]');
  if (scene && motionOn() && window.matchMedia('(pointer: fine)').matches) {
    const layers = [...scene.querySelectorAll<HTMLElement>('.layer[data-depth]')];
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;

    const tick = () => {
      cx += (tx - cx) * 0.06;
      cy += (ty - cy) * 0.06;
      for (const el of layers) {
        const d = Number(el.dataset.depth ?? 0);
        el.style.transform = `translate3d(${(cx * d).toFixed(2)}px, ${(cy * d * 0.45).toFixed(2)}px, 0)`;
      }
      raf = Math.abs(tx - cx) > 0.05 || Math.abs(ty - cy) > 0.05 ? requestAnimationFrame(tick) : 0;
    };

    window.addEventListener('pointermove', (e) => {
      tx = (e.clientX / window.innerWidth - 0.5) * -2;
      ty = (e.clientY / window.innerHeight - 0.5) * -2;
      if (!raf) raf = requestAnimationFrame(tick);
    }, { passive: true });
  }
</script>
