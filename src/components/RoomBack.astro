---
/**
 * RoomBack.astro — the hall, held behind a page that has no hero of its own.
 *
 * The great hall pins its room and the prize and laureate pages band it
 * across their heads; these are the pages that are only a page — a list, a
 * syllabus, a colophon — and they get the room the third way: fixed behind
 * everything, veiled enough to read a paragraph over.
 *
 * It carries the museum's mark as well, because a page wearing the hall's bar
 * has no brand in it otherwise, and the mark is also the way back.
 *
 * Bright museum only. The dark site's pages have their own ground.
 */
import { home, asset } from '../i18n/routing';
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /**
   * Which room this page is read in. The hall is the museum's own; the index
   * of films, the learning area and the colophon each have a room of their
   * own now — same rotunda, differently dressed — so that walking between
   * them is walking between rooms rather than reading four documents in one.
   */
  room?: string;
}
const { lang, room = 'bright-hall' } = Astro.props;
const t = useT(lang);
---
<div class="roomback" aria-hidden="true">
  <picture>
    <source srcset={asset(`media/${room}.webp`)} type="image/webp" />
    <img src={asset(`media/${room}.jpg`)} alt="" width="1672" height="941"
         fetchpriority="high" decoding="async" />
  </picture>
</div>
{/* And again, over the page rather than under it, masked to the band at the
    top of the window — this is what the page dissolves into, and it is the
    room itself rather than an approximation of it. Same picture, same box,
    same veil, so where it is solid it is indistinguishable from what stands
    behind. See 'the band every page dissolves into' in bright.css. The
    browser has the file already; this is a second draw of one decode. */}
<div class="roomback" data-roomtop aria-hidden="true">
  <picture>
    <source srcset={asset(`media/${room}.webp`)} type="image/webp" />
    <img src={asset(`media/${room}.jpg`)} alt="" width="1672" height="941"
         decoding="async" />
  </picture>
</div>
<a class="gr__lock" href={home(lang)} aria-label={t('nav.backHall')}>
  <span class="gr__lock-name">{t('site.tagline')}</span>
</a>

<style>
  /* The same band the prize and laureate pages stand in, and the same
     measurement — see --gr-room-h in bright.css. On a phone that is the hall's
     own strip: the whole photograph across the width of the screen, uncropped,
     rather than a tall crop of it. Fixed here already; what changed is only
     how much of the picture is shown and how tall the band is. */
  /* The whole picture, never a crop of it.
   *
   * These four rooms were painted for the pages they stand behind — an index
   * of films, a learning area, a colophon — and a crop of one is a different
   * room: the dome goes, or the floor does. So the band carries the
   * photograph's own 1672:941 and the picture fills it exactly; where the
   * window is too short for that, `contain` keeps the whole of it rather than
   * taking the difference out of the top and bottom.
   *
   * It was min(100svh, 62rem) with `cover` and an object-position of 82%,
   * which is the hall's own crop — right for the hall, and wrong for these
   * the moment they stopped being the hall. */
  .roomback {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: -1;
    block-size: min(calc(100vw * 941 / 1672), min(100svh, 62rem));
    overflow: hidden;
    pointer-events: none;
  }
  .roomback picture { display: block; block-size: 100%; }
  .roomback img {
    inline-size: 100%; block-size: 100%;
    object-fit: contain;
    object-position: 50% 0;
  }
  /* The photograph, undimmed.
   *
   * It carried a white wash from its top edge down — 0.66 at the crown, 0.9
   * by the middle, the page's own white at the foot — which is what made a
   * paragraph readable over it and also what made these four rooms look like
   * a photocopy of themselves. Out, at the owner's word. What is left is the
   * join alone: nothing at all for the top three fifths, then the picture
   * giving way to the page's white by its foot, because the photograph's own
   * bottom edge is a warm grey and the page is not, and without this it ends
   * on a ruled line.
   *
   * The type that stands over it carries its own light instead — the title's
   * halo and the sentence's white edge, see .hall-note in bright.css. */
  .roomback::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom,
      transparent 0%, transparent 60%, var(--bg-0) 100%);
  }
</style>
