---
/**
 * HallBright.astro — the bright museum's entrance.
 *
 * A domed neoclassical rotunda — white marble, a glazed dome, a ring of arched
 * windows — with six gold pieces set out on the floor of it.
 *
 * The hall is a photograph, and what stands in it is placed in per cent of a
 * plate that carries the picture's own aspect ratio, so a crop moves the
 * picture and its contents together and nothing drifts off the architecture.
 *
 * The eye level is measured, and finding it takes a method a Hough transform
 * cannot give. In a
 * rotunda most of what such a fit finds are dome ribs, and those converge on
 * the dome's own axis rather than the room's horizon. But a rotunda gives up
 * its horizon another way: its 'horizontal' lines are circles, and a circle
 * photographs as a straight line only when the camera's eye is at its height.
 * Fit the rings and read off where their curvature changes sign. Six agree
 * here — balustrade, entablature, window sill and column base all dip in the
 * middle, the step foot and a floor ring both rise — and the turn falls at
 * 69.2% of the plate, on the foot of the colonnade and level with the door's
 * threshold. See scripts/crop-hall.py.
 *
 * No video wall in the apse — out at the owner's request, for a different
 * treatment. The pipeline that fed it is left standing for whatever replaces
 * it: scripts/make-backdrop-clips.py, src/data/backdrop.json and the
 * backdrop-clips workflow.
 *
 * No drifting embers, and no dust either. Embers belonged to a dark vault and
 * read as dirt on marble; motes are invisible against a hall this bright. The
 * light in this room is the photograph's own.
 */
import { useT, HTML_LANG, type Lang } from '../i18n/ui';
import { gallery, asset } from '../i18n/routing';
import { catName, catNameAlt, categoryList } from '../data/catalog';
import credits from '../../data/model-credits.json';
import HallRing from './HallRing.astro';
import ScrollCue from './ScrollCue.astro';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'zh' ? 'en' : 'zh';

/* Sittings, not lecture records: Südhof's lecture was given twice and the room
   says so. See 'A lecture, and a sitting' in catalog.ts.

   Taken from categoryList() rather than counted again here. The figure under a
   plinth and the figure on the room's own head are one statement, and the hall
   used to arrive at it by its own arithmetic over `lectures` alone — so when
   the rooms began holding both collections the plinths went on saying nine
   where the room said twelve. One source, no second sum. */
const counts = Object.fromEntries(categoryList().map((c) => [c.key, c.count]));

type Credit = { title: string; author: string; licence: string; page: string; source?: string };
const credited = credits as Record<string, Credit>;

/**
 * Anything under public/ keeps its URL forever, so a redeployed model sits
 * behind whatever the visitor already cached — GitHub Pages serves these with
 * max-age=600, and a swapped piece simply does not appear. Astro fingerprints
 * what it bundles; these it does not, so they are fingerprinted here, the same
 * way the objects hall does it.
 */
const stamp = (rel: string) => {
  const hash = createHash('sha256')
    .update(readFileSync(new URL(`../../public/${rel}`, import.meta.url)))
    .digest('hex').slice(0, 8);
  return `${asset(rel)}?v=${hash}`;
};

const cats = categoryList()
  .map((c) => c.key)
  .filter((k) => k in credited)
  .map((key) => ({
    key,
    name: catName(key, lang),
    nameAlt: catNameAlt(key, lang),
    n: counts[key] ?? 0,
    href: gallery(lang, key),
    model: stamp(`assets/models/gold/${key}.glb`),
    /* the gold poster, not the other museum's: the poster is what shows until
       the GLB decodes, and for good without WebGL */
    poster: stamp(`assets/models/gold/${key}.webp`),
    mark: stamp(`assets/marks/${key}.webp`),
    /* Built here rather than in the attribute: an object literal inside a
       template literal inside an Astro attribute loses the compiler. */
    label: catName(key, lang) + (lang === 'zh' ? '（' : ' (')
         + catNameAlt(key, lang) + (lang === 'zh' ? '）— ' : ') — ')
         + ((counts[key] ?? 0) > 0 ? t('hall.count', { n: counts[key] ?? 0 }) : t('hall.soon')),
    credit: credited[key],
  }));

/* Level with the piece, not looking down on it: 98° is eight degrees below
   the horizontal, looking a little up at the piece — the hall behind is
   photographed from the height of its own top step, near enough level. Worth
   knowing what the angle is measured from: model-viewer swings the camera
   about camera-target, which is pinned to the origin, and the origin is the
   middle of the assembly's box. So level means level with the piece's waist,
   not with the drum it stands on; any higher and the drum shows the top of
   its cap. */
const CAMERA = '35deg 98deg 1.55m';
/* The camera is pinned to the origin rather than framing each model's own box,
   so every drum sits on the same line. And the radius is pinned at both ends,
   because model-viewer will not simply take the camera it is given: left to
   itself it clamps the orbit against the model's bounds — a requested 2.6m came
   back as 2.208m — so the two limits have to agree with it. */
const CAMERA_TARGET = '0m 0m 0m';
const CAMERA_LIMIT = 'auto auto 1.55m';

/*
 * The plate: the source render with the flat crown of the dome taken off the
 * top and foreground marble off the bottom, both by scripts/crop-hall.py.
 * Everything below is in per cent of it.
 */
const PLATE = { w: 836, h: 470 };
---

<section class="bh" aria-labelledby="hall-title">
  <div class="bh__scene" aria-hidden="true">
    {/* the plate holds the photograph's own aspect ratio; everything inside is
        placed in per cent of it, so a crop moves picture and contents together */}
    <div class="bh__plate">
      <picture>
        <source srcset={asset('media/bright-hall.webp')} type="image/webp" />
        <img class="bh__photo" src={asset('media/bright-hall.jpg')} alt=""
             width={PLATE.w * 2} height={PLATE.h * 2} fetchpriority="high" decoding="async" />
      </picture>
      {/* eight lectures turning in the air of the room, behind the pieces —
          inside the plate so they are placed in per cent of the photograph,
          and before .bh__stage so they paint behind what stands on the floor */}
      <HallRing />
    </div>
  </div>

  {/* Everything the hall stands still with, on one fixed layer.
      Fixed, not held by script: a transform applied on a scroll event lands a
      frame after the compositor has already moved the page, and the row of
      pieces shivered against the room all the way down. Nothing here moves at
      all now, so there is nothing left to shiver. */}
  {/* The name stands over the page, not behind it — a museum's name is the one
      thing that is never obscured by what is on show. Everything else on the
      stage stands behind. */}
  <header class="bh__lockup">
    {/* The university's name used to stand above the title with a short gold
        accent over it; the owner had both taken off on 2026-10-04 — the
        footer and the bar still carry the name — and asked for a gold rule
        UNDER the Han title instead, the width of the title. */}
    {/* The inscription is decoration: the h1 below it carries the name for
        readers and machines, and the two are one name drawn twice — see
        'one movement, in both directions'. */}
    <div class="bh__inscr" aria-hidden="true" data-search-skip>
      <span class="bh__inscr-name">{t('site.tagline')}</span>
      <span class="bh__lock-rule"></span>
      {/* the name in the other language, from the same key, so the two lines
          cannot fall out of step when the name changes (it did, 2026-10-09) */}
      <span class="bh__title-en" lang={HTML_LANG[other]}>{useT(other)('site.tagline')}</span>
    </div>
    {/* The letters stand in a box of their own inside the h1, because the
        plate is the h1's ::before and must not move: the fold carries the
        letters, and only the letters, between the two names. */}
    <h1 id="hall-title" class="bh__title"><span class="bh__title-txt">{t('site.tagline')}</span></h1>
  </header>

  <div class="bh__stage">
  {/* Each piece is named outright rather than left to be assembled from what
      is inside it. The label's characters are split into their own elements so
      each can be turned onto the drum, and inline-block spans are a known way
      to get a name read out one letter at a time. */}
    <nav class="bh__plinths" aria-label={t('hall.enter')} data-state="in" data-search-skip>
    {cats.map((c) => (
      <a class="bh__piece" href={c.href} data-cat={c.key} aria-label={c.label}>
        <span class="bh__art">
          <model-viewer
            class="bh__mv"
            src={c.model}
            alt={t('models.alt', { what: c.credit.title, cat: c.name })}
            poster={c.poster}
            loading="lazy"
            camera-orbit={CAMERA}
            camera-target={CAMERA_TARGET}
            min-camera-orbit={CAMERA_LIMIT}
            max-camera-orbit={CAMERA_LIMIT}
            field-of-view="30deg"
            interaction-prompt="none"
            disable-zoom
            environment-image="neutral"
            exposure="1.35"
            shadow-intensity="0.55"
            shadow-softness="0.9"
            autoplay
          >
            <img class="bh__poster" slot="poster" src={c.poster} alt="" width="640" height="1280" />
          </model-viewer>
          {/* cut into the drum, where a museum puts the label — the plinth is
              part of the model, so the type is laid over its face */}
          <span class="bh__face" aria-hidden="true">
            <img class="bh__mark" src={c.mark} alt="" width="192" height="192"
                 loading="lazy" decoding="async" />
            <span class="bh__name">{c.name}</span>
            <span class="bh__name-en">{c.nameAlt}</span>
          </span>
        </span>
        {/* On a phone the name is read here rather than off the drum — see
            the note in the media query. */}
        <span class="bh__n">
          <span class="bh__cap">{c.name}</span>
          <span class="bh__count">{c.n > 0 ? t('hall.count', { n: c.n }) : t('hall.soon')}</span>
        </span>
      </a>
    ))}
    </nav>

  </div>

</section>

{/* the way on, pinned to the foot of the window — see ScrollCue */}
<ScrollCue lang={lang} href="#more" />

<style>
  /* ---------- the hall's own measurements ----------
   *
   * Everything below is placed off these rather than off the flow, because the
   * flow was placing the pieces by accident: their feet landed on the room's
   * top step because the masthead above them happened to be the height it was.
   * Move the title to the corner or put a scroll cue under the row, and six
   * gold objects float an inch above a marble floor.
   *
   * So the row is anchored to the photograph. The plate is contained, so its
   * height is whichever of the two limits binds; the drum's foot is 95.7% of
   * the way down its own frame; and the line the feet land on is 76.45% of the
   * plate.
   *
   * Not the horizon, which is 69.2%. The horizon is where something *far away*
   * stands — it is the top step at the back of the room, level with the
   * threshold — and these are not far away: each draws 380px tall, which puts
   * it a few paces in front of the camera, on the near floor. Anchoring them
   * to the horizon lifted the row 58px and stood six near objects on a distant
   * step, which reads as floating however correct the line is. 76.45% is the
   * near floor at that distance, and it is where the row was composed.
   *
   * The horizon is still wanted, but for the other thing: it is the point the
   * pieces turn about when they walk in and back out, because that is where
   * the room's parallels converge whatever is standing on the floor.
   */
  .bh {
    --plate-h: min(calc(100vw * 941 / 1672), min(100svh, 62rem));
    --horizon: calc(var(--plate-h) * 0.692);
    --floor: calc(var(--plate-h) * 0.7645);
    --pad: 0.4rem;
    --row-w: calc((100vw - 4.068 * var(--pad)) / 1.161);
    --frame-w: min(24rem, calc(var(--row-w) / 6 - 2 * var(--pad)));
    --frame-h: calc(var(--frame-w) * 2);

    position: relative;
    min-block-size: min(100svh, 62rem);
    /* Not hidden. The room and its furniture are fixed and outlive this
       section by the whole document; clipping to the section cut them away
       within a screenful. The scene clips its own plate, so nothing needs
       clipping here. */
    overflow: visible;
    /* No stacking context, and no ground of its own — the body already carries
       the page's white. Both used to be here, and both had to go so that the
       three layers could be ordered against the page rather than against each
       other: the room and the pieces below what is being read (z-index 0), the
       page over them (1), and the museum's name over that (2). Isolating this
       section capped every one of them inside it. */
  }

  /* ---------- the room ---------- */
  /* Fixed, for the whole document. The hall is not this section's backdrop any
     more, it is the page's: everything below is glass, and what it is glass
     over is this. Fixed rather than held by script — there is no scroll
     arithmetic in a room that never moves, and the compositor keeps it on its
     own layer for free.
     It stays inside .bh, which isolates, so it still paints under .bh's own
     content and under the sheet below; and .bh sets no transform or filter, so
     nothing steals the containing block back off the viewport. */
  .bh__scene {
    position: fixed; inset: 0; z-index: 0; overflow: hidden;
  }

  /* The plate is the photograph's own frame, and everything in the hall is
     positioned in per cent of it — so the wall keeps its place in the
     architecture whatever size the plate ends up.

     It is contained, not covering: the whole picture is in frame at every
     viewport and nothing is ever cropped away. The cost is that the plate no
     longer fills the hero, so it is pinned to the top and the page carries on
     beneath it — which is where the picture is emptiest floor anyway. */
  .bh__plate {
    container-type: inline-size;
    position: absolute;
    inset-inline-start: 50%; inset-block-start: 0;
    translate: -50% 0;
    aspect-ratio: 1672 / 941;
    inline-size: min(100%, calc(min(100svh, 62rem) * 1672 / 941));
    block-size: auto;
  }
  /* The only wash left, and it is a join rather than a veil: the foot of the
     picture into the page, and — on a screen wide enough that the plate cannot
     reach both edges — its sides. Without them the photograph ends on a ruled
     line, because its own edges are a warm grey and the page is white. */
  .bh__plate::after {
    content: '';
    position: absolute; inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, transparent 88%, var(--bg-0) 100%),
      linear-gradient(to right, var(--bg-0), transparent 3%,
                                transparent 97%, var(--bg-0));
  }
  .bh__photo {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%;
    object-fit: cover;
  }

  /* ---------- the stage ----------
     The same box the hall used to be, but out of the flow, so the name, the
     pieces, the introduction and the cue all stand exactly still. It lets
     everything through except the three things that are meant to be clicked. */
  .bh__stage {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 0;
    block-size: min(100svh, 62rem);
    pointer-events: none;
  }
  .bh__stage > * { pointer-events: auto; }

  /* ---------- the name ----------
   *
   * A museum's name is cut into the wall by the door, not floated over the
   * middle of the room. So it is a lockup in the corner: a gold rule, the
   * university above in small caps, the name in the Han serif, the English
   * under it — the order a chiselled inscription uses, and the order the
   * printed matter of this project already uses.
   *
   * It never moves and never leaves, which is what makes the halo necessary
   * rather than decorative: the page runs under it for the whole document, so
   * the type has to hold against marble, against gold and against whatever
   * paragraph is passing. The halo is light rather than a panel — a panel in
   * the corner of a photograph reads as a sticker. */
  .bh__lockup {
    /* Two objects at their own places, and a box that has no size of its own:
       the inscription in the corner of the room and the mark in the corner
       of the window. The fold between them is a transform and an opacity on
       each — nothing the page lays out changes during it. */
    position: fixed;
    z-index: 2;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 0;
    --swap: 0.55s;
    /* the letters' own enlargement on the mark, where the theme sets one
       (English, in bright.css); 1 is the letters as laid out */
    --mark-sx: 1;
    --mark-sy: 1;
    /* the fold's figures, written by measureFold() in the script below:
       where the mark's letters are from the inscription's, as a move of the
       centres, and how the two boxes compare in size — and the inverse, for
       the letters making the same journey the other way */
    --fold-dx: 0px;
    --fold-dy: 0px;
    --fold-kx: 1;
    --fold-ky: 1;
    --fold-ikx: 1;
    --fold-iky: 1;
    --fold-ox: 50%;
    --fold-oy: 50%;
  }

  /* ---------- the inscription ---------- */
  .bh__inscr {
    position: absolute;
    inset-block-start: clamp(4.6rem, 9vh, 7rem);
    inset-inline-start: clamp(1.1rem, 4.2vw, 3.4rem);
    display: grid;
    justify-items: start;
    /* Tight. The rule and the English below belong to the name, not beside
       it — an inscription sets its lines close and lets the space fall
       outside the block. */
    gap: 0.08rem;
    padding: 0.7rem 1.5rem 0.9rem 0;
    isolation: isolate;
    /* about the name's own centre, so that scaling the block scales the name
       onto the mark and the rule and the English line fold away under it */
    transform-origin: var(--fold-ox) var(--fold-oy);
    will-change: transform, opacity;
    transition: transform var(--swap) var(--ease), opacity var(--swap) var(--ease);
  }
  .bh__lockup[data-small] .bh__inscr {
    opacity: 0;
    transform: translate(var(--fold-dx), var(--fold-dy)) scale(var(--fold-kx), var(--fold-ky));
    pointer-events: none;
  }
  /* the halo the inscription stands in; it goes with the inscription */
  .bh__inscr::before {
    content: '';
    position: absolute;
    inset: -1.4rem -3rem -1.6rem -2.4rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(58% 62% at 34% 50%,
      rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.5) 46%, transparent 78%);
  }
  .bh__inscr-name {
    font-family: var(--font-han-serif);
    font-size: clamp(1.72rem, 3.5vw, 3rem);
    line-height: 1.12;
    color: var(--cream);
    /* Wide for a display line, because the name is the one place the hall can
       afford the air — and because letterspaced Han is what a carved lintel
       looks like. */
    letter-spacing: 0.1em;
    text-indent: 0.1em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  /* ---------- the mark ----------
     The name on its plate, in the corner of the window, laid out at its own
     size and in its own place from the first frame — the plate is cut for it
     here, at this size, and never for any other. What the fold does to it is
     an opacity, and a transform on its letters. */
  .bh__title {
    position: absolute;
    /* 1.5rem, not the keys' 0.62rem: a plate is a taller object than a key,
       and any nearer the top its ornament is cut off by the edge of the
       window. Its top edge lands on the keys' instead, which is the line the
       eye reads across a corner anyway. 0.34rem and 0.85rem are the air the
       mark kept inside its box when it was a box. */
    inset-block-start: calc(1.5rem + 0.34rem);
    inset-inline-start: calc(var(--mark-x) + 0.85rem);
    margin: 0;
    font-family: var(--font-han-serif);
    font-size: var(--step-0);
    line-height: 1.12;
    letter-spacing: 0.07em;
    text-indent: 0.07em;
    white-space: nowrap;
    opacity: 0;
    will-change: opacity;
    transition: opacity var(--swap) var(--ease);
  }
  .bh__lockup[data-small] .bh__title { opacity: 1; }
  .bh__lockup:not([data-small]) .bh__title { pointer-events: none; }
  .bh__title-txt {
    display: inline-block;
    text-indent: 0;
    transform-origin: 50% 50%;
    /* while the inscription is up, the letters stand on it, at its size */
    transform: translate(calc(-1 * var(--fold-dx)), calc(-1 * var(--fold-dy)))
               scale(var(--fold-ikx), var(--fold-iky));
    will-change: transform;
    transition: transform var(--swap) var(--ease);
  }
  .bh__lockup[data-small] .bh__title-txt {
    transform: translate(0px, 0px) scale(var(--mark-sx), var(--mark-sy));
  }

  /* ---------- one movement, in both directions ----------
   *
   * Two things happen when the hall is left behind: the inscription becomes
   * small, and it becomes a different object — a name on a plate rather than
   * three lines cut into a wall. They are one movement, at the owner's word:
   * it shrinks INTO the mark and grows back OUT of it, over the same half
   * second on the same curve in either direction.
   *
   * The name is drawn twice, and the fold is a crossing between the two: the
   * inscription scales down onto the mark's letters and fades; the mark's
   * letters, which were standing on the inscription at its size, scale down
   * to their own place as the mark fades in; the plate, cut for the mark and
   * for nothing else, simply comes up under them where it stands. Four
   * properties travel — transform and opacity, twice — and the compositor
   * can run all four whatever the page is doing: a swipe that keeps the main
   * thread busy does not drop a frame of it, which the first version of this
   * fold did. That one shrank the type itself, re-laying it out on every
   * frame, and cut the plate from the name at each size as it went — so on a
   * busy phone the fold stuttered, and the plate, wide for the big name, was
   * seen hanging off the left of the screen before sliding into place.
   *
   * Nothing waits for anything: the script sets one attribute (and, once per
   * layout, the figures the transform needs), and the stylesheet does the
   * rest in whichever direction the attribute went.
   */
  /* less motion: the mark is simply there */
  :global(html[data-motion='off']) .bh__lockup { --swap: 0s; }
  :global(html[data-motion='off']) .bh__lockup :is(.bh__inscr, .bh__title, .bh__title-txt) {
    transition: none;
  }
  /* the rule the inscription hangs from */
  /* The rule under the Han title: as wide as the title (the grid track is the
     widest line, which is that one), three pixels — a 2px hairline under a
     3rem face reads as a scratch, 4px as a bar — and gold fading toward the
     end, as the old accent did. The owner asked for it on 2026-10-04. */
  .bh__lock-rule {
    inline-size: 100%;
    block-size: 3px;
    margin-block: 0.34rem 0.6rem;
    background: linear-gradient(to right, var(--gold-orn, #b8862a) 55%, rgba(184, 134, 42, 0.25));
  }
  .bh__title-en {
    font-size: var(--step--1);
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    color: var(--muted);
    /* Tight: the English line belongs to the name above it, and more leading
       reads as a paragraph break rather than the second line of one
       inscription. The figure is negative because what separates the two is
       not this margin — it is the leading each line carries inside its own box
       plus the air Han and Latin faces leave above and below their ink. The
       INK gap is what the eye measures and what the owner set: 17.00px at
       desktop, taken to three quarters of that, so 4.25px comes off here.
       Measured, not guessed — see the note in README on measuring it again if
       either font-size changes. */
    margin-block-start: -0.196rem;
    line-height: 1.15;
  }

  /* ---------- the pieces ---------- */
  /* One row of six, set in from the walls.
   *
   * The margin at each end is meant to read as twice the space between
   * neighbours, and neither of those is a CSS length. What the eye measures is
   * drum to drum and drum to edge, and a drum fills only 67.8% of its column —
   * the rest is the air the model is framed in, plus the padding each piece
   * keeps for its focus ring. With the columns touching, that makes
   *
   *     gap    = 0.322·c + 1.356·pad
   *     margin = (W − G)/2 + 0.161·c + 0.678·pad
   *
   * for a column c in a row G across a page W. Setting margin = 2·gap and
   * substituting c = G/6 leaves G = (W − 4.068·pad) / 1.161, which is the line
   * below. Leaving the padding out of it — the first attempt — lands at 1.81
   * to 1.87 rather than 2. */
  .bh__plinths {
    /* Placed off the photograph rather than off the flow — see the note by
       .bh. The frame's foot is 95.7% of the way down it, so lifting the row by
       that much from the near floor stands the drums on it; the piece's own
       half-rem of padding comes off as well. */
    position: absolute;
    inset-inline: 0;
    margin-inline: auto;
    inset-block-start: calc(var(--floor) - 0.957 * var(--frame-h) - 0.5rem);
    inline-size: var(--row-w);
    display: grid;
    /* minmax(0, …), not 1fr. A bare 1fr floors each column at its content's
       min-content width, so a frame allowed to overrun its column drags the
       column out with it and the row grows past the screen — three of them
       cut 生理學或醫學 and 文學 in half at the right-hand edge. */
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0;
    align-items: end;
    will-change: transform;
    transition: transform 1s var(--ease), opacity 0.6s var(--ease);
  }
  .bh__piece {
    display: grid; justify-items: center; gap: 0.1rem;
    padding: 0.5rem var(--pad, 0.4rem) 0.9rem;
    text-decoration: none;
    border-radius: var(--radius);
    transition: transform 0.4s var(--ease), background 0.3s var(--ease);
  }
  /* the piece lifts; no rectangle lights up behind it — see HallModels */
  .bh__piece:hover { transform: translateY(-4px); }
  .bh__piece:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(html[data-motion='off']) .bh__piece:hover { transform: none; }
  /* the room still stands still — that is the page's ground, not motion — but
     the retreat arrives rather than travels */
  :global(html[data-motion='off']) .bh__plinths,
  :global(html[data-motion='off']) .bh__piece { transition: none; }

  /* Both the arrival and the retreat turn about the room's own vanishing
     point, and neither needs measuring: the row is anchored to the horizon, so
     where the horizon falls inside it is known in advance — 95.7% of the frame
     plus the piece's padding, the same line the drums stand on. Which means no
     script has to run before the pieces are in the right place, and none has
     to run again when the window changes. */
  .bh__plinths {
    transform-origin: 50% calc(var(--horizon) - var(--floor)
                              + 0.957 * var(--frame-h) + 0.5rem);
  }

  /* Coming in: far off and small when the page opens, walking up to their
     places over a second. It is a CSS animation rather than a scripted one so
     that it cannot flash a screenful of full-size pieces before the script
     runs, and so that it still happens with no script at all. `backwards`
     rather than `forwards`: a filled animation goes on overriding the inline
     transform afterwards, and the retreat would never take. */
  .bh__plinths { animation: bh-arrive 1s var(--ease) backwards; }
  @keyframes bh-arrive {
    from { transform: scale(0.34); opacity: 0; }
    to   { transform: none; opacity: 1; }
  }
  :global(html[data-motion='off']) .bh__plinths { animation: none; }

  /* A step forward: a tenth larger, and set down the floor.
     On `scale` and `translate` rather than on `transform`, which the arrival
     animation and the retreat both own — the three are separate properties
     and compose, so the row can be a tenth bigger and still walk in from the
     far end and still withdraw. Everything on a piece is sized in container
     units of its own frame, so the type and the device on the drum come with
     it and nothing has to be scaled twice.

     The step down is a length off the plate now, not a per cent of the row.
     Per cent of the row means per cent of whatever the labels under it happen
     to measure, and the figures below have to know where the drums' feet land
     — see --drum-foot in bright.css, which this and they now share. */
  @media (min-width: 48.0625rem) {
    .bh__plinths { scale: 1.1; translate: 0 var(--piece-drop); }
  }

  /* Gone back — and further than they were.
   *
   * One scale about the room's vanishing point, which in a one-point
   * perspective is exactly what walking away does: the row converges on the
   * centre and its feet climb toward the horizon, both for free.
   *
   * At 0.5 they went half the way. The horizon is the top step at the back of
   * the room, level with the threshold of the far door — see 'the hall's own
   * measurements' — so a scale of k leaves the feet at horizon + k(floor -
   * horizon), and 0.5 stopped them in the middle of the floor. 0.26 stands
   * them at the door, which is where the row was asked to end up: small,
   * central, and far. Below about 0.2 the six stop being separable at all. */
  /* And the scale alone barely moved them. The origin IS the horizon, so
     shrinking about it only ever closes the last 7% of the plate between the
     floor line and the far step — going from 0.5 to 0.26 lifted the row ten
     pixels and made it half the size, which reads as the pieces getting
     smaller where they stand rather than as walking away.

     So the row is also carried up the floor, by 7% of the photograph's own
     height, which puts its feet on the threshold of the door at the back of
     the room. A share of the plate rather than a length, because the door is a
     place in the picture and the picture is sized from the window.

     There is a second reason for that exact figure. The page rises over the
     room as it scrolls and the retreat fires two wheel-notches in, by which
     point the strip of figures has reached 525px on a 1440x900 window. At 7%
     the row lands just clear of it, so the walk away is seen finishing rather
     than being wiped halfway through. */
  .bh__plinths[data-state='back'] {
    /* Scale, and nothing else.
     *
     * Every version of this until now moved the row as well as shrank it, and
     * that movement is what reads as the pieces travelling up the page with
     * the scroll before they withdraw — the row leaves where it is standing,
     * arrives somewhere else, and only then is small. It should stay where it
     * stands and go back from there, which is what a scale about the room's
     * own vanishing point already does: the feet climb toward the horizon and
     * the row converges on the centre, both because that is what distance
     * looks like in a one-point perspective, and neither because anything was
     * translated.
     *
     * So the translate is left exactly as it is at rest — the step down the
     * floor the row is composed with — and only `transform` changes. The two
     * are separate properties and compose, which is what makes that possible.
     *
     * And now a walk up the floor with it, at the owner's word: two and a half
     * of the piece's own drums, taken as the drum measures once it is far off
     * rather than as it measures here. That distinction is the whole figure.
     * A drum at full size is 0.237 of its frame — 92px at 1440 — and two and a
     * half of those is 232px, which would stand the six in the dome. Two and a
     * half of the FAR drum is 64px, and 64px is what carries the feet off the
     * near floor and onto the horizon: the top step at the back of the room,
     * level with the threshold of the far door. The row lands where it was
     * always walking to.
     *
     * The figure is written inside `transform`, which the `scale: 1.1` of the
     * step forward is applied to — the individual properties resolve
     * translate, then rotate, then scale, then transform, so a length here is
     * multiplied by 1.1 on its way to the screen. Which is exactly what is
     * wanted: 2.5 x 0.26 x 0.237 x frame, times the 1.1, IS two and a half of
     * the drum as it will then be seen.
     *
     * It is one property with the scale, so the rise and the shrink are one
     * movement over the same second — the six get smaller as they go back,
     * which is the only way a thing has ever walked away.
     */
    /* And it is held at the horizon, which is the one thing 2.5 drums must
     * not walk past.
     *
     * 2.5 drums is 58.8px of screen at 1440x900 and the feet land on the top
     * step at the back of the room to within four pixels — which is what
     * makes it the right figure. But the step down the floor the row takes at
     * rest is a clamp against the window's HEIGHT (--piece-drop: 43px at
     * 1440x900, 16px at 1280x800), and the room's own depth shrinks with the
     * window's width. At 1280 the same 2.5 drums carries the six 26px past the
     * far step and stands them in the air against the back wall, which is the
     * one thing the owner has already sent this back for.
     *
     * So: two and a half drums, or the distance to the horizon, whichever is
     * the shorter. They are the same figure at 1440; at 1280 the horizon wins
     * and the row stops at the door; at 1024 and below the drums win and the
     * row is still short of it. Whichever binds, the six end up standing on
     * something.
     *
     * The second term is the row's own arithmetic: the feet at rest are
     * 1.1*0.26 of the way from the horizon back down to the floor, plus the
     * step down, so that IS how far they have to go. Both terms are divided
     * by the 1.1 the step forward applies to everything inside `transform`. */
    --walk-drums: calc(2.5 * 0.26 * 0.237 * var(--frame-h));
    --walk-door: calc((0.286 * (var(--floor) - var(--horizon)) + var(--piece-drop)) / 1.1);
    --walk: min(var(--walk-drums), var(--walk-door));
    transform: translateY(calc(-1 * var(--walk))) scale(0.26);
  }

  /* Two lines' worth whether it needs them or not. The pieces are bottom
     aligned, so one column whose count wraps — 'No lectures in this category
     yet' does, in English — lifts its whole column out of line with the other
     five. */
  .bh__n {
    font-size: var(--step--1); color: var(--muted);
    min-block-size: 2lh;
  }
  .bh__count { display: block; }
  /* the drum carries the name at this size; below, it cannot */
  .bh__cap { display: none; }




  /* ---------- the phone ----------
   *
   * Three abreast and two deep, and the whole hall inside one screen — which
   * is an arithmetic problem, not a layout one. A 1.92:1 picture shown whole
   * across a phone is a band 220px tall; the way on wants another 60; the
   * two rows of labels another 70. What is left over is what
   * the sculptures get, and on a short phone that is not much. So the frame's
   * height is that leftover, divided by two, rather than an aspect ratio —
   * a ratio would have been correct and would not have fitted.
   *
   * Nothing is cropped: the picture is still whole, there is simply less room
   * around it. */
  @media (max-width: 48rem) {
    .bh {
      --band: calc(100vw * 941 / 1672);
      /* the near floor of the band, the same 76.45% of the picture the desktop
         row stands on — it is the same photograph */
      --floor: calc(var(--band) * 0.7645);
      --foot-h: 3.9rem;        /* just the way on now, measured */
      --label-h: 2.8rem;       /* the name and the count, with their padding */
      /* The row starts inside the picture rather than under it. The sculptures
         are tall and thin, so their tops reach up into the room while the
         drums stand on the page below — which buys the height that makes them
         bigger, and reads as six pieces standing in the foreground of the
         hall rather than in a list beneath a photograph of one. */
      --pad: 0.15rem;          /* nearly all of the column is the piece here */
      /* Down the floor, to make room over their heads for the ring of stills
         that now turns on a phone too — see the media query in HallRing. The
         pieces do not get smaller for it: what binds their size here is the
         width of a third of the row, not the height left over, so the row
         simply stands further forward in the picture. */
      --top: calc(var(--band) * 0.36 + 0.9 * 0.237 * var(--piece-h));
      /* The drum, as a length: 23.7% of a piece's frame — the same reading
         the label on its face is placed against. --piece-h is that frame, and
         it is set from the width three across allows, so nothing here depends
         on anything that depends on it. */
      --drum-h: calc(0.237 * var(--piece-h));
      /* Narrow enough that the overrun below has somewhere to go. The row is
         centred, so each end piece hangs 0.15 of a column past the row's edge;
         at the full width that hung 24px off the screen and cut 生理學或醫學
         and 文學 in half. */
      --row-m: min(calc(100vw - 2.4rem), 30rem);

      /* How big a piece can be, and it is not the column.
       *
       * model-viewer fits the bounding cage into the frame, and the cage is
       * 0.56 wide to 1 tall — narrower than the frame, so the frame's *width*
       * is what sets the size and its height was carrying 11% air. Two things
       * come out of that. The frame is given the cage's own ratio, which
       * hands the air back; and the frame is allowed to overrun its column,
       * because the drum is only 76% of the frame and three drums 146px wide
       * still have 30px of daylight between them in a 125px column. Those two
       * together are the 30%.
       *
       * The overrun means the frame covers part of its neighbour's box, so it
       * is made transparent to the pointer — the drum, which is the thing
       * anyone aims at, stays inside its own column.
       *
       * 0.545, and the exact figure matters: the cage is 0.56 wide to 1 tall,
       * and model-viewer fits horizontally only while the frame is narrower
       * than that. Go wider and the fixed 30° vertical field takes over, which
       * shows 0.83 of a model that is 1.0 tall — at 0.6 the drum's foot came
       * off in a straight cut, with no ellipse and no shadow under it. Just
       * under the boundary, nothing is lost and almost no height is wasted. */
      --avail: calc((min(100svh, 62rem) - var(--top)
                     - var(--foot-h) - 2 * var(--label-h) - 1.2rem) / 2);
      /* the shared figure — see 'one piece, one size' in plinth.css — with
         the height still allowed to bind on a short phone */
      --art-w: max(3.4rem, min(var(--piece-w), calc(var(--avail) * 0.545)));
      --art-h: calc(var(--art-w) / 0.545);
      /* and the same, six across, for the far state */
      --back-row: min(calc(100vw - 0.5rem), 34rem);
      --back-h: var(--piece-back-h);
      padding-block: 0;
      min-block-size: 100svh;
    }
    .bh__scene { block-size: var(--band); }
    .bh__plate { inline-size: 100%; }

    /* the name sits over the picture's top-left corner, where the room is
       empty wall; the bar's keys stack down the opposite corner */
    .bh__inscr {
      inset-block-start: 0.7rem;
      inset-inline-start: 0.85rem;
      padding-block: 0.4rem 0.5rem;
    }
    .bh__lock-rule { block-size: 2px; margin-block: 0.2rem 0.42rem; }
    /* the English line sits under the name, not beside it — at this size the
       gap the desktop can afford reads as a paragraph break */
    .bh__inscr { gap: 0.02rem; }
    /* the same three quarters, measured at 390: 9.75px of ink gap, 2.44px off */
    .bh__title-en { margin-block-start: -0.098rem; line-height: 1.05; }
    .bh__inscr-name, .bh__title { line-height: 1.06; }
    .bh__inscr-name { font-size: clamp(1.32rem, 7.4vw, 1.9rem); }
    /* The English name is half as long again as the Han one — 16em of
       letterspaced type to 11 — and at the Han name's size it ran under the
       menu key: its last letter as 'Nobel Lecture Museum', and wrapped, with
       'Taiwan' under the key, once the name grew (2026-10-09). So it is set
       to end before the key in one line: 4.5rem is the lockup's own inset,
       the key, and the air either side of it; 16.4em the name's measure as
       rendered, which hinting widens at small sizes (15.9em at 414px, 16.4
       at 320). The inscription only — the mark has its own size. */
    .bh__inscr-name:lang(en) {
      font-size: min(clamp(1.32rem, 7.4vw, 1.9rem), calc((100vw - 4.5rem) / 16.4));
    }
    .bh__title-en { font-size: 0.62rem; letter-spacing: 0.16em; text-indent: 0.16em; }

    .bh__plinths {
      inset-block-start: var(--top);
      inline-size: var(--row-m);
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 0.25rem;
      transform-origin: 50% calc(var(--floor) - var(--top));
    }
    .bh__art {
      inline-size: var(--art-w);
      block-size: var(--art-h);
      aspect-ratio: auto;
      max-inline-size: none;
      pointer-events: none;          /* the anchor under it takes the tap */
    }
    /* And the viewer inside it, which sets its own. The frame overruns its
       column and, now that the second row stands half a pane higher, it also
       overruns the first row's captions — mostly with the empty air above a
       short piece. Nothing of it is visible there, but every one of those
       taps was landing on the wrong lecture. */
    .bh__mv, .bh__poster { pointer-events: none; }
    /* The first row on top, in that overlap. What lies in the band between
       the two rows is the first row's own caption and the empty air above the
       second row's pieces, so the tap belongs to the row above — and the
       second row's sculpture proper begins below it either way. */
    .bh__piece:nth-child(-n + 3) { position: relative; z-index: 1; }
    .bh__piece { padding: 0.25rem var(--pad) 0.35rem; }
    /* The second row comes up; the first stays exactly where it is.
       A negative row-gap would have been the obvious way and grid clamps it to
       zero, so it is a margin on the three pieces of the second row instead.
       The frame is the same height for all six and the drum sits at its foot,
       so the top of a frame holding a short piece — the dove, the quill — is
       empty; this takes that emptiness out from under the first row's captions
       and opens the space between the bottom drums and the figures below. */
    /* And the second row of three comes down nine tenths of a drum, at the
       owner's word — the first row stays where it is, so this is the
       overlap giving way rather than the whole row moving. */
    /* ...less half the height of a figure's own pane, at the owner's word:
       the second row and the strip below it come up together, so the space
       between them is unchanged and what closes is the space above. */
    .bh__piece:nth-child(n + 4) {
      margin-block-start: calc(-3.4rem + 0.9 * var(--drum-h) - 0.5 * var(--strip-h));
    }

    /* The name is cut into the drum here too — see 'one drum, one label' in
       plinth.css. What stays under the piece is the count alone, which is not
       a name and was never on the marble. */
    /* --step--1, stated, for the same reason the bar's keys take it: this
       asked for --step--2 while that token did not exist, so the count has
       been rendering at 15.3px and the row was tuned around it. */
    .bh__n { font-size: var(--step--1); line-height: 1.3; min-block-size: 0; text-align: center; }

    /* Gone back, on a phone: one line of six rather than the same six further
       off. Six across a 390px screen is 64px each, at which a name cut into a
       drum is a smudge — so the labels and the rings go with the distance,
       which is what distance does to lettering anyway. */
    /* Standing on the room's floor, not under it: the same 76.45% line the
       desktop row stands on puts them in the room rather than on the white
       page below the photograph. */
    .bh__plinths[data-state='back'] {
      transform: none;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      inline-size: var(--back-row);
      inset-block-start: calc(var(--floor) - 0.957 * var(--back-h) - 0.25rem);
    }
    .bh__plinths[data-state='back'] .bh__piece { padding-inline: 0.25rem; }
    .bh__plinths[data-state='back'] .bh__art {
      inline-size: 100%;
      block-size: var(--piece-back-h);
    }
    .bh__plinths[data-state='back'] .bh__n { display: none; }
    /* the bands are part of the drum now and go with it; only the type has
       to be told to leave */
    .bh__plinths[data-state='back'] .bh__face { opacity: 0; transition: opacity 0.5s var(--ease); }

    .bh__cue-rule { block-size: 0.95rem; }
    .bh__cue { gap: 0.16rem; padding-block-start: 0; }
    .bh__cue-txt { display: none; }
  }
</style>

<script>
  import { dressPlinths } from '../scripts/plinth';
  import { setCaught } from '../scripts/caught';
  import '../../vendor/model-viewer.min.js';

  /* The turn is an animation in the model, not auto-rotate — auto-rotate
     moves the camera, which swings the plinth round with the piece — and it
     plays from the `autoplay` in the markup. It used to be paused here when
     the visitor's system asked for reduced motion; the prize rooms and the
     laureates' pages never paused theirs, so the six stood still in the hall
     and turned one door further in. At the owner's word (2026-10-05) they
     turn everywhere, whatever the setting — and since 2026-10-10 nothing on
     the site consults that setting at all (see motion.ts). */

  /**
   * The pieces step back, once.
   *
   * Everything about where they stand is in the stylesheet — the row is
   * anchored to the photograph's own horizon and turns about its vanishing
   * point, so nothing here has to measure anything, and nothing has to run
   * again when the window changes. What is left for a script is the cue: at
   * what point on the page the six withdraw.
   *
   * And what they withdraw *to* differs. On a desktop the six stay a row of
   * six and simply go further off. On a phone they are three abreast and two
   * deep, and the far version is a single line of six — a different grid, not
   * a smaller one, which no property can tween. So the pieces are carried from
   * where they were to where they now are: measure, relayout, put each one
   * back where it started, then let go. The browser animates the rest.
   */
  const ROOM = matchMedia('(min-width: 48rem)');
  /* ---------- when ----------
   *
   * Not a wheel notch and not a share of the screen. The cue is a thing that
   * happens in the room: the reading comes up the page until it reaches the
   * feet of the six, and that is the moment they step back — the owner's rule,
   * and the only one of the three that has ever been about what is on the
   * screen rather than about how far a mouse has been rolled.
   *
   * The reading is the block under 本館推薦 — the page's first real column of
   * words — and not the strip of figures above it, which is six numbers in
   * six boxes and is chrome for the hall rather than the page beginning. That
   * is the owner's own reading of where the page starts.
   *
   * Both halves of the cue are constants, which is why no arithmetic runs on
   * scroll. The pieces are on a fixed layer, so where their feet fall on the
   * screen does not depend on how far the page has moved; the reading is in
   * the flow, so where it begins down the document does not either. The
   * distance between the two is the cue, once.
   *
   * A piece's foot is 72% of the way down its frame — where the gold ends and
   * the marble begins. That is the sculpture's own bottom edge: the drum under
   * it is the 底座, the word the owner uses for it separately, and it runs from
   * there to 95.7%. Measuring to 95.7 fired the retreat a hundred pixels early
   * — the reading arrived at the feet of the PLINTHS with the six still whole
   * and dominant, which is exactly what was reported. At 72% the page comes up
   * until the plinths are behind it and the six gold figures are standing on
   * the top edge of what is being read, and that is when they step back.
   *
   * The floor of 60px is not a second rule, it is a guard: on a phone the
   * strip of figures already stands a finger's width under the second row of
   * drums, so the measured cue there is 30-odd pixels and a nudge would fire
   * it. One wheel notch is the least scroll anyone performs on purpose. */
  const FLOOR = 60;

  const plinths = document.querySelector<HTMLElement>('.bh__plinths');
  const lockup = document.querySelector<HTMLElement>('.bh__lockup');
  const inscrName = document.querySelector<HTMLElement>('.bh__inscr-name');
  const markText = document.querySelector<HTMLElement>('.bh__title-txt');

  /* ---- the fold's figures ----
     The inscription and the mark are laid out at their own places and never
     move; the fold is a transform that carries each onto the other (see 'one
     movement, in both directions'). A transform needs to know where the two
     names' boxes are and how their sizes compare, which only layout knows, so
     it is measured here — off the offsets, which a transform does not touch,
     so this can run mid-fold — and written to the lockup for the stylesheet
     to read. Taken with gauge(), so it is re-taken when the faces arrive and
     when the window changes. */
  function measureFold() {
    if (!lockup || !inscrName || !markText) return;
    const at = (el: HTMLElement) => {
      let x = 0, y = 0;
      for (let e: HTMLElement | null = el; e && e !== lockup; e = e.offsetParent as HTMLElement | null) {
        x += e.offsetLeft; y += e.offsetTop;
      }
      return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    };
    const I = at(inscrName), M = at(markText);
    if (!I.w || !I.h || !M.w || !M.h) return;
    const cs = getComputedStyle(lockup);
    const sx = parseFloat(cs.getPropertyValue('--mark-sx')) || 1;
    const sy = parseFloat(cs.getPropertyValue('--mark-sy')) || 1;
    const kx = (M.w * sx) / I.w, ky = (M.h * sy) / I.h;
    const set = (k: string, v: string) => lockup.style.setProperty(k, v);
    set('--fold-ox', `${(inscrName.offsetLeft + I.w / 2).toFixed(1)}px`);
    set('--fold-oy', `${(inscrName.offsetTop + I.h / 2).toFixed(1)}px`);
    set('--fold-dx', `${(M.x + M.w / 2 - (I.x + I.w / 2)).toFixed(1)}px`);
    set('--fold-dy', `${(M.y + M.h / 2 - (I.y + I.h / 2)).toFixed(1)}px`);
    set('--fold-kx', kx.toFixed(4));
    set('--fold-ky', ky.toFixed(4));
    set('--fold-ikx', (1 / kx).toFixed(4));
    set('--fold-iky', (1 / ky).toFixed(4));
  }
  const ring = document.querySelector<HTMLElement>('[data-hall-ring]');
  const pieces = [...document.querySelectorAll<HTMLElement>('.bh__piece')];

  let back: boolean | null = null;

  /* the two constants, and the distance between them */
  let feet = 0;               // the drums' feet, on the screen, at rest
  let reading = 0;            // the top of the page's text, down the document
  let ringCue = 0;            // and where the ring of stills goes out

  function gauge() {
    measureFold();
    /* Only while they are standing where they stand, and only while they are
       standing still.
     *
     * Once they have gone back the measurement is of the far row, which is not
     * what the rule is about. And a row in mid-movement is not the row either:
     * the six walk in from the far end over a second when the page opens, and
     * they are carried between two grids on a phone — measured during either,
     * the feet come out wherever the animation had got to. That was the whole
     * error: 26px out on a desktop, and on a phone the cue landed at 600
     * against a true 218. */
    /* `running`, not merely present. A finished CSS animation stays in
       getAnimations() until the browser decides to drop it, and `bh-arrive`
       lingered there long enough to refuse every measurement the page ever
       got at 1440 — the cue fell back to its floor of 60. */
    const still = !plinths ||
      !plinths.getAnimations({ subtree: true }).some((a) => a.playState === 'running');
    if (back !== true && still && pieces.length) {
      feet = Math.max(...pieces.map((p) => {
        const r = (p.querySelector('.bh__art') ?? p).getBoundingClientRect();
        return r.top + 0.72 * r.height;
      }));
    }
    const text = document.querySelector('.feature__grid') ?? document.getElementById('more');
    if (text) reading = text.getBoundingClientRect().top + scrollY;
    /* The ring has a cue of its own, and it is a later one: the six withdraw
       when the reading reaches their feet, but the ring turns in the air above
       them and there is no reason for it to leave at the same moment. It goes
       when the reading has climbed to the middle of the photograph — the
       owner's rule — and it is the same reading: the block under 本館推薦.

       The photograph, not the window: the plate is the picture's own frame and
       carries its 1672:941, so half of it is a place in the room rather than a
       share of a screen. */
    const plate = document.querySelector('.bh__plate');
    if (plate && reading) {
      ringCue = Math.max(0, reading - 0.5 * plate.getBoundingClientRect().height);
    }
  }

  const cue = () => (feet && reading ? Math.max(FLOOR, reading - feet) : FLOOR);

  /** carry each piece from where it was to where it now is */
  function flip(before: DOMRect[]) {
    const after = pieces.map((p) => p.getBoundingClientRect());
    pieces.forEach((p, i) => {
      const dx = before[i].left - after[i].left;
      const dy = before[i].top - after[i].top;
      const k = after[i].width ? before[i].width / after[i].width : 1;
      p.style.transition = 'none';
      p.style.transformOrigin = 'top left';
      p.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) scale(${k.toFixed(4)})`;
    });
    void plinths!.offsetWidth;
    for (const p of pieces) {
      p.style.transition = 'transform 1s var(--ease)';
      p.style.transform = '';
    }
    /* hand the piece back to the stylesheet, or the hover lift inherits this
       transition and takes a second to happen */
    setTimeout(() => {
      for (const p of pieces) { p.style.transition = ''; p.style.transformOrigin = ''; }
    }, 1050);
  }

  function setBack(v: boolean, animate: boolean) {
    if (!plinths || v === back) return;
    const wide = ROOM.matches;
    const before = animate && !wide ? pieces.map((p) => p.getBoundingClientRect()) : null;
    back = v;
    plinths.dataset.state = v ? 'back' : 'in';
    /* one attribute, and the stylesheet crosses between the inscription and
       the mark in whichever direction it went — see 'one movement, in both
       directions' */
    lockup?.toggleAttribute('data-small', v);
    /* the bar's keys are folded behind one while the pieces are at full size
       and open with them — the attribute is the only thing the two share, and
       the button in the bar sets the same one when it is pressed */
    document.documentElement.toggleAttribute('data-nav-open', v);
    document.querySelector('.topbar__menu')?.setAttribute('aria-expanded', String(v));
    /* and the floor plan appears with the keys — see src/scripts/caught.ts */
    setCaught(v);
    if (before) flip(before);
  }

  /* the ring is not the row and is decided separately — see gauge(). The room
     is fixed for the whole document, so left alone it would turn behind the
     reading all the way down. */
  let ringGone: boolean | null = null;
  function setRingGone(v: boolean) {
    if (v === ringGone) return;
    ringGone = v;
    ring?.toggleAttribute('data-gone', v);
  }

  function step(animate = true) {
    setBack(scrollY >= cue(), animate);
    setRingGone(scrollY >= ringCue);
  }

  if (plinths) {
    /* whatever the page was restored at, the first state is simply the state */
    gauge();
    step(false);
    let ticking = false;
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { step(); ticking = false; });
    }, { passive: true });
    /* the document's height changes with the window, and so does whether the
       way on has anywhere left to point — and so do both ends of the cue */
    addEventListener('resize', () => { gauge(); step(false); }, { passive: true });
    /* Measured again whenever what was measured changes.
     *
     * The cue is two constants — where the drums' feet fall on the screen and
     * where the reading begins down the document — and both of them settle
     * late. The faces arrive after the first paint and every line of the page
     * moves down when they do; the six <model-viewer> elements upgrade after
     * that and a piece's frame is not its final height until they have. Taken
     * once at script time the cue was 26px out on a desktop and 125px out on
     * a phone, which is a quarter of the phone's.
     *
     * So: the faces, the last subresource, and an observer on a piece's own
     * frame — which catches the upgrade, and catches anything else that ever
     * changes the size of the thing the rule is measured from. None of it
     * runs on scroll. */
    const remeasure = () => { gauge(); step(false); };
    document.fonts?.ready.then(remeasure);
    addEventListener('load', remeasure, { once: true });
    /* after the six have finished walking in — the first measurement of all is
       taken while that animation is still running, and is thrown away by the
       stillness test above */
    setTimeout(remeasure, 1100);
    /* and the moment the walk in actually ends, whenever that is */
    plinths.addEventListener('animationend', remeasure);
    const frame = pieces[0]?.querySelector('.bh__art');
    if (frame && 'ResizeObserver' in window) {
      new ResizeObserver(remeasure).observe(frame);
    }
    /* crossing the width changes both the cue and the shape of the far state,
       so the row is put back and re-decided from scratch */
    ROOM.addEventListener('change', () => {
      for (const p of pieces) { p.style.transition = 'none'; p.style.transform = ''; }
      back = null;
      gauge();
      step(false);
      requestAnimationFrame(() => { for (const p of pieces) p.style.transition = ''; });
    });
  }

  /* The rings and the bent names are the same object here and on the prize
     pages, so they are drawn by one module — see src/scripts/plinth.ts. */
  dressPlinths();

  /* model-viewer has no animation to play until the GLB is in; `autoplay`
     starts it, and this makes sure, whatever the motion setting (2026-10-05) */
  for (const v of document.querySelectorAll<HTMLElement & { play?: () => void }>('.bh__mv')) {
    v.addEventListener('load', () => v.play?.());
  }

</script>
