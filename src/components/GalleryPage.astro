---
import Base from '../layouts/Base.astro';
import LectureCard from './LectureCard.astro';
import Sculpture from './Sculpture.astro';
import Explore from './Explore.astro';
import PageEmblem from './PageEmblem.astro';
import ScrollCue from './ScrollCue.astro';
import ExtLink from './ExtLink.astro';
import { useT, type Lang } from '../i18n/ui';
import { home, gallery, asset } from '../i18n/routing';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import {
  byCategory, catName, categories, factsAsOf, intro, introParts, INTRO,
  generalLinks, sittings, type GalleryKey, type CategoryKey,
} from '../data/catalog';

interface Props { lang: Lang; cat: GalleryKey }
const { lang, cat } = Astro.props;
const t = useT(lang);

import { catNameAlt } from '../data/catalog';
const title = catName(cat, lang);
/** the same prize in the other language, set under the heading */
const titleAlt = catNameAlt(cat, lang);
const recs = byCategory(cat);
/* what the room says it holds: sittings, not lecture records — Südhof's
   lecture was given twice and both are here. See catalog.ts. */
const nSittings = recs.reduce((n, l) => n + sittings(l), 0);

/** the introduction room holds the story of the prize, not lectures */
const isIntro = cat === INTRO;
const meta = isIntro ? null : categories[cat as CategoryKey];
/** a real prize category that this lecture series never covered */
const isEmpty = !isIntro && recs.length === 0;
const [introA, introConj, introB] = introParts(lang);

/* the four that belong to the prize rather than to any one of its rooms —
   see generalLinks in src/data/catalog.ts, where the video index reads them
   from too */
const links = isIntro ? generalLinks : meta!.links;
/** the prize's own pages, in this page's language */
const exploreItems = links.map((l) => ({
  url: l.url,
  title: lang === 'zh' ? l.zh : l.en,
  desc: lang === 'zh' ? l.dzh : l.den,
}));

/* NTU 共同教育中心 collects all six NTU lectures and their material; the
   CommonWealth hub is one page for the whole series. Both sit at the foot of
   every laureate's own 延伸探索, and both are about the series rather than
   about one laureate — so a prize room carries them too. The rest of that
   list is per-laureate (their Nobel lecture, their facts page, their
   interviews) and has no meaning one level up. */
const NTU_CGE = 'https://cge.ntu.edu.tw/cl_n_203079.html';
const CW_HUB = 'https://event.cw.com.tw/2026taiwanbridge/index.html';
const deeper = isIntro ? exploreItems : [
  ...exploreItems,
  { url: NTU_CGE, title: t('lec.ntuCge'), desc: t('lec.ntuCgeNote') },
  { url: CW_HUB,  title: t('lec.cwHub'),  desc: t('lec.cwHubNote') },
];

/* ---------------------------------------------------------------
 * The introduction room, which is the one room in the museum with nothing on
 * show. It carried four link cards and stood 71px taller than a 900px window,
 * which meant the laurel could never even be caught. What follows is the
 * prize itself: the will it comes from, the six doors it opens, what it has
 * added up to, and how one is decided. All of it is either in the catalogue
 * already or a matter of public record — see the note by --np-stats below.
 * ------------------------------------------------------------- */
const six = (Object.keys(categories) as CategoryKey[])
  .sort((a, b) => categories[a].order - categories[b].order)
  .map((key) => {
    const held = byCategory(key).reduce((n, l) => n + sittings(l), 0);
    return {
      key,
      name: catName(key, lang),
      nameAlt: catNameAlt(key, lang),
      href: gallery(lang, key),
      n: held,
      first: categories[key].stats.find((st) => st.key === 'first_year')?.value ?? 1901,
    };
  });

/* Summed from the six categories' own figures, which come from the Nobel
   Prize API — see scripts/fetch-prize-facts.py and the date printed under
   them. Counted per award rather than per person: Marie Curie is in physics
   and in chemistry, and the labels say 人次 / awards for that reason. */
const totals = (key: string) =>
  (Object.keys(categories) as CategoryKey[])
    .reduce((n, k) => n + (categories[k].stats.find((st) => st.key === key)?.value ?? 0), 0);
const introStats = [
  { v: '1901', zh: '首次頒發', en: 'First awarded' },
  { v: String(totals('prizes_awarded')), zh: '已頒發次數', en: 'Prizes awarded' },
  { v: String(totals('laureates')), zh: '得主人次', en: 'Laureate awards' },
  { v: String(totals('women_laureates')), zh: '女性得主人次', en: 'Awards to women' },
  { v: String(totals('years_not_awarded')), zh: '從缺次數', en: 'Times not awarded' },
];

/* ---------------------------------------------------------------
 * The bright museum shows the prize's own sculpture here, standing on the
 * same drum and lit by the same room as in the hall — a prize page is a room
 * in the museum, not a document about one. The dark site keeps its line
 * drawing.
 *
 * Fingerprinted for the same reason the hall does it: anything under public/
 * keeps its URL for ever, so a redeployed model sits behind whatever the
 * visitor already cached.
 * ------------------------------------------------------------- */
const bright = process.env.THEME === 'bright';
const stamp = (rel: string) => {
  const hash = createHash('sha256')
    .update(readFileSync(new URL(`../../public/${rel}`, import.meta.url)))
    .digest('hex').slice(0, 8);
  return `${asset(rel)}?v=${hash}`;
};
const piece = bright && !isIntro ? {
  model: stamp(`assets/models/gold/${cat}.glb`),
  poster: stamp(`assets/models/gold/${cat}.webp`),
  mark: stamp(`assets/marks/${cat}.webp`),
} : null;
/* the hall's own camera, so the piece is the same object at the same angle */
const CAMERA = '35deg 98deg 1.55m';
const CAMERA_LIMIT = 'auto auto 1.55m';
---

{/* The bright museum's prize pages carry the hall's own bar: no white band
    above the room, and the way back is a key in the corner rather than a line
    of text under the title. */}
<Base lang={lang} title={title} segments={['gallery', cat]} bare={bright}>
  {bright ? (
    <>
    {/* The hall's own room, and no band of empty page above it.
        Outside the header, and fixed: the room does not belong to the top of
        this page any more than the museum's name does — it is the room the
        page is read in, and it holds still while the page rises over it, which
        is exactly what the hall's own does. Inside the header it could only be
        absolute, and an absolute room scrolls away with its box. */}
    {/* The introduction room has a room of its own — the same rotunda, dressed
        for the prize itself rather than for one of its six. Every other prize
        page stands in the hall, because that is where its sculpture stands. */}
    <div class="gr__room" aria-hidden="true">
      <picture>
        <source srcset={asset(isIntro ? 'media/nobel-hall.webp' : 'media/bright-hall.webp')} type="image/webp" />
        <img src={asset(isIntro ? 'media/nobel-hall.jpg' : 'media/bright-hall.jpg')} alt="" width="1672" height="941"
             fetchpriority="high" decoding="async" />
      </picture>
    </div>
    {/* the same room again, over the page and masked to the band at the top of
        the window — see 'the band every page dissolves into' in bright.css.
        Immediately after the first, so every selector that reaches the room
        through its siblings reaches this one the same way. */}
    <div class="gr__room" data-roomtop aria-hidden="true">
      <picture>
        <source srcset={asset(isIntro ? 'media/nobel-hall.webp' : 'media/bright-hall.webp')} type="image/webp" />
        <img src={asset(isIntro ? 'media/nobel-hall.jpg' : 'media/bright-hall.jpg')} alt="" width="1672" height="941"
             decoding="async" />
      </picture>
    </div>

    {/* the museum's name, in the mark it folds into on the hall — and it is
        the way back, which is why the 'return to the hall' line under the
        title has gone: two doors out of one room, side by side, is one too
        many.
        Outside the header for the same reason it is outside the laureate
        page's: .gr used to isolate, and an isolated ancestor caps every
        z-index under it — the mark's 60 was counted inside the header rather
        than against the page, and the piece beside it painted over the name.
        See the note at the head of LecturePage. */}
    <a class="gr__lock" href={home(lang)} aria-label={t('nav.backHall')}>
      <span class="gr__lock-name">{t('site.tagline')}</span>
    </a>

    {/* A prize room's head is a tall band with a sculpture standing in it.
        The introduction room has no sculpture — it is about the prize itself,
        not one of the six — so it takes the head every room that is not a
        prize room takes: the emblem on a rail, the title block centred on it,
        and the sentence that says what the room is directly underneath. See
        .hall-head in bright.css. */}
    {!isIntro && (
    <header class="gr" data-cat={cat} data-fade>
      <div class="wrap gr__in">
        <div class="gr__id">
          <h1 class="gr__title">{title}</h1>
          <p class="gr__title-en">{titleAlt}</p>
          <p class="gr__n">
            {recs.length > 0 ? t('hall.count', { n: nSittings }) : t('hall.soon')}
          </p>
        </div>
      </div>
    </header>
    )}

    <ScrollCue lang={lang} href="#gr-body" />

    {/* before the sheet, and outside it: the sheet fades at the top of the
        window and the emblem is the one thing on the page that must not */}
    {isIntro && <PageEmblem src="assets/ui/wreath.webp" w={638} h={640} outside />}

    {/* The piece rides up with the page and then stops.
        It is a sticky rail rather than a scripted position: sticky is the
        compositor's own job, so the piece cannot lag a frame behind the page
        the way a scroll-driven transform does — that lag is exactly what made
        the hall's row shiver before it was pinned. The rail carries no height
        of its own and is pulled back up over the room by the piece's own
        height, so the piece stands on the floor of the photograph until the
        museum's name catches it. */}
    {piece && (
      <div class="gr__rail" aria-hidden="true">
        <div class="gr__piece">
          <span class="bh__art">
            <model-viewer
              class="bh__mv"
              src={piece.model}
              alt={t('models.alt', { what: title, cat: title })}
              poster={piece.poster}
              camera-orbit={CAMERA}
              camera-target="0m 0m 0m"
              min-camera-orbit={CAMERA_LIMIT}
              max-camera-orbit={CAMERA_LIMIT}
              field-of-view="30deg"
              interaction-prompt="none"
              disable-zoom
              environment-image="neutral"
              exposure="1.35"
              shadow-intensity="0.55"
              shadow-softness="0.9"
              autoplay
            >
              <img class="bh__poster" slot="poster" src={piece.poster} alt="" width="640" height="1280" />
            </model-viewer>
            <span class="bh__face" aria-hidden="true">
              <img class="bh__mark" src={piece.mark} alt="" width="192" height="192" decoding="async" />
              <span class="bh__name">{title}</span>
              <span class="bh__name-en">{titleAlt}</span>
            </span>
          </span>
        </div>
      </div>
    )}
    </>
  ) : (
    <header class="gh" data-cat={cat}>
      <div class="wrap gh__in">
        <div class="gh__art" aria-hidden="true"><Sculpture cat={cat} size={150} id={`gal-${cat}`} /></div>
        <div class="gh__id">
          <p class="eyebrow"><a class="gh__back" href={home(lang)}>← {t('cat.back')}</a></p>
          <h1 class="gh__title">
            {isIntro ? <>{introA}<span class="conj">{introConj}</span>{introB}</> : title}
          </h1>
          {!isIntro && <p class="gh__title-en">{titleAlt}</p>}
          <p class="gh__n">
            {isIntro ? t('hall.nobelRoom') : recs.length > 0 ? t('hall.count', { n: nSittings }) : t('hall.soon')}
          </p>
        </div>
      </div>
    </header>
  )}
  {/* Everything below the room, on its own sheet.
      The room is fixed now, so anything transparent over it shows a rotunda
      sliding under the words. The page's own white was already carrying that
      job — it was on .about, which is only most of the page — so it is one
      ground here instead, and the room is wiped by the page rising over it
      rather than scrolled away with the header. */}
  <div class="gr__sheet" data-fade>
  <span id="gr-body" class="gr__anchor"></span>

  {meta && (
    <section class="about" data-cat={cat} aria-labelledby="h-about">
      <div class="wrap about__in">
        <div class="about__prose">
          <h2 id="h-about" class="visually-hidden">{t('cat.aboutPrize')}</h2>
          <p class="about__lede">{meta.intro[lang]}</p>
          <p class="about__hist">{meta.history[lang]}</p>
        </div>
        <div class="about__figures">
          <dl class="stats">
            {meta.stats.map((s) => (
              <div class="stats__item">
                <dt>{lang === 'zh' ? s.zh : s.en}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
          <p class="asof">{t('cat.asOf', { date: factsAsOf })}</p>
        </div>
      </div>

    </section>
  )}

  {!isIntro && (
  <div class="wrap gh__body" data-cat={cat}>
      <section aria-labelledby="h-lectures">
        <h2 id="h-lectures" class="sec-h">{t('cat.lectures')}</h2>
        {isEmpty ? (
          <div class="empty">
            <h3 class="empty__t">{t('cat.emptyTitle')}</h3>
            <p class="empty__b">{t('cat.emptyBody')}</p>
          </div>
        ) : (
          <ul class="grid" role="list">
            {recs.map((rec) => <li><LectureCard lang={lang} rec={rec} /></li>)}
          </ul>
        )}
      </section>

      {/* 延伸探索, in the rail down the right — the same place and the same
          shape a laureate's page keeps it, so walking from a prize room into a
          laureate's room does not move the thing you were reading. It carries
          the prize's own official pages, which used to be a strip of keys
          wedged under the statistics halfway up this page, plus the two links
          at the foot of every laureate's list that are about the series rather
          than about one person. */}
      <aside class="lec__aside gh__aside" aria-labelledby="h-deep">
        <h3 id="h-deep" class="lec__h">{t('explore.title')}</h3>
        <ul class="links" role="list">
          {deeper.map((l, i) => (
            <li class:list={[i === 0 && 'links__key']}>
              <ExtLink lang={lang} href={l.url}>{l.title}</ExtLink>
              {l.desc && <span>{l.desc}</span>}
            </li>
          ))}
        </ul>
      </aside>
  </div>
  )}

  {/* ---------- the introduction room ----------
      The prize itself, in the order a room about it would be hung: the
      sentence it comes from, the six doors it opens, what it has added up to,
      and how one is decided. */}
  {isIntro && (
    <div class="wrap np">
      <header class="hall-head" data-cat={cat}>
        <h1 class="gr__title np__title">{introA}<span class="conj">{introConj}</span>{introB}</h1>
        {/* 關於這座獎 is out of the bright museum and hidden rather than
            removed: the dark museum is preserved as it stands. What stands
            here in daylight instead is the room's own shape, said the way the
            other three rooms say theirs — see 'the line a room is read by' in
            bright.css. */}
        <p class="gr__n np__n">{t('hall.nobelRoom')}</p>
        <p class="hall-stages">{t('nobel.stages')}</p>
      </header>
      {lang === 'zh' ? (
        <p class="np__lede hall-note"><span>
          諾貝爾獎不是一座獎，是六座。它們出自同一份遺囑、同一筆基金，
          卻由四個互不隸屬的機構分別評選，每年 12 月 10 日同時頒出。
          這一頁說的是這座獎本身：它從哪裡來，包含哪些領域，一百多年來累積了什麼，
          以及一座獎是怎麼決定的。
        </span></p>
      ) : (
        <p class="np__lede hall-note"><span>
          The Nobel Prize is not one prize but six. They come from a single
          will and a single fund, are decided by four institutions answerable
          to no common authority, and are handed over on the same day every
          year. This room is about the prize itself: where it came from, what
          it covers, what it has added up to, and how one is decided.
        </span></p>
      )}

      {/* the sentence the whole thing rests on */}
      <figure class="np__will">
        <blockquote>
          {lang === 'zh'
            ? '我全部剩餘可變現的財產，將以下列方式處理：由我的遺囑執行人將資本投資於安全的證券，設立一項基金，其利息每年以獎金的形式，分配給在前一年中為人類帶來最大福祉的人。'
            : 'The whole of my remaining realizable estate shall be dealt with in the following way: the capital shall be invested by my executors in safe securities and shall constitute a fund, the interest on which shall be annually distributed in the form of prizes to those who, during the preceding year, have conferred the greatest benefit to humankind.'}
        </blockquote>
        <figcaption>
          {lang === 'zh'
            ? '阿佛烈・諾貝爾的遺囑，1895 年 11 月 27 日簽署於巴黎'
            : 'From the will of Alfred Nobel, signed in Paris, 27 November 1895'}
        </figcaption>
      </figure>

      <section class="np__sec" aria-labelledby="np-man">
        <h2 id="np-man" class="np__h">{lang === 'zh' ? '諾貝爾其人' : 'Alfred Nobel'}</h2>
        {lang === 'zh' ? (
          <div class="np__prose">
            <p>
              阿佛烈・諾貝爾（1833–1896）是瑞典化學家與工程師，一生取得 355 項專利，
              其中最著名的是炸藥。他終身未婚，會五種語言，讀文學也寫劇本，
              晚年在義大利聖雷莫的實驗室裡度過。
            </p>
            <p>
              1895 年，他在巴黎的瑞典—挪威俱樂部簽下最後一份遺囑，
              把絕大部分財產交付信託，設立五個獎項：物理、化學、生理學或醫學、文學與和平。
              遺囑公布後在瑞典引起長達數年的爭訟，直到 1900 年諾貝爾基金會成立，
              1901 年首度頒獎。經濟學獎則是 1968 年由瑞典中央銀行捐資設立、
              1969 年首度頒發，正式名稱是「瑞典中央銀行紀念阿佛烈・諾貝爾經濟學獎」。
            </p>
            <p>
              五個獎項在斯德哥爾摩頒發，和平獎在奧斯陸——這也寫在遺囑裡，
              當時挪威與瑞典仍是同一個聯合王國。頒獎日訂在 12 月 10 日，
              諾貝爾逝世的那一天。
            </p>
          </div>
        ) : (
          <div class="np__prose">
            <p>
              Alfred Nobel (1833–1896) was a Swedish chemist and engineer who
              held 355 patents, the best known of them for dynamite. He never
              married, spoke five languages, read and wrote literature, and
              spent his last years in a laboratory at San Remo.
            </p>
            <p>
              In 1895, at the Swedish–Norwegian Club in Paris, he signed the
              last of his wills, leaving almost all of his estate in trust to
              fund five prizes: physics, chemistry, physiology or medicine,
              literature and peace. The will was contested in Sweden for years;
              the Nobel Foundation was established in 1900 and the first prizes
              were awarded in 1901. The prize in economic sciences came later —
              endowed by Sweden's central bank in 1968 and first awarded in
              1969, formally the Sveriges Riksbank Prize in Economic Sciences
              in Memory of Alfred Nobel.
            </p>
            <p>
              Five prizes are presented in Stockholm and the peace prize in
              Oslo, which the will also specifies: Norway and Sweden were one
              kingdom at the time. The date is 10 December, the day Nobel died.
            </p>
          </div>
        )}
      </section>

      <section class="np__sec" aria-labelledby="np-six">
        <h2 id="np-six" class="np__h">{lang === 'zh' ? '六個獎項' : 'The six prizes'}</h2>
        <p class="np__note">
          {lang === 'zh'
            ? '每一個都是本館的一座展廳；年份是該獎項首次頒發的年份。'
            : 'Each one is a room in this museum. The year is when that prize was first awarded.'}
        </p>
        <ul class="np__six" role="list">
          {six.map((c) => (
            <li>
              <a href={c.href} data-cat={c.key}>
                <img src={stamp(`assets/marks/${c.key}.webp`)} alt="" width="192" height="192"
                     loading="lazy" decoding="async" />
                <span class="np__six-n">{c.name}</span>
                <span class="np__six-en">{c.nameAlt}</span>
                <span class="np__six-m">
                  {c.first} · {c.n > 0 ? t('hall.count', { n: c.n }) : t('hall.soon')}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="np__sec" aria-labelledby="np-num">
        <h2 id="np-num" class="np__h">{lang === 'zh' ? '數字裡的諾貝爾獎' : 'The prize in numbers'}</h2>
        <dl class="np__stats">
          {introStats.map((st) => (
            <div>
              <dt>{lang === 'zh' ? st.zh : st.en}</dt>
              <dd>{st.v}</dd>
            </div>
          ))}
        </dl>
        <p class="np__asof">
          {t('cat.asOf', { date: factsAsOf })}
          {' '}
          {lang === 'zh'
            ? '六個獎項的數字相加，因此同一人若在兩個領域獲獎會計為兩次。'
            : 'Summed across the six prizes, so a laureate honoured in two fields is counted twice.'}
        </p>
      </section>

      <section class="np__sec" aria-labelledby="np-how">
        <h2 id="np-how" class="np__h">{lang === 'zh' ? '一座獎如何決定' : 'How a prize is decided'}</h2>
        <ol class="np__steps" role="list">
          {(lang === 'zh' ? [
            ['9 月—1 月 31 日', '提名', '委員會寄出數千份邀請，收件人是各領域的教授、歷屆得主與特定機構的成員。自我提名一律無效，提名者的名字與被提名人一同封存。'],
            ['2 月—8 月', '審議', '諾貝爾委員會篩選名單，向外部專家調閱意見，逐案寫成報告。整個過程不對外說明，也不承認任何「入圍名單」。'],
            ['10 月初', '選出', '由頒獎機構投票決定：瑞典皇家科學院（物理、化學、經濟）、卡羅林斯卡學院（生理學或醫學）、瑞典學院（文學）、挪威諾貝爾委員會（和平）。決定當日公布，不得申訴。'],
            ['12 月 10 日', '頒獎', '諾貝爾逝世紀念日。五個獎項在斯德哥爾摩音樂廳，和平獎在奧斯陸市政廳。得主須在六個月內發表一場「諾貝爾講座」。'],
          ] : [
            ['September – 31 January', 'Nomination', 'Thousands of invitations go out to professors, former laureates and members of named institutions. Nominating yourself is invalid, and the nominator’s name is sealed along with the nominee’s.'],
            ['February – August', 'Deliberation', 'The Nobel Committees narrow the field, commission opinions from outside experts and write a report on each case. None of it is explained, and no shortlist is ever acknowledged.'],
            ['Early October', 'Decision', 'The awarding institution votes: the Royal Swedish Academy of Sciences (physics, chemistry, economics), Karolinska Institutet (physiology or medicine), the Swedish Academy (literature), the Norwegian Nobel Committee (peace). It is announced the same day and cannot be appealed.'],
            ['10 December', 'Ceremony', 'The anniversary of Nobel’s death: five prizes at the Stockholm Concert Hall, the peace prize at Oslo City Hall. Each laureate must give a Nobel Lecture within six months.'],
          ]).map(([when, what, how]) => (
            <li>
              <span class="np__when">{when}</span>
              <span class="np__what">{what}</span>
              <span class="np__how">{how}</span>
            </li>
          ))}
        </ol>
        <p class="np__note">
          {lang === 'zh'
            ? '提名與審議的紀錄封存 50 年，因此每年公開的只有結果。'
            : 'Nomination and deliberation records are sealed for 50 years, so only the result is ever public.'}
        </p>
      </section>
    </div>
  )}

  {/* the prize's own pages, at the foot of the room */}
  {isIntro && <Explore lang={lang} items={exploreItems} heading={false} />}
  </div>
</Base>

<style>
  /* ---------- the prize's own room (bright museum) ----------
   *
   * A prize page opens the way the hall does: the same photograph, the same
   * piece on the same drum, the museum's name in the corner and the way on at
   * the foot. And it holds still, as the hall's does — the page is read in
   * front of the room rather than under a picture of one.
   *
   * On a desktop the photograph is cropped, as it was: the hall is the room,
   * this is a view into it, and a view can be framed. Cropped from the top,
   * keeping the floor and the colonnade, because the floor is what the piece
   * has to stand on. On a phone it is the hall's own band — the whole picture
   * across the width of the screen, uncropped, at the size the hall shows it,
   * with the piece standing in front of the bottom of it.
   *
   * The header is shorter than it was by the height of the marble drum, which
   * carries the title, the piece and the whole page that much higher up the
   * screen. The room takes the same height, so the veil at its foot finishes
   * exactly where the page's own white starts.
   */
  .gr {
    position: relative;
    block-size: var(--gr-head-h);
    display: grid;
    align-items: end;
  }
  /* Fixed, and behind everything. It is not this header's backdrop, it is the
     page's — see .gr__sheet below for the ground that wipes it. */
  .gr__room {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: -1;
    block-size: var(--gr-room-h);
    overflow: hidden;
    pointer-events: none;
  }
  .gr__room picture { display: block; block-size: 100%; }
  .gr__room img {
    inline-size: 100%; block-size: 100%;
    object-fit: cover;
    object-position: 50% 74%;
  }
  /* The introduction room's photograph is its own, painted for this page, and
     a crop of it is a different room — see the note in RoomBack. The prize
     rooms keep the hall's crop, because what they show is a view INTO the
     hall their sculpture stands in. */
  .gr[data-cat='nobel'] ~ .gr__room,
  .gr__room:has(~ * .np) {
    block-size: min(calc(100vw * 941 / 1672), min(100svh, 62rem));
  }
  .gr__room:has(~ * .np) img { object-fit: contain; object-position: 50% 0; }
  /* and the same foot as the other three rooms: nothing for the top three
     fifths, then the picture giving way to the page — see .roomback::after in
     RoomBack. The prize rooms keep 78%, because theirs is a shallow band at
     the head of a page rather than the room the page is read in. */
  .gr__room:has(~ * .np)::after {
    background: linear-gradient(to bottom,
      transparent 0%, transparent 60%, var(--bg-0) 100%);
  }
  /* the picture's own edges are a warm grey and the page is white; without
     this it ends on a ruled line */
  .gr__room::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 78%, var(--bg-0) 100%);
  }

  /* The page's own ground, and the reason the fixed room does not show
     through it. .about carried this before and .about is only most of the
     page; the lectures below it had nothing but the body's white, which a
     fixed room paints over. */
  .gr__sheet { position: relative; background: var(--bg-0); }

  /* The page dissolves before it reaches the top of the window; the band and
     its two stops are the museum's own now — see src/scripts/pagefade.ts and
     [data-fade] in bright.css. */
  /* The introduction room has no lectures and no statistics — its four cards
     are the whole page. With the heading gone (see Explore) they need the
     breathing room a section heading would have given them, and the room above
     needs to end on something rather than on an empty band. */
  /* :not(:has(.np)) — the introduction room opens with the head every room
     that is not a prize room opens with, and that head places itself; the
     padding was put here when the four cards were the whole page and it now
     lands between the museum's mark and the laurel. */
  .gr__sheet:has(.xp[data-bare]):not(:has(.np)) { padding-block-start: clamp(1.6rem, 4vw, 2.6rem); }

  /* the mark the hall's name folds into, in the same gold glass — see
     'the name, condensed' in bright.css, which this borrows outright */
  /* Fixed, not absolute. It is the museum's name: it does not belong to the
     top of this room, it belongs to the whole of it, and it has to be there
     when the piece arrives beside it. */
  .gr__lock {
    position: fixed;
    inset-block-start: 0.62rem;
    inset-inline-start: var(--mark-x);
    z-index: 2;
    padding: 0.34rem 0.85rem;
    border-radius: 0.42rem;
    text-decoration: none;
    background: var(--glass-g-bg);
    backdrop-filter: blur(6px) saturate(1.5);
    box-shadow: var(--glass-g-edge);
    transition: filter 0.28s var(--ease), transform 0.28s var(--ease);
  }
  .gr__lock:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .gr__lock .gr__lock-name { color: #2b2008; }
  .gr__lock-name {
    font-family: var(--font-han-serif);
    font-size: var(--step-0);
    letter-spacing: 0.07em;
    text-indent: 0.07em;
    color: var(--cream);
  }

  .gr__in {
    display: flex;
    align-items: flex-end;
    /* the piece stands to the left of this on its own rail, so the words are
       set in from it */
    justify-content: flex-start;
    padding-inline-start: calc(var(--gr-art) / 2 + clamp(0.8rem, 3vw, 2.6rem));
    gap: clamp(0.8rem, 3vw, 2.6rem);
    /* the floor of the crop, measured on the rendered page: below this the
       picture is fading into the page and there is nothing to stand on */
    padding-block-end: clamp(1.2rem, 3.4vh, 2.2rem);
  }
  /* The rail: no height, pulled back up over the room by exactly the piece's
     own height plus the floor's clearance, so the piece starts standing on the
     photograph's floor. Sticky from there, for the whole document. */
  .gr__rail {
    position: sticky;
    inset-block-start: var(--gr-stick);
    /* Over the band the page dissolves into, which is 10 — the same lift the
       emblem takes on the four rooms that are not prize rooms. A prize's own
       sculpture shrinks into a mark beside the museum's name and comes to
       rest exactly inside that band; at 3 the band was drawn over it and the
       piece faded out with the page it is pinned above. It is chrome, not
       reading: it does not fade. */
    z-index: 11;
    /* A hair of height, and the pull-up given straight back underneath.
       The rail has to sit its own height higher than where the flow would put
       it, and must not take that height from anything else — a bare negative
       top margin moved the page up with it and slid the first paragraph under
       the room. One pixel because a box of exactly zero height collapses its
       own two margins together and lands back where it started. */
    block-size: 1px;
    margin-block-start: calc(-1 * (var(--gr-art) + var(--gr-floor)));
    margin-block-end: calc(var(--gr-art) + var(--gr-floor) - 1px);
    pointer-events: none;
  }
  .gr__piece {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: max(1rem, calc((100vw - 76rem) / 2));
    transform-origin: 0 0;
    /* Half a drum higher than the flow puts it. The header already came up by
       a whole drum's height and took the piece with it; this is the piece
       alone, lifting off the line the title sits on so the two stop reading as
       one block. The rail underneath does not move, so nothing about when the
       piece is caught changes — that is scroll distance now, not sticky. */
    translate: 0 calc(var(--gr-drum) * -0.5);
    transition: scale 0.45s var(--ease), translate 0.45s var(--ease);
  }
  /* Caught. Full size it would stand over the lectures for the rest of the
     page, so once the visitor has gone half the piece's own height the piece
     becomes a mark of itself and takes its place beside the museum's name.
     *
     * Beside it, and measured — this was a clamp against the viewport width,
     * and the museum's name is not a share of the viewport. Below about
     * 1400px the two collided and the mark sat in the middle of the name,
     * which is what was reported off the deployed site. --lock-w is the name's
     * own rendered width, set by the script at the foot of this file, so the
     * mark clears it in both languages at every width. The fallback is the
     * Han name's measurement, for the frame before the script runs. */
  .gr__rail[data-pinned] .gr__piece {
    scale: 0.2;
    translate:
      calc(var(--mark-x) + var(--lock-w, 10.9rem) + var(--mark-over, 0px) + 0.55rem
           - max(1rem, (100vw - 76rem) / 2))
      -0.4rem;
  }
  :global(html[data-motion='off']) .gr__piece { transition: none; }
  .gr__piece .bh__art {
    /* The cage's ratio, which is not the hall's 1:2 — the two rooms frame the
       same model differently on purpose, the hall to fit six in a row and this
       to fill one. What used to follow from that was a label at two different
       heights on the drum; it does not any more, because the label is placed
       off the model rather than off the frame. See .bh__face in plinth.css. */
    inline-size: calc(var(--gr-art) * 0.545);
    block-size: var(--gr-art);
    aspect-ratio: auto;
    max-inline-size: none;
  }
  /* --gr-art, --gr-floor, --gr-stick and --gr-room-h are declared once, on the
     theme root in bright.css. They were on `.gr, .gr__rail` here — on both,
     because the rail is the header's sibling and a var set on .gr alone does
     not reach it. The room is a third sibling now and would have needed the
     same line again, which is one repetition too many for a number three
     things have to agree on. */
  .gr__id { padding-block-end: 0.2rem; }
  .gr__title {
    font-family: var(--font-han-serif);
    font-size: var(--step-3);
    color: var(--cream);
    letter-spacing: 0.04em;
    text-shadow: 0 0 3px rgba(255, 255, 255, 0.95), 0 0 12px rgba(255, 255, 255, 0.8);
  }
  .gr__title .conj { font-size: 0.55em; opacity: 0.68; margin-inline: 0.2em; vertical-align: 0.1em; }
  .gr__title-en {
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    color: var(--muted);
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
  }
  .gr__n {
    font-size: var(--step--1); color: var(--accent); letter-spacing: 0.14em;
    margin-block-start: 0.3rem;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
  }
  /* The way on, pinned to the last line of the screen and over everything —
     the same treatment as the hall's, and for the same two reasons: it belongs
     to the window rather than to the header's box, and the page that rises
     over it was painting on top of it. */
  .gr__anchor { display: block; scroll-margin-block-start: 4rem; }

  @media (max-width: 40rem) {
    /* --gr-art and --gr-head-h take their phone values on the theme root in
       bright.css. They were declared here, on the header and on the rail
       both — the rail is a sibling and every one of its numbers is built from
       --gr-art: its rest position is a negative margin of exactly the piece's
       height, so a stale value there does not merely draw the piece at the
       wrong size, it pulls the whole page up under the room and swallows the
       first paragraph. One declaration cannot go stale in one place. */
    /* Beside the museum's name, not under it. It rode underneath because the
       bar's keys used to stack down the right and there was no room on the
       line; the keys fold behind one key now, so the line is empty. The
       horizontal offset is the desktop's — measured off the name's own
       rendered width — and only the size is a phone's. */
    .gr__rail[data-pinned] .gr__piece { scale: var(--piece-back-k); }
    .gr__in { gap: 0.5rem; }
    .gr__title { font-size: var(--step-2); }
  }

  /* ==========================================================
     THE INTRODUCTION ROOM
     ==========================================================
     The one room with nothing on show, and it read like it: four link cards
     under a title, on a page 71px taller than the window it opened in — so
     the laurel could not even be caught, because there was nothing to scroll.
     What it has now is what a room about a prize would hang: the sentence it
     comes from, the six doors it opens, what it has added up to, and how one
     is decided.

     Set wider than a page of prose and narrower than the museum's grids: one
     column of 42 characters or so for the reading, with the plates and the
     figures allowed the full width. */
  /* 3.4rem, which is what every page in the bright museum opens with and what
     .hall-head measures its own placement against */
  .np { padding-block: 3.4rem 0; max-inline-size: 60rem; }
  .np__n { margin-block-start: 0; color: var(--gold); letter-spacing: 0.16em; text-indent: 0.16em; }
  :global(html[data-theme='bright']) .np__n { display: none; }
  .np__title { font-size: var(--step-3); }
  /* gold, like every other room's sub-line: the four doors sign the same way */
  /* type, colour and measure are .hall-note's, in bright.css */

  /* The will, set as an inscription rather than as a quotation: a rule down
     the side, the serif the museum keeps for the one place it speaks rather
     than labels, and no quotation marks — the attribution says what it is. */
  .np__will {
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    padding-inline-start: clamp(1rem, 3vw, 2rem);
    border-inline-start: 2px solid var(--gold-orn, #b8862a);
    /* three quarters of the column, at the owner's word — a measure, not a
       character count, so it holds its share of the page at every width */
    max-inline-size: 75%;
  }
  @media (max-width: 48rem) { .np__will { max-inline-size: none; } }
  .np__will blockquote {
    margin: 0;
    /* Source Serif for the Latin, the museum's own face for the Han.
       --font-hook reaches Noto Serif TC for Chinese, and a Ming face at this
       size is the one place in the building where the Han is set in
       something the rest of it never uses — it read as a different website
       rather than as a quotation. The museum sets every Han line in Noto
       Sans TC, including the ones it calls serif; see --font-han-serif. */
    font-family: 'Source Serif 4', var(--font-body);
    font-size: var(--step-1);
    font-weight: 450;
    line-height: 1.95;
    color: var(--cream);
    letter-spacing: 0.02em;
  }
  .np__will figcaption {
    margin-block-start: 0.7rem;
    font-size: var(--step--1);
    color: var(--gold);
    letter-spacing: 0.08em;
  }

  .np__sec { margin-block-start: clamp(2.4rem, 6vw, 4rem); }
  .np__h {
    font-family: var(--font-han-serif);
    font-size: var(--step-2);
    color: var(--cream);
    letter-spacing: 0.04em;
    padding-block-end: 0.7rem;
    border-block-end: 1px solid var(--line);
    margin: 0 0 1.2rem;
  }
  .np__note { font-size: var(--step--1); color: var(--muted); margin-block: 0 1.1rem; max-inline-size: 56ch; }
  /* the whole column, at the owner's word: the will beside it is a quotation
     and keeps its three quarters, but this is the room's own prose */
  .np__prose { display: grid; gap: 1.15rem; max-inline-size: none; }
  .np__prose p { max-inline-size: none; }
  .np__prose p { margin: 0; color: var(--text); line-height: 1.95; }

  /* ---------- the six doors ----------
     The gold marks that are cut into the drums in the hall, at the size a
     plate on a wall takes. Not cards: no border, no fill, no shadow — a rule
     under each and the mark above it, which is how a museum labels a bay. */
  /* Six across, and stated rather than fitted. auto-fit put five on a 1440
     window and dropped 文學 onto a line of its own, which reads as five
     prizes and an afterthought — and the afterthought is the one prize this
     museum has no lecture for. Three and two are the other two shapes; none
     of them ever leaves one alone on a row. */
  .np__six {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.4rem, 1.4vw, 1rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 34rem) { .np__six { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 60rem) { .np__six { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .np__six li { display: grid; }
  .np__six a {
    display: grid;
    justify-items: center;
    align-content: start;
    block-size: 100%;
    gap: 0.15rem;
    text-decoration: none;
    padding: 1rem 0.6rem 0.9rem;
    border-radius: 0.6rem;
    border: 1px solid transparent;
    border-block-end-color: var(--line);
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .np__six a:hover {
    background: rgba(255, 255, 255, 0.5);
    border-color: var(--line);
    transform: translateY(-2px);
  }
  :global(html[data-motion='off']) .np__six a:hover { transform: none; }
  .np__six img {
    inline-size: clamp(2.6rem, 6.5vw, 3.6rem);
    block-size: auto;
    margin-block-end: 0.45rem;
    /* the marks are struck gold on transparency; this sets them on the page */
    filter: drop-shadow(0 4px 9px rgba(70, 52, 16, 0.22));
  }
  .np__six-n { font-family: var(--font-han-serif); font-size: var(--step-0); color: var(--cream); text-align: center; }
  .np__six-en { font-size: var(--step--1); color: var(--muted); text-align: center; }
  /* pushed to the foot of its own plate, so the rule under six plates is one
     rule whatever the English name does — 'Physiology or Medicine' takes two
     lines and used to drop its own plate a line lower than the other five */
  .np__six-m { font-size: var(--step--2); color: var(--gold); letter-spacing: 0.06em; margin-block-start: auto; padding-block-start: 0.3rem; }

  /* ---------- the figures ----------
     The same panes the hall's own strip uses, at the same weight — a museum
     says a number the same way wherever it says one. */
  .np__stats {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7.4rem), 1fr));
  }
  .np__stats div {
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 0.85rem 0.7rem;
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.55);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 0 0 1px rgba(255, 255, 255, 0.5),
      0 1px 1px rgba(28, 42, 66, 0.05);
  }
  .np__stats dt { font-size: var(--step--2); color: var(--muted); letter-spacing: 0.04em; order: 2; }
  .np__stats dd {
    margin: 0;
    order: 1;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    color: var(--gold);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .np__asof { font-size: var(--step--2); color: var(--muted-dim); line-height: 1.7; margin-block-start: 0.8rem; max-inline-size: 62ch; }

  /* ---------- the year ----------
     A calendar, not a list: the date holds its own column so the four read as
     one year rather than as four paragraphs. */
  .np__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .np__steps li {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr);
    gap: 0.2rem clamp(1rem, 3vw, 2.2rem);
    padding-block: 1rem;
    border-block-start: 1px solid var(--line);
  }
  .np__steps li:last-child { border-block-end: 1px solid var(--line); }
  .np__when {
    grid-row: span 2;
    font-size: var(--step--1);
    color: var(--gold);
    letter-spacing: 0.06em;
    font-variant-numeric: lining-nums;
  }
  .np__what { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); }
  .np__how { font-size: var(--step--1); color: var(--muted); line-height: 1.85; }
  @media (max-width: 40rem) {
    .np__steps li { grid-template-columns: minmax(0, 1fr); }
    .np__when { grid-row: auto; }
  }

  /* ---------- header ---------- */
  .gh {
    border-block-end: 1px solid var(--line);
    background:
      radial-gradient(60% 120% at 8% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 68%),
      var(--bg-1);
    padding-block: clamp(1.8rem, 5vw, 3rem);
  }
  .gh__in { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
  .gh__art { --sculpt-hi: #ffe9c2; --sculpt-lo: #a06a2a; flex: none; }
  @media (max-width: 40rem) { .gh__art { display: none; } }
  .gh__back { text-decoration: none; color: var(--muted); }
  .gh__back:hover { color: var(--gold); }
  .gh__title { font-size: var(--step-3); color: var(--cream); margin-block-start: 0.3rem; }
  .gh__title .conj { font-size: 0.55em; opacity: 0.68; margin-inline: 0.2em; vertical-align: 0.1em; }
  .gh__title-en {
    font-family: var(--font-body);
    font-size: var(--step-0);
    letter-spacing: .08em;
    color: var(--muted);
    margin-block-start: .1rem;
  }

  .gh__n { font-size: var(--step--1); color: var(--accent); letter-spacing: 0.14em; margin-block-start: 0.3rem; }

  /* ---------- what this prize is ---------- */
  .about { border-block-end: 1px solid var(--line); background: var(--bg-0); overflow: visible; }
  .about__in {
    display: grid; gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1.8rem, 5vw, 2.8rem) clamp(1.2rem, 3vw, 1.8rem);
  }
  @media (min-width: 58rem) { .about__in { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; } }
  .about__lede { font-size: var(--step-1); line-height: 1.9; color: var(--text); max-inline-size: 56ch; }
  .about__hist {
    margin-block-start: 1rem; font-size: var(--step-0); line-height: 1.85;
    color: var(--muted); max-inline-size: 56ch;
    padding-inline-start: 1rem; border-inline-start: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .about__figures { display: grid; gap: 0.6rem; align-content: start; }
  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0.9rem; margin: 0;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); padding: 1.1rem 1.2rem;
  }
  .stats__item { text-align: start; }
  .stats dt { font-size: 0.66rem; letter-spacing: 0.1em; color: var(--muted-dim); line-height: 1.4; }
  .stats dd {
