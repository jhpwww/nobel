    transition: border-color 0.3s var(--ease), background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .cards a:hover, .cards a:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--surface-hi); transform: translateY(-2px);
  }
  .cards__t { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); line-height: 1.35; }
  .cards__d { font-size: var(--step--1); color: var(--muted); line-height: 1.65; }
  .cards__host {
    margin-block-start: 0.45rem; font-size: 0.66rem; letter-spacing: 0.08em;
    color: var(--muted-dim); font-family: var(--font-body);
  }
  .cards a:hover .cards__host { color: var(--accent); }

</style>

<script>
  import '../../vendor/model-viewer.min.js';
  import { dressPlinths } from '../scripts/plinth';
  /* one piece rather than six, but the same object — same drum, same rings,
     same name bent onto the same cylinder */
  dressPlinths();

  /* ---- where the museum's name ends ----
     The mark the piece shrinks into stands beside the name, and the name is a
     line of type, not a share of the viewport: 諾貝爾講座博物館 and 'Nobel
     Lecture Museum' are different widths, and neither of them tracks 7vw. Its
     rendered width is measured here and handed to the stylesheet. */
  const lock = document.querySelector<HTMLElement>('.gr__lock');
  const root = document.documentElement;

  /* ---- when the piece is caught ----
     The rail does the pinning — sticky is the compositor's own job, so the
     piece never lags a frame behind the page. What is decided here is only
     when it becomes a mark.

     On a desktop that is half the piece's own height of scrolling, which is
     what was asked for and is no longer the same moment as the pin: the page
     now arrives a drum's height higher, so the rail reaches the top of the
     window after about 60px. Between the two the piece stands still at full
     size, and the museum's name is drawn over it rather than under — see the
     mark's z-index of 60 in bright.css.

     On a phone the rail's own arrival is still the cue: the piece is smaller,
     the screen is shorter, and half of it is not a distance worth waiting
     through. */
  const rail = document.querySelector<HTMLElement>('.gr__rail');
  const art = document.querySelector<HTMLElement>('.gr__piece .bh__art');
  const WIDE = matchMedia('(min-width: 48.0625rem)');

  /* ---- the mark's width, and how far its plate hangs past it ----
     The mark the piece shrinks into stands beside the name, and the name is a
     line of type, not a share of the viewport: 諾貝爾講座博物館 and 'Nobel
     Lecture Museum' are different widths, and neither of them tracks 7vw. And
     the plate under it is drawn half again as wide as the name and centred on
     it, so what has to be cleared is the ornament rather than the box. Both
     are measured here and handed to the stylesheet; the museum's faces are
     self-hosted and arrive after first paint, in which the name is a
     different width again. */
  const measureMark = () => {
    if (!lock) return;
    root.style.setProperty('--lock-w', `${Math.round(lock.offsetWidth)}px`);
    const name = lock.querySelector<HTMLElement>('.gr__lock-name');
    if (!name) return;
    const nb = name.getBoundingClientRect();
    const pw = parseFloat(getComputedStyle(name, '::before').width) || 0;
    const over = nb.left + nb.width / 2 + pw / 2 - lock.getBoundingClientRect().right;
    root.style.setProperty('--mark-over', `${Math.max(0, Math.round(over))}px`);
  };
  measureMark();

  let ticking = false;
  const test = () => {
    ticking = false;
    if (rail) {
      const caught = WIDE.matches && art
        ? scrollY >= art.offsetHeight / 2
        : rail.getBoundingClientRect().top
            <= (parseFloat(getComputedStyle(rail).insetBlockStart) || 0) + 1;
      rail.toggleAttribute('data-pinned', caught);
    }
  };
  test();
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(test);
  }, { passive: true });
  addEventListener('resize', () => { measureMark(); test(); });
  WIDE.addEventListener('change', test);
  document.fonts?.ready.then(() => { measureMark(); test(); });
</script>
