---
import Base from '../layouts/Base.astro';
import LectureCard from './LectureCard.astro';
import Sculpture from './Sculpture.astro';
import Explore from './Explore.astro';
import ExtLink from './ExtLink.astro';
import { useT, type Lang } from '../i18n/ui';
import { home, asset } from '../i18n/routing';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import {
  byCategory, catName, categories, factsAsOf, intro, introParts, INTRO,
  generalLinks, type GalleryKey, type CategoryKey,
} from '../data/catalog';

interface Props { lang: Lang; cat: GalleryKey }
const { lang, cat } = Astro.props;
const t = useT(lang);

import { catNameAlt } from '../data/catalog';
const title = catName(cat, lang);
/** the same prize in the other language, set under the heading */
const titleAlt = catNameAlt(cat, lang);
const recs = byCategory(cat);

/** the introduction room holds the story of the prize, not lectures */
const isIntro = cat === INTRO;
const meta = isIntro ? null : categories[cat as CategoryKey];
/** a real prize category that this lecture series never covered */
const isEmpty = !isIntro && recs.length === 0;
const [introA, introConj, introB] = introParts(lang);

/* the four that belong to the prize rather than to any one of its rooms —
   see generalLinks in src/data/catalog.ts, where the video index reads them
   from too */
const links = isIntro ? generalLinks : meta!.links;
/** the prize's own pages, in this page's language */
const exploreItems = links.map((l) => ({
  url: l.url,
  title: lang === 'zh' ? l.zh : l.en,
  desc: lang === 'zh' ? l.dzh : l.den,
}));

/* NTU 共同教育中心 collects all six NTU lectures and their material; the
   CommonWealth hub is one page for the whole series. Both sit at the foot of
   every laureate's own 延伸探索, and both are about the series rather than
   about one laureate — so a prize room carries them too. The rest of that
   list is per-laureate (their Nobel lecture, their facts page, their
   interviews) and has no meaning one level up. */
const NTU_CGE = 'https://cge.ntu.edu.tw/cl_n_203079.html';
const CW_HUB = 'https://event.cw.com.tw/2026taiwanbridge/index.html';
const deeper = isIntro ? exploreItems : [
  ...exploreItems,
  { url: NTU_CGE, title: t('lec.ntuCge'), desc: t('lec.ntuCgeNote') },
  { url: CW_HUB,  title: t('lec.cwHub'),  desc: t('lec.cwHubNote') },
];

/* ---------------------------------------------------------------
 * The bright museum shows the prize's own sculpture here, standing on the
 * same drum and lit by the same room as in the hall — a prize page is a room
 * in the museum, not a document about one. The dark site keeps its line
 * drawing.
 *
 * Fingerprinted for the same reason the hall does it: anything under public/
 * keeps its URL for ever, so a redeployed model sits behind whatever the
 * visitor already cached.
 * ------------------------------------------------------------- */
const bright = process.env.THEME === 'bright';
const stamp = (rel: string) => {
  const hash = createHash('sha256')
    .update(readFileSync(new URL(`../../public/${rel}`, import.meta.url)))
    .digest('hex').slice(0, 8);
  return `${asset(rel)}?v=${hash}`;
};
const piece = bright && !isIntro ? {
  model: stamp(`assets/models/gold/${cat}.glb`),
  poster: stamp(`assets/models/gold/${cat}.webp`),
  mark: stamp(`assets/marks/${cat}.webp`),
} : null;
/* the hall's own camera, so the piece is the same object at the same angle */
const CAMERA = '35deg 98deg 1.55m';
const CAMERA_LIMIT = 'auto auto 1.55m';
---

{/* The bright museum's prize pages carry the hall's own bar: no white band
    above the room, and the way back is a key in the corner rather than a line
    of text under the title. */}
<Base lang={lang} title={title} segments={['gallery', cat]} bare={bright}>
  {bright ? (
    <>
    {/* The hall's own room, and no band of empty page above it.
        Outside the header, and fixed: the room does not belong to the top of
        this page any more than the museum's name does — it is the room the
        page is read in, and it holds still while the page rises over it, which
        is exactly what the hall's own does. Inside the header it could only be
        absolute, and an absolute room scrolls away with its box. */}
    <div class="gr__room" aria-hidden="true">
      <picture>
        <source srcset={asset('media/bright-hall.webp')} type="image/webp" />
        <img src={asset('media/bright-hall.jpg')} alt="" width="1672" height="941"
             fetchpriority="high" decoding="async" />
      </picture>
    </div>

    {/* the museum's name, in the mark it folds into on the hall — and it is
        the way back, which is why the 'return to the hall' line under the
        title has gone: two doors out of one room, side by side, is one too
        many.
        Outside the header for the same reason it is outside the laureate
        page's: .gr used to isolate, and an isolated ancestor caps every
        z-index under it — the mark's 60 was counted inside the header rather
        than against the page, and the piece beside it painted over the name.
        See the note at the head of LecturePage. */}
    <a class="gr__lock" href={home(lang)} aria-label={t('nav.backHall')}>
      <span class="gr__lock-name">{t('site.tagline')}</span>
    </a>

    <header class="gr" data-cat={cat}>
      <div class="wrap gr__in">
        <div class="gr__id">
          <h1 class="gr__title">
            {isIntro ? <>{introA}<span class="conj">{introConj}</span>{introB}</> : title}
          </h1>
          {!isIntro && <p class="gr__title-en">{titleAlt}</p>}
          <p class="gr__n">
            {isIntro ? t('hall.nobelRoom') : recs.length > 0 ? t('hall.count', { n: recs.length }) : t('hall.soon')}
          </p>
        </div>
      </div>

    </header>

    {/* Pinned to the last line of the screen and over everything, the way the
        hall's is — see .bh__foot in HallBright. Out of the header, because it
        no longer belongs to the header's box. */}
    <div class="gr__foot" data-gr-cue>
      <a class="bh__cue gr__cue" href="#gr-body" aria-label={t('hall.scroll')}>
        <span class="bh__cue-rule" aria-hidden="true"><i></i></span>
        <svg class="bh__cue-chev" viewBox="0 0 26 9" aria-hidden="true" focusable="false">
          <path d="M1.6 1.6 L13 7.4 L24.4 1.6" />
        </svg>
        <span class="bh__cue-txt" aria-hidden="true">{t('hall.scroll')}</span>
      </a>
    </div>

    {/* The piece rides up with the page and then stops.
        It is a sticky rail rather than a scripted position: sticky is the
        compositor's own job, so the piece cannot lag a frame behind the page
        the way a scroll-driven transform does — that lag is exactly what made
        the hall's row shiver before it was pinned. The rail carries no height
        of its own and is pulled back up over the room by the piece's own
        height, so the piece stands on the floor of the photograph until the
        museum's name catches it. */}
    {/* The introduction room has no sculpture — it is about the prize itself,
        not about one of the six — and it stood with an empty floor beside its
        title while every other room had something on it. The laurel takes that
        place: the same rail, the same size, the same rest and the same catch
        into a mark. Its centre is open, so what is inside the wreath is the
        rotunda seen through it, which is a better thing to put there than
        anything that could have been drawn in. */}
    {bright && isIntro && (
      <div class="gr__rail" aria-hidden="true">
        <div class="gr__piece">
          <span class="bh__art gr__wreath">
            <img src={stamp('assets/ui/wreath.webp')} alt="" width="638" height="640"
                 fetchpriority="high" decoding="async" />
          </span>
        </div>
      </div>
    )}

    {piece && (
      <div class="gr__rail" aria-hidden="true">
        <div class="gr__piece">
          <span class="bh__art">
            <model-viewer
              class="bh__mv"
              src={piece.model}
              alt={t('models.alt', { what: title, cat: title })}
              poster={piece.poster}
              camera-orbit={CAMERA}
              camera-target="0m 0m 0m"
              min-camera-orbit={CAMERA_LIMIT}
              max-camera-orbit={CAMERA_LIMIT}
              field-of-view="30deg"
              interaction-prompt="none"
              disable-zoom
              environment-image="neutral"
              exposure="1.35"
              shadow-intensity="0.55"
              shadow-softness="0.9"
              autoplay
            >
              <img class="bh__poster" slot="poster" src={piece.poster} alt="" width="640" height="1280" />
            </model-viewer>
            <span class="bh__face" aria-hidden="true">
              <img class="bh__mark" src={piece.mark} alt="" width="192" height="192" decoding="async" />
              <span class="bh__name">{title}</span>
              <span class="bh__name-en">{titleAlt}</span>
            </span>
          </span>
        </div>
      </div>
    )}
    </>
  ) : (
    <header class="gh" data-cat={cat}>
      <div class="wrap gh__in">
        <div class="gh__art" aria-hidden="true"><Sculpture cat={cat} size={150} id={`gal-${cat}`} /></div>
        <div class="gh__id">
          <p class="eyebrow"><a class="gh__back" href={home(lang)}>← {t('cat.back')}</a></p>
          <h1 class="gh__title">
            {isIntro ? <>{introA}<span class="conj">{introConj}</span>{introB}</> : title}
          </h1>
          {!isIntro && <p class="gh__title-en">{titleAlt}</p>}
          <p class="gh__n">
            {isIntro ? t('hall.nobelRoom') : recs.length > 0 ? t('hall.count', { n: recs.length }) : t('hall.soon')}
          </p>
        </div>
      </div>
    </header>
  )}
  {/* Everything below the room, on its own sheet.
      The room is fixed now, so anything transparent over it shows a rotunda
      sliding under the words. The page's own white was already carrying that
      job — it was on .about, which is only most of the page — so it is one
      ground here instead, and the room is wiped by the page rising over it
      rather than scrolled away with the header. */}
  <div class="gr__sheet">
  <span id="gr-body" class="gr__anchor"></span>

  {meta && (
    <section class="about" data-cat={cat} aria-labelledby="h-about">
      <div class="wrap about__in">
        <div class="about__prose">
          <h2 id="h-about" class="visually-hidden">{t('cat.aboutPrize')}</h2>
          <p class="about__lede">{meta.intro[lang]}</p>
          <p class="about__hist">{meta.history[lang]}</p>
        </div>
        <div class="about__figures">
          <dl class="stats">
            {meta.stats.map((s) => (
              <div class="stats__item">
                <dt>{lang === 'zh' ? s.zh : s.en}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
          <p class="asof">{t('cat.asOf', { date: factsAsOf })}</p>
        </div>
      </div>

    </section>
  )}

  {!isIntro && (
  <div class="wrap gh__body" data-cat={cat}>
      <section aria-labelledby="h-lectures">
        <h2 id="h-lectures" class="sec-h">{t('cat.lectures')}</h2>
        {isEmpty ? (
          <div class="empty">
            <h3 class="empty__t">{t('cat.emptyTitle')}</h3>
            <p class="empty__b">{t('cat.emptyBody')}</p>
          </div>
        ) : (
          <ul class="grid" role="list">
            {recs.map((rec) => <li><LectureCard lang={lang} rec={rec} /></li>)}
          </ul>
        )}
      </section>

      {/* 延伸探索, in the rail down the right — the same place and the same
          shape a laureate's page keeps it, so walking from a prize room into a
          laureate's room does not move the thing you were reading. It carries
          the prize's own official pages, which used to be a strip of keys
          wedged under the statistics halfway up this page, plus the two links
          at the foot of every laureate's list that are about the series rather
          than about one person. */}
      <aside class="lec__aside gh__aside" aria-labelledby="h-deep">
        <h3 id="h-deep" class="lec__h">{t('explore.title')}</h3>
        <ul class="links" role="list">
          {deeper.map((l, i) => (
            <li class:list={[i === 0 && 'links__key']}>
              <ExtLink lang={lang} href={l.url}>{l.title}</ExtLink>
              {l.desc && <span>{l.desc}</span>}
            </li>
          ))}
        </ul>
      </aside>
  </div>
  )}

  {/* The introduction room has no lectures and no rail: its four cards are the
      whole page, so they stay a section rather than a sidebar. */}
  {isIntro && <Explore lang={lang} items={exploreItems} heading={false} />}
  </div>
</Base>

<style>
  /* ---------- the prize's own room (bright museum) ----------
   *
   * A prize page opens the way the hall does: the same photograph, the same
   * piece on the same drum, the museum's name in the corner and the way on at
   * the foot. And it holds still, as the hall's does — the page is read in
   * front of the room rather than under a picture of one.
   *
   * On a desktop the photograph is cropped, as it was: the hall is the room,
   * this is a view into it, and a view can be framed. Cropped from the top,
   * keeping the floor and the colonnade, because the floor is what the piece
   * has to stand on. On a phone it is the hall's own band — the whole picture
   * across the width of the screen, uncropped, at the size the hall shows it,
   * with the piece standing in front of the bottom of it.
   *
   * The header is shorter than it was by the height of the marble drum, which
   * carries the title, the piece and the whole page that much higher up the
   * screen. The room takes the same height, so the veil at its foot finishes
   * exactly where the page's own white starts.
   */
  .gr {
    position: relative;
    block-size: var(--gr-head-h);
    display: grid;
    align-items: end;
  }
  /* Fixed, and behind everything. It is not this header's backdrop, it is the
     page's — see .gr__sheet below for the ground that wipes it. */
  .gr__room {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: -1;
    block-size: var(--gr-room-h);
    overflow: hidden;
    pointer-events: none;
  }
  .gr__room picture { display: block; block-size: 100%; }
  .gr__room img {
    inline-size: 100%; block-size: 100%;
    object-fit: cover;
    object-position: 50% 74%;
  }
  /* the picture's own edges are a warm grey and the page is white; without
     this it ends on a ruled line */
  .gr__room::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 78%, var(--bg-0) 100%);
  }

  /* The page's own ground, and the reason the fixed room does not show
     through it. .about carried this before and .about is only most of the
     page; the lectures below it had nothing but the body's white, which a
     fixed room paints over. */
  .gr__sheet { position: relative; background: var(--bg-0); }

  /* ---------- the page dissolves before it reaches the top ----------
   *
   * The room is pinned behind the page, and a page that scrolls all the way to
   * the top edge of the window covers the top of the photograph for good — the
   * dome, the windows, the whole upper half of the room the visitor came in
   * through. So the page stops short of it: everything above twice the height
   * of the museum's mark is gone, and the band between is a gradient.
   *
   * A mask, because the page has to become transparent rather than be painted
   * over: what is behind it is a photograph, and a white bar across the top of
   * a photograph is exactly the thing being avoided.
   *
   * The two stops are in the element's own coordinates and are set by the
   * script at the foot of this file, because a mask has no `fixed` attachment
   * the way a background does and the band has to stay put in the WINDOW while
   * the element slides under it. Off-element by default, so the page is whole
   * before it has been scrolled and whole with no script at all. */
  .gr,
  .gr__sheet {
    -webkit-mask-image: linear-gradient(to bottom,
      transparent var(--fade-a, -9999px), #000 var(--fade-b, -9998px));
    mask-image: linear-gradient(to bottom,
      transparent var(--fade-a, -9999px), #000 var(--fade-b, -9998px));
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  /* The introduction room has no lectures and no statistics — its four cards
     are the whole page. With the heading gone (see Explore) they need the
     breathing room a section heading would have given them, and the room above
     needs to end on something rather than on an empty band. */
  .gr__sheet:has(.xp[data-bare]) { padding-block-start: clamp(1.6rem, 4vw, 2.6rem); }

  /* the mark the hall's name folds into, in the same gold glass — see
     'the name, condensed' in bright.css, which this borrows outright */
  /* Fixed, not absolute. It is the museum's name: it does not belong to the
     top of this room, it belongs to the whole of it, and it has to be there
     when the piece arrives beside it. */
  .gr__lock {
    position: fixed;
    inset-block-start: 0.62rem;
    inset-inline-start: clamp(0.7rem, 2.2vw, 1.6rem);
    z-index: 2;
    padding: 0.34rem 0.85rem;
    border-radius: 0.42rem;
    text-decoration: none;
    background: var(--glass-g-bg);
    backdrop-filter: blur(6px) saturate(1.5);
    box-shadow: var(--glass-g-edge);
    transition: filter 0.28s var(--ease), transform 0.28s var(--ease);
  }
  .gr__lock:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .gr__lock .gr__lock-name { color: #2b2008; }
  .gr__lock-name {
    font-family: var(--font-han-serif);
    font-size: var(--step-0);
    letter-spacing: 0.07em;
    text-indent: 0.07em;
    color: var(--cream);
  }

  .gr__in {
    display: flex;
    align-items: flex-end;
    /* the piece stands to the left of this on its own rail, so the words are
       set in from it */
    justify-content: flex-start;
    padding-inline-start: calc(var(--gr-art) / 2 + clamp(0.8rem, 3vw, 2.6rem));
    gap: clamp(0.8rem, 3vw, 2.6rem);
    /* the floor of the crop, measured on the rendered page: below this the
       picture is fading into the page and there is nothing to stand on */
    padding-block-end: clamp(1.2rem, 3.4vh, 2.2rem);
  }
  /* The rail: no height, pulled back up over the room by exactly the piece's
     own height plus the floor's clearance, so the piece starts standing on the
     photograph's floor. Sticky from there, for the whole document. */
  .gr__rail {
    position: sticky;
    inset-block-start: var(--gr-stick);
    z-index: 3;
    /* A hair of height, and the pull-up given straight back underneath.
       The rail has to sit its own height higher than where the flow would put
       it, and must not take that height from anything else — a bare negative
       top margin moved the page up with it and slid the first paragraph under
       the room. One pixel because a box of exactly zero height collapses its
       own two margins together and lands back where it started. */
    block-size: 1px;
    margin-block-start: calc(-1 * (var(--gr-art) + var(--gr-floor)));
    margin-block-end: calc(var(--gr-art) + var(--gr-floor) - 1px);
    pointer-events: none;
  }
  .gr__piece {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: max(1rem, calc((100vw - 76rem) / 2));
    transform-origin: 0 0;
    /* Half a drum higher than the flow puts it. The header already came up by
       a whole drum's height and took the piece with it; this is the piece
       alone, lifting off the line the title sits on so the two stop reading as
       one block. The rail underneath does not move, so nothing about when the
       piece is caught changes — that is scroll distance now, not sticky. */
    translate: 0 calc(var(--gr-drum) * -0.5);
    transition: scale 0.45s var(--ease), translate 0.45s var(--ease);
  }
  /* Caught. Full size it would stand over the lectures for the rest of the
     page, so once the visitor has gone half the piece's own height the piece
     becomes a mark of itself and takes its place beside the museum's name.
     *
     * Beside it, and measured — this was a clamp against the viewport width,
     * and the museum's name is not a share of the viewport. Below about
     * 1400px the two collided and the mark sat in the middle of the name,
     * which is what was reported off the deployed site. --lock-w is the name's
     * own rendered width, set by the script at the foot of this file, so the
     * mark clears it in both languages at every width. The fallback is the
     * Han name's measurement, for the frame before the script runs. */
  .gr__rail[data-pinned] .gr__piece {
    scale: 0.2;
    translate:
      calc(clamp(0.7rem, 2.2vw, 1.6rem) + var(--lock-w, 10.9rem) + 0.55rem
           - max(1rem, (100vw - 76rem) / 2))
      -0.4rem;
  }
  :global(html[data-motion='off']) .gr__piece { transition: none; }
  /* The laurel is a flat emblem, not a model in a cage, so it fills the frame
     rather than being fitted into 0.56 of it — and it is set on the floor of
     the room the same way the drums are, by its own foot rather than by its
     box's. */
  /* ---------- the introduction room's laurel ----------
   * Hung from the museum's mark rather than centred in the frame the six
   * sculptures use. The relationship asked for is a plain one — the wreath
   * begins 15% of its own height below the mark — and the arithmetic that
   * follows from it is only ugly because the frame it lives in is measured
   * from the bottom of the header while the mark is measured from the top of
   * the window.
   *
   *   wreath top  = --lock-bottom + 0.15 x wreath height
   *   wreath height = 0.624 x --gr-art        (a fifth off the 78% it was)
   *   frame top   = --gr-head-h - --gr-art - --gr-floor - 0.5 x --gr-drum
   *
   * Subtract the second from the first and the offset below is what is left.
   * Checked at 1280x800 and 1440x900: the gap comes out at 28.5 and 31.5px,
   * which is 15% of 190 and of 210. */
  .gr__wreath {
    display: grid;
    justify-items: center;
    align-items: start;
    container-type: normal;      /* nothing inside is sized against it */
    padding-block-start: calc(var(--lock-bottom) + 1.1841 * var(--gr-art)
                              + var(--gr-floor) - var(--gr-head-h));
  }
  /* Sized outright rather than as a share of the frame. The frame is portrait
     and the laurel is square, so a percentage of the frame's HEIGHT was never
     the picture's height — `object-fit: contain` letterboxed it inside the box
     and the drawn wreath was whatever the frame's width allowed. Stating the
     height means the 15% above and the alignment below are arithmetic on a
     number that is actually on screen. 0.4374 is a fifth off what the width
     used to allow: 0.8 x 0.545 x 640/638 of --gr-art. */
  .gr__wreath img {
    block-size: calc(var(--gr-art) * 0.4374);
    inline-size: auto;
    max-inline-size: 100%;
    filter: drop-shadow(0 14px 26px rgba(70, 52, 16, 0.26));
  }
  /* The title rises to meet it: the second line's foot sits on the wreath's
     foot, which is the one alignment that makes an emblem and a name read as
     one lockup rather than as two things on a page. */
  .gr[data-cat='nobel'] .gr__id {
    translate: 0 calc(var(--lock-bottom) + 0.2rem + 0.503 * var(--gr-art)
                      + var(--gr-floor) - var(--gr-head-h));
  }
  /* and that second line is gold, which is what this museum signs with */
  .gr[data-cat='nobel'] .gr__n { color: var(--gold); }
  /* Caught, it rises again by a third of what it has become — a mark beside
     the museum's name sits on the name's own line, not below it. */
  .gr[data-cat='nobel'] ~ .gr__rail[data-pinned] .gr__piece,
  .gr__rail[data-pinned] .gr__piece:has(.gr__wreath) {
    translate:
      calc(clamp(0.7rem, 2.2vw, 1.6rem) + var(--lock-w, 10.9rem) + 0.55rem
           - max(1rem, (100vw - 76rem) / 2))
      calc(-0.4rem - 0.02916 * var(--gr-art));
  }

  .gr__piece .bh__art {
    /* The cage's ratio, which is not the hall's 1:2 — the two rooms frame the
       same model differently on purpose, the hall to fit six in a row and this
       to fill one. What used to follow from that was a label at two different
       heights on the drum; it does not any more, because the label is placed
       off the model rather than off the frame. See .bh__face in plinth.css. */
    inline-size: calc(var(--gr-art) * 0.545);
    block-size: var(--gr-art);
    aspect-ratio: auto;
    max-inline-size: none;
  }
  /* --gr-art, --gr-floor, --gr-stick and --gr-room-h are declared once, on the
     theme root in bright.css. They were on `.gr, .gr__rail` here — on both,
     because the rail is the header's sibling and a var set on .gr alone does
     not reach it. The room is a third sibling now and would have needed the
     same line again, which is one repetition too many for a number three
     things have to agree on. */
  .gr__id { padding-block-end: 0.2rem; }
  .gr__title {
    font-family: var(--font-han-serif);
    font-size: var(--step-3);
    color: var(--cream);
    letter-spacing: 0.04em;
    text-shadow: 0 0 3px rgba(255, 255, 255, 0.95), 0 0 12px rgba(255, 255, 255, 0.8);
  }
  .gr__title .conj { font-size: 0.55em; opacity: 0.68; margin-inline: 0.2em; vertical-align: 0.1em; }
  .gr__title-en {
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    color: var(--muted);
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
  }
  .gr__n {
    font-size: var(--step--1); color: var(--accent); letter-spacing: 0.14em;
    margin-block-start: 0.3rem;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
  }
  /* The way on, pinned to the last line of the screen and over everything —
     the same treatment as the hall's, and for the same two reasons: it belongs
     to the window rather than to the header's box, and the page that rises
     over it was painting on top of it. */
  /* A full-width strip with the cue centred in it, exactly as the hall does
     it — see .bh__foot in HallBright.
     Full width because of the haze: the cue's own ::before reaches 4.8rem past
     it on each side, and on an element placed at `inset-inline-start: 50%`
     that reach lands outside the viewport and pushes the document 77px wider
     at every desktop size. Centred inside a box that already spans the screen,
     it cannot. */
  .gr__foot {
    position: fixed;
    inset-inline: 0;
    inset-block-end: clamp(0.7rem, 2vh, 1.5rem);
    z-index: 45;
    display: grid;
    justify-items: center;
    pointer-events: none;
    transition: opacity 0.55s var(--ease), visibility 0.55s var(--ease);
  }
  .gr__foot > * { pointer-events: auto; }
  /* nothing left below to point at */
  .gr__foot[data-gone] { opacity: 0; visibility: hidden; }
  .gr__anchor { display: block; scroll-margin-block-start: 4rem; }

  @media (max-width: 40rem) {
    /* --gr-art and --gr-head-h take their phone values on the theme root in
       bright.css. They were declared here, on the header and on the rail
       both — the rail is a sibling and every one of its numbers is built from
       --gr-art: its rest position is a negative margin of exactly the piece's
       height, so a stale value there does not merely draw the piece at the
       wrong size, it pulls the whole page up under the room and swallows the
       first paragraph. One declaration cannot go stale in one place. */
    /* Beside the museum's name, not under it. It rode underneath because the
       bar's keys used to stack down the right and there was no room on the
       line; the keys fold behind one key now, so the line is empty. The
       horizontal offset is the desktop's — measured off the name's own
       rendered width — and only the size is a phone's. */
    .gr__rail[data-pinned] .gr__piece { scale: var(--piece-back-k); }
    .gr__in { gap: 0.5rem; }
    .gr__title { font-size: var(--step-2); }
    .gr__cue .bh__cue-txt { display: none; }
  }

  /* ---------- header ---------- */
  .gh {
    border-block-end: 1px solid var(--line);
    background:
      radial-gradient(60% 120% at 8% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 68%),
      var(--bg-1);
    padding-block: clamp(1.8rem, 5vw, 3rem);
  }
  .gh__in { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
  .gh__art { --sculpt-hi: #ffe9c2; --sculpt-lo: #a06a2a; flex: none; }
  @media (max-width: 40rem) { .gh__art { display: none; } }
  .gh__back { text-decoration: none; color: var(--muted); }
  .gh__back:hover { color: var(--gold); }
  .gh__title { font-size: var(--step-3); color: var(--cream); margin-block-start: 0.3rem; }
  .gh__title .conj { font-size: 0.55em; opacity: 0.68; margin-inline: 0.2em; vertical-align: 0.1em; }
  .gh__title-en {
    font-family: var(--font-body);
    font-size: var(--step-0);
    letter-spacing: .08em;
    color: var(--muted);
    margin-block-start: .1rem;
  }

  .gh__n { font-size: var(--step--1); color: var(--accent); letter-spacing: 0.14em; margin-block-start: 0.3rem; }

  /* ---------- what this prize is ---------- */
  .about { border-block-end: 1px solid var(--line); background: var(--bg-0); overflow: visible; }
  .about__in {
    display: grid; gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1.8rem, 5vw, 2.8rem) clamp(1.2rem, 3vw, 1.8rem);
  }
  @media (min-width: 58rem) { .about__in { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; } }
  .about__lede { font-size: var(--step-1); line-height: 1.9; color: var(--text); max-inline-size: 56ch; }
  .about__hist {
    margin-block-start: 1rem; font-size: var(--step-0); line-height: 1.85;
    color: var(--muted); max-inline-size: 56ch;
    padding-inline-start: 1rem; border-inline-start: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .about__figures { display: grid; gap: 0.6rem; align-content: start; }
  .stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0.9rem; margin: 0;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); padding: 1.1rem 1.2rem;
  }
  .stats__item { text-align: start; }
  .stats dt { font-size: 0.66rem; letter-spacing: 0.1em; color: var(--muted-dim); line-height: 1.4; }
  .stats dd {
    margin: 0.15rem 0 0; font-family: var(--font-display);
    font-size: var(--step-2); color: var(--accent); line-height: 1.1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* ---------- materials strip: titles only, detail on hover/focus ---------- */
  .mats {
    display: flex; flex-wrap: wrap;
    padding-block: clamp(1.2rem, 3vw, 1.7rem) clamp(1.5rem, 4vw, 2.4rem);
    border-block-start: 1px solid var(--line);
  }
  /* the popup anchors to this list, so it always spans the strip and can
     never overflow the viewport, whichever button is pointed at */
  .mats__list {
    position: relative; inline-size: 100%;
    display: flex; flex-wrap: wrap; gap: 0.65rem; padding: 0; margin: 0;
  }

  /* The bright museum makes these museum-glass-btn--nav; what stays here is the
     dark site's own treatment, and the layout the button does not set. */
  .mat__link {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: var(--step-0); font-weight: 500; line-height: 1.3;
    color: var(--on-accent); text-decoration: none;
    background: linear-gradient(158deg,
      color-mix(in srgb, var(--accent-block) 95%, #fffaf0),
      color-mix(in srgb, var(--accent-block) 84%, #8a6535));
    border: 1px solid color-mix(in srgb, var(--accent-block) 88%, #fffaf0);
    border-radius: var(--radius-control);
    padding: 0.62rem 1.4rem;
    box-shadow: 0 2px 14px -5px color-mix(in srgb, var(--accent-block) 50%, transparent);
    transition: filter 0.25s var(--ease), transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .mat__link:hover, .mat__link:focus-visible {
    filter: brightness(1.1) saturate(1.05);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -8px color-mix(in srgb, var(--accent-block) 78%, transparent);
  }
  .mat__link:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 3px; }
  .mat__ext { font-size: 0.9em; opacity: 0.65; }

  .mat__tip {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + 0.6rem);
    z-index: 20;
    display: grid; gap: 0.3rem;
    padding: 0.85rem 1.05rem;
    background: var(--bg-2);
    border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--line));
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
    opacity: 0; visibility: hidden; translate: 0 -0.35rem;
    transition: opacity 0.22s var(--ease), translate 0.22s var(--ease), visibility 0.22s;
    pointer-events: none;
  }
  .mat__tip-d { font-size: var(--step--1); color: var(--text); line-height: 1.65; }
  .mat__tip-h { font-size: 0.66rem; letter-spacing: 0.08em; color: var(--accent); }

  .mat:hover .mat__tip,
  .mat__link:focus-visible + .mat__tip {
    opacity: 1; visibility: visible; translate: 0 0;
  }

  /* no hover on touch — show the detail inline instead of hiding it entirely */
  @media (hover: none) {
    .mat__tip {
      position: static; opacity: 1; visibility: visible; translate: 0;
      box-shadow: none; background: transparent; border: 0;
      padding: 0.15rem 0 0.5rem 0.2rem;
    }
    .mats__list { flex-direction: column; align-items: stretch; gap: 0.9rem; }
    .mat { display: grid; justify-items: start; gap: 0.3rem; }
  }

  .asof { margin: 0; font-size: 0.66rem; color: var(--muted-dim); line-height: 1.6; }

  /* ---------- body ---------- */
  .gh__body { display: grid; gap: clamp(2.5rem, 7vw, 4.5rem); padding-block: clamp(2rem, 5vw, 3rem); }
  /* the same measure the laureate pages use, so the rail is in the same place
     in both rooms */
  @media (min-width: 62rem) {
    .gh__body { grid-template-columns: minmax(0, 1fr) 17rem; align-items: start; }
  }
  .gh__aside {
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); padding: 1.3rem 1.4rem;
  }
  .gh__aside .lec__h { font-size: var(--step-1); color: var(--cream); margin-block-end: 0.9rem; }
  .gh__aside .lec__h::before {
    content: ''; display: inline-block; inline-size: 0.5rem; block-size: 0.5rem;
    background: var(--accent); margin-inline-end: 0.6rem; vertical-align: 0.12em; border-radius: 1px;
  }
  .gh__aside .links { display: grid; gap: 1rem; padding: 0; margin: 0; }
  .gh__aside .links li { display: grid; gap: 0.15rem; }
  .gh__aside .links a {
    font-size: var(--step-0); text-decoration: none;
    border-block-end: 1px solid var(--line-hi); justify-self: start;
  }
  .gh__aside .links a:hover { border-block-end-color: currentColor; }
  .gh__aside .links span { font-size: var(--step--1); color: var(--muted-dim); line-height: 1.55; }
  .gh__aside .links__key {
    padding: .7rem .85rem; margin-block-end: .3rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .gh__aside .links__key a { color: var(--cream); border-block-end-color: color-mix(in srgb, var(--accent) 60%, transparent); }
  .sec-h { font-size: var(--step-2); color: var(--cream); }
  .sec-h::after {
    content: ''; display: block; inline-size: 3rem;
    border-block-start: 1px solid var(--accent); margin-block-start: 0.6rem; opacity: 0.7;
  }

  .grid {
    display: grid; gap: clamp(0.9rem, 2vw, 1.5rem); padding: 0; margin-block-start: 1.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .empty {
    display: grid; gap: 0.8rem; max-inline-size: 48rem; margin-block-start: 1.6rem;
    border: 1px dashed var(--line-hi); border-radius: var(--radius);
    padding: clamp(1.4rem, 4vw, 2.4rem); background: var(--surface);
  }
  .empty__t { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); }
  .empty__b { color: var(--muted); line-height: 1.85; }

  /* ---------- materials ---------- */
  .materials__note { font-size: var(--step--1); color: var(--muted); margin-block-start: 0.9rem; }
  .cards {
    display: grid; gap: 0.9rem; padding: 0; margin-block-start: 1.4rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .cards a {
    display: grid; gap: 0.3rem; block-size: 100%; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.1rem 1.25rem 0.95rem;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .cards a:hover, .cards a:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--surface-hi); transform: translateY(-2px);
  }
  .cards__t { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); line-height: 1.35; }
  .cards__d { font-size: var(--step--1); color: var(--muted); line-height: 1.65; }
  .cards__host {
    margin-block-start: 0.45rem; font-size: 0.66rem; letter-spacing: 0.08em;
    color: var(--muted-dim); font-family: var(--font-body);
  }
  .cards a:hover .cards__host { color: var(--accent); }

</style>

<script>
  import '../../vendor/model-viewer.min.js';
  import { dressPlinths } from '../scripts/plinth';
  /* one piece rather than six, but the same object — same drum, same rings,
     same name bent onto the same cylinder */
  dressPlinths();

  /* ---- where the museum's name ends ----
     The mark the piece shrinks into stands beside the name, and the name is a
     line of type, not a share of the viewport: 諾貝爾講座博物館 and 'Nobel
     Lecture Museum' are different widths, and neither of them tracks 7vw. Its
     rendered width is measured here and handed to the stylesheet. */
  const lock = document.querySelector<HTMLElement>('.gr__lock');
  const root = document.documentElement;
  function measureLock() {
    if (lock) root.style.setProperty('--lock-w', `${Math.round(lock.offsetWidth)}px`);
  }
  measureLock();
  /* the museum's faces are self-hosted and arrive after first paint; the name
     is a different width in the fallback face */
  document.fonts?.ready.then(measureLock);
  addEventListener('resize', measureLock);

  /* ---- when the piece is caught ----
     The rail does the pinning — sticky is the compositor's own job, so the
     piece never lags a frame behind the page. What is decided here is only
     when it becomes a mark.

     On a desktop that is half the piece's own height of scrolling, which is
     what was asked for and is no longer the same moment as the pin: the page
     now arrives a drum's height higher, so the rail reaches the top of the
     window after about 60px. Between the two the piece stands still at full
     size, and the museum's name is drawn over it rather than under — see the
     mark's z-index of 60 in bright.css.

     On a phone the rail's own arrival is still the cue: the piece is smaller,
     the screen is shorter, and half of it is not a distance worth waiting
     through. */
  const rail = document.querySelector<HTMLElement>('.gr__rail');
  const art = document.querySelector<HTMLElement>('.gr__piece .bh__art');
  const cue = document.querySelector<HTMLElement>('[data-gr-cue]');
  const WIDE = matchMedia('(min-width: 48.0625rem)');

  /* The fading band, in each element's own coordinates.
     A mask cannot be attached to the window, so the stops move with the scroll
     instead — two custom properties per element, written on a rAF, which the
     compositor turns into one gradient texture rather than a repaint. The
     offsets are read once and on resize, never per frame. */
  const faders = [document.querySelector<HTMLElement>('.gr'),
                  document.querySelector<HTMLElement>('.gr__sheet')].filter(Boolean) as HTMLElement[];
  let offsets: number[] = [];
  const measure = () => {
    offsets = faders.map((el) => el.getBoundingClientRect().top + scrollY);
  };
  const paintFade = () => {
    /* twice the museum's mark, which is the one piece of chrome that stands in
       that band and therefore the thing the page must clear */
    const band = (lock?.offsetHeight || 40) * 2;
    faders.forEach((el, i) => {
      const a = scrollY - offsets[i];
      el.style.setProperty('--fade-a', `${a.toFixed(1)}px`);
      el.style.setProperty('--fade-b', `${(a + band).toFixed(1)}px`);
    });
  };
  measure();

  let ticking = false;
  const test = () => {
    ticking = false;
    paintFade();
    if (rail) {
      const caught = WIDE.matches && art
        ? scrollY >= art.offsetHeight / 2
        : rail.getBoundingClientRect().top
            <= (parseFloat(getComputedStyle(rail).insetBlockStart) || 0) + 1;
      rail.toggleAttribute('data-pinned', caught);
    }
    /* the way on is pinned to the foot of the window now, so it stays for as
       long as there is page left to go to */
    cue?.toggleAttribute('data-gone',
      scrollY + innerHeight >= root.scrollHeight - 40);
  };
  test();
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(test);
  }, { passive: true });
  addEventListener('resize', () => { measure(); test(); });
  WIDE.addEventListener('change', test);
  /* the faces arrive after first paint and the mark is a different width in
     the fallback face, which moves everything below it */
  document.fonts?.ready.then(() => { measure(); test(); });
</script>
