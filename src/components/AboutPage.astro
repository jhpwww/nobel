---
import Base from '../layouts/Base.astro';
import ScrollCue from './ScrollCue.astro';
import { useT, type Lang } from '../i18n/ui';
import ExtLink from './ExtLink.astro';
import PageEmblem from './PageEmblem.astro';
import RoomBack from './RoomBack.astro';
import { specialEvents, hosts } from '../data/catalog';
import { asset } from '../i18n/routing';

/* the museum's own room behind this page too — see RoomBack */
const bright = process.env.THEME === 'bright';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const special = specialEvents;
const hostList = Object.entries(hosts);
---

<Base lang={lang} title={t('about.title')} segments={['about']} bare={bright}>
  {bright && <RoomBack lang={lang} room="about-hall" />}
  {bright && <PageEmblem src="assets/ui/medal.webp" srcSmall="assets/ui/medal-sm.webp" w={720} h={720} outside />}
  <div class="wrap-narrow about" data-fade>
    {/* The medal the project struck for itself: the bell tower and the palms
        inside a ring of the six prizes, NOBEL LAUREATE LECTURES round the top
        and NATIONAL TAIWAN UNIVERSITY round the foot.
        This page had a bare heading and eleven hundred words under it, which
        is the one page in the museum with nothing to look at. The medal is
        what the page is about, so it opens with it — set beside the title, and
        caught into a mark beside the museum's name once the visitor has gone
        half its height. That rail and that catch are one component now, shared
        with the learning area; see PageEmblem. */}

    <header class="abt__hero hall-head">
      {/* Three lines, and the order is the page's own: what this room is, then
          whose it is, then what it is part of. The university line was leading
          — an eyebrow, in the way a magazine puts a section over an article —
          and this is not an article, it is the room's own door plate. Both the
          lines under the name are gold, which is what this museum signs
          with. */}
      <h1 class="abt__name">{t('about.title')}</h1>
      {/* The two gold lines are out of the BRIGHT museum, at the owner's
          word — hidden rather than removed, because the dark museum is
          preserved as it stands and its about page has carried them from the
          start. In the daylight rooms both stand elsewhere on every page: the
          name in the mark in the corner, the university at the head of this
          page's own colophon. Same pattern as .browse__kinds, the other way
          up. */}
      <p class="abt__uni">{t('site.university')}</p>
      <p class="abt__sub">{t('site.tagline')}</p>
      <p class="visually-hidden">{t('about.medalAlt')}</p>
    </header>

    <span id="about-body" class="gr__anchor"></span>
    {lang === 'zh' ? (
      <div class="prose stack" style="--gap:1.2rem">
        <p class="lede hall-note"><span>
          本站將近年由臺大參與或主辦的諾貝爾獎得主演講，收攏成為一座線上博物館，
          供大眾或學生瀏覽及自我學習，以擴展國際視野。
        </span></p>

        <h2>諾貝爾獎在臺灣的回響</h2>
        <p>
          諾貝爾獎是近百年來影響全人類最深遠的獎項，而華人獲獎者也一直在各領域佔有一席之地，
          如李政道、楊振寧、丁肇中、朱棣文等。其中 1986 年化學獎得主李遠哲教授，
          則是出生及成長於臺灣的學者。
        </p>
        <p>
          李教授於 1955 年進入臺大，先後就讀化工系及化學系，於清華大學取得碩士後，
          赴加州大學柏克萊分校取得博士學位。他以研究交叉分子束技術、
          觀察分子碰撞化學反應過程而獲獎。1994 年返臺出任中央研究院院長，
          積極推動臺灣基礎科學研究與學術交流，顯著提升臺灣的國際學術地位與能見度。
        </p>

        <h2>臺灣橋樑計畫</h2>
        <p>
          李遠哲院長多年來持續推動臺灣國際學術交流。在其倡議及光寶科技創辦人宋恭源先生的支持下，
          推動「臺灣橋樑計畫」（Taiwan Bridges Program），敦請賴清德總統擔任榮譽主席，
          以國立臺灣大學與中央研究院為核心，結合國內 12 個學研機構，
          並與世界和平基金會（International Peace Foundation, IPF）合作，
          自 2025 年底起共半年間，邀請 31 位諾貝爾獎得主來臺進行系列演講與學術交流活動，
          促進臺灣學界、社會與全球頂尖科學家之對話與合作。
        </p>
        <p>
          在「臺灣橋樑計畫」中，臺大負責整合與推展的工作，包括辦理開幕式及其中六場講座，
          涵蓋物理學、化學、生理學或醫學及經濟學等獎項得主，
          並以「宋恭源先生頂尖研究講座」（NTU Raymond Soong Chair Professorship of
          Distinguished Research）名義辦理。從各場講座的師生熱烈對話與交流中，
          充份綻放了帶進不同高度思維後所產生的火花，將長遠影響臺灣的學術根基，
          奠定邁向世界的基礎。
        </p>

        <h2>影片與版權</h2>
        <p>
          所有影片皆以 YouTube 內嵌方式播放，本站不重製、不轉錄、不再散布影片本身，
          版權屬於原始發布單位，主要為世界和平基金會（International Peace Foundation）頻道與臺大演講網（NTU Speech）。
          部分場次的代表圖為自該場錄影擷取之單張靜態畫面，僅供辨識該場次之用，著作權仍屬原發布單位所有。
          諾貝爾基金會（Nobel Foundation）的文字與圖像一律以連結方式引用，不複製到本站。
        </p>
        <p>
          「諾貝爾獎」（Nobel Prize）名稱與獎章為諾貝爾基金會（Nobel Foundation）之商標。本站為教育用途之獨立專案，
          與諾貝爾基金會無隸屬關係，亦未獲其背書。
        </p>
        <p>
          本站所使用之所有 3D 模型，其著作權均屬吳俊輝（Jiun-Huei Proty Wu）所有。
          未經授權，不得以任何形式使用、重製、修改、散布或作其他用途。
        </p>
        <h2>隱私</h2>
        <p>
          本站沒有帳號、沒有追蹤 Cookie、沒有第三方廣告。影片使用 YouTube 的
          <code>youtube-nocookie.com</code> 網域，在按下播放之前，不會載入 YouTube 的任何程式碼。
        </p>
      </div>
    ) : (
      <div class="prose stack" style="--gap:1.2rem">
        <p class="lede hall-note"><span>
          This site gathers the Nobel laureate lectures that National Taiwan University
          hosted or took part in over recent years into one online museum, open to the
          public and to students to browse and learn from, and to widen the view.
        </span></p>

        <h2>Taiwan and the Nobel legacy</h2>
        <p>
          The Nobel Prize has been one of the most influential awards in shaping humanity
          over the past century, and Chinese laureates have long held an important place
          in many fields — Tsung-Dao Lee, Chen-Ning Yang, Samuel C. C. Ting, Steven Chu.
          Among them, Professor Yuan Tseh Lee, the 1986 laureate in Chemistry, was born
          and raised in Taiwan.
        </p>
        <p>
          Professor Lee entered National Taiwan University in 1955, studying first in the
          Department of Chemical Engineering and later in Chemistry. After a master's
          degree from National Tsing Hua University he earned his Ph.D. at the University
          of California, Berkeley. He was awarded the Nobel Prize for his work with the
          crossed molecular beam technique, observing the chemical reactions of colliding
          molecules. In 1994 he returned to Taiwan as President of Academia Sinica, where
          he pressed for basic scientific research and academic exchange and markedly
          raised the country's international academic standing.
        </p>

        <h2>The Taiwan Bridges Program</h2>
        <p>
          President Yuan Tseh Lee has worked for many years to open Taiwan's academic
          exchange to the world. At his initiative, and with the support of Raymond Soong,
          founder of Lite-On Technology, the Taiwan Bridges Program was launched with
          President Ching-te Lai as honorary chair. Anchored by National Taiwan University
          and Academia Sinica, joined by ten further academic and research institutions
          across Taiwan, and developed with the International Peace Foundation, it invited
          31 Nobel laureates to Taiwan over six months from late 2025 for a series of
          lectures and exchanges — a conversation between Taiwan's academic community, its
          society, and some of the world's leading scientists.
        </p>
        <p>
          Within the programme, NTU took on the work of drawing it together: the opening
          ceremony and six of the lectures, in physics, chemistry, physiology or medicine
          and economic sciences, held under the Raymond Soong Chair Professorship of
          Distinguished Research. What came out of the exchanges between speakers,
          teachers and students in those rooms will bear on Taiwan's academic foundations
          for a long time.
        </p>

        <h2>Video and rights</h2>
        <p>
          Every video is embedded from YouTube and remains the copyright of its original
          publisher, chiefly the International Peace Foundation channel and 臺大演講網; nothing
          here re-cuts, re-hosts or redistributes a recording. For some sessions the still that
          represents it is a single frame taken from that recording, used only to identify the
          session, and the copyright in it remains its publisher's. Nobel Foundation text and
          images are linked, never copied.
        </p>
        <p>
          "Nobel Prize" and the medal are trademarks of the Nobel Foundation. This is an independent
          educational project, not affiliated with or endorsed by the Nobel Foundation.
        </p>
        <p>
          All 3D models used on this website are copyrighted by Jiun-Huei Proty Wu. Unauthorized
          use, reproduction, modification, distribution, or any other form of use is prohibited.
        </p>
        <h2>Privacy</h2>
        <p>
          No accounts, no tracking cookies, no third-party advertising. Embeds use YouTube's
          <code>youtube-nocookie.com</code> domain, and no YouTube code loads until playback begins.
        </p>
      </div>
    )}

    <h2>{t('special.title')}</h2>
    <ul class="special" role="list">
      {special.map((s) => (
        <li>
          <ExtLink lang={lang} href={`https://www.youtube.com/watch?v=${s.yt}`}>
            {lang === 'zh' ? s.title_zh : s.title_en}
          </ExtLink>
          <span>{s.date}{s.note_zh && lang === 'zh' ? ` · ${s.note_zh}` : ''}</span>
        </li>
      ))}
    </ul>

    <h2>{lang === 'zh' ? '主辦與協辦單位' : 'Host institutions'}</h2>
    <ul class="hosts" role="list">
      {hostList.map(([, h]) => <li>{lang === 'zh' ? h.zh : h.en}</li>)}
    </ul>
  </div>

  {bright && <ScrollCue lang={lang} href="#about-body" />}
</Base>

<style>
  :global(html[data-theme='bright']) .about { padding-block-start: 3.4rem; }
  /* On the page, not on the hero: the rail is the hero's SIBLING and every
     number in it is built from these two. A var declared on the hero reaches
     nothing above it, which is how the medal came to sit nineteen pixels high
     with the margin that should have placed it resolving to nothing at all. */
  .about {
    /* --emb-h and --emb-k are the museum's own, on the theme root in
       bright.css: the medal, the introduction room's laurel and the learning
       area's device are the same object at three doors, and a phone needs all
       three to be a fifth of its width rather than a share of a sculpture's
       frame. */
    --abt-two-lines: calc(var(--step-3) * 1.28 + 0.28rem + 1.86rem);
  }
  .about { padding-block: clamp(2rem, 5vw, 3.5rem) 0; }
  .about h1 { font-size: var(--step-3); color: var(--cream); }

  /* ---------- the medal, and the name beside it ----------
   *
   * The same lockup the introduction room has — see .gr__wreath in
   * GalleryPage, where the two relationships are stated:
   *
   *   · the emblem begins 15% of its own height below the museum's mark
   *   · the second line of the name ends where the emblem ends
   *
   * Both fall out of one number. The medal hangs from a rail that carries no
   * height, so it is the text that has to be placed: put its first line at
   *
   *     --lock-bottom + 1.15 x medal - (the first two lines' own height)
   *
   * and the second line lands on the medal's foot exactly, because the medal
   * starts a fifth of itself below the mark and ends a whole one further down.
   */
  .abt__hero {
    /* NOTE --step--2 is used all over this project and is not declared
       anywhere in global.css, so every rule that asks for it silently inherits
       the body size instead. That is why the gold line measures 29.7px and not
       the 16 the name suggests, and it is why this term is a rem rather than a
       step: 1.86rem IS the line as it renders. */
    display: grid;
    row-gap: 0.28rem;
    justify-items: start;
    text-align: start;
    /* placement, indent and the centring on the emblem are .hall-head's, in
       bright.css — the four rooms that are not prize rooms share one head */
  }
  .abt__uni {
    margin: 0;
    font-size: var(--step--2);
    letter-spacing: 0.3em;
    text-indent: 0.3em;      /* tracking pads the right; give it back */
    text-transform: uppercase;
    color: var(--gold);
  }
  .abt__sub {
    margin: -0.06rem 0 0;
    font-family: var(--font-han-serif);
    font-size: var(--step-0);
    letter-spacing: 0.12em;
    text-indent: 0.12em;
    color: var(--gold);
  }
  /* and not in daylight — see the note in the markup */
  :global(html[data-theme='bright']) .abt__uni,
  :global(html[data-theme='bright']) .abt__sub { display: none; }

  /* The phone keeps the desktop's principle, which it did not before: the
     medal used to come back into the flow, sit centred over the heading and
     scroll away, so a phone had neither the lockup nor the catch. What made
     that necessary was the size — 0.4374 of a sculpture's frame is a 117px
     disc, and beside a heading at 390px it left four characters. That is a
     number now, --emb-h, and on a phone it is a fifth of the screen. Nothing
     else here has a phone value at all. */


  /* the first heading of the prose no longer needs to clear a bare h1 */
  .about .prose > h2:first-child { margin-block-start: 0; }
  .about h2 {
    font-size: var(--step-1); color: var(--cream);
    margin-block: 2.5rem 0.9rem; padding-block-start: 1.5rem; border-block-start: 1px solid var(--line);
  }
  /* the whole column: the global rule caps a paragraph at 62 characters,
     which on this page left a third of the measure empty */
  .prose p { color: var(--text); line-height: 1.9; max-inline-size: none; }
  .lede { font-size: var(--step-1); color: var(--cream); }
  code { font-size: 0.88em; background: var(--surface-hi); padding: 0.1em 0.4em; border-radius: 2px; }

  .special { display: grid; gap: 0.9rem; padding: 0; margin: 0; }
  .special li { display: grid; gap: 0.1rem; }
  .special a { justify-self: start; }
  .special span { font-size: var(--step--1); color: var(--muted-dim); }

  .hosts { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0; }
  .hosts li {
    font-size: var(--step--1); color: var(--muted);
    border: 1px solid var(--line); border-radius: var(--radius-control); padding: 0.2rem 0.8rem;
  }
</style>

