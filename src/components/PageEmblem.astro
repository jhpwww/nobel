---
/**
 * PageEmblem.astro — the emblem a page hangs beside its title.
 *
 * The about page's medal and the learning area's device do the same thing:
 * stand on a rail beside the heading, ride up with the page, and then be
 * caught into a mark beside the museum's own name — which is where the
 * introduction room's laurel ends up too, by its own arithmetic inside
 * GalleryPage. See --emb-h, --emb-k and --emb-y in bright.css, which is where
 * the numbers live: a desktop catches them at twice the size a phone does and
 * hangs them from the mark's top edge rather than its middle.
 *
 * The rail carries no height of its own, so the emblem takes nothing from the
 * flow: the heading beside it is placed with padding, and the rail is pulled
 * up to meet it. One pixel rather than zero, because a box of exactly zero
 * height collapses its own two margins together and lands back where it
 * started — the same trap documented on .gr__rail.
 *
 * Bright museum only. The dark site's pages have no room behind them and no
 * mark to be caught by.
 */
import { asset } from '../i18n/routing';

interface Props {
  /** path under public/, e.g. 'assets/ui/medal.webp' */
  src: string;
  /** and the small one, for a phone, where the big file is wasted */
  srcSmall?: string;
  w: number;
  h: number;
  /** true when the rail stands before the page's own padded container */
  outside?: boolean;
}
const { src, srcSmall, w, h, outside = false } = Astro.props;
---

<div class="emb" data-emb data-outside={outside ? '' : undefined} aria-hidden="true">
  <div class="emb__piece">
    <picture class="emb__pic">
      {srcSmall && <source media="(max-width: 40rem)" srcset={asset(srcSmall)} />}
      <img src={asset(src)} alt="" width={w} height={h} fetchpriority="high" decoding="async" />
    </picture>
  </div>
</div>

<style>
  /* --emb-flow is where the rail's own flow position sits: 3.4rem when it is
     inside the page's padded container, and nothing when it stands before it.
     It stands before it wherever the page fades, because a mask applies to
     everything inside the element it is on and the emblem is the one thing on
     these pages that must not fade. */
  .emb {
    position: sticky;
    inset-block-start: var(--gr-stick);
    /* Over the band the page dissolves into, which is 10, and over the head it
       stands beside, which is 11. The emblem is the one thing on these pages
       that never fades — before it is caught into a mark and after — and both
       of those would otherwise cover it exactly where it comes to rest: the
       band by lying over the page, the head by carrying a field of light
       behind its own title, which reaches past the title's box and is drawn
       later in the document than this. Under every other piece of pinned
       chrome. */
    z-index: 12;
    block-size: 1px;
    margin-block-start: calc(var(--lock-bottom) + 0.15 * var(--emb-h) - var(--emb-flow, 3.4rem));
    margin-block-end: calc(var(--emb-flow, 3.4rem) - var(--lock-bottom) - 0.15 * var(--emb-h) - 1px);
    pointer-events: none;
  }
  .emb[data-outside] { --emb-flow: 0px; }
  /* At the left edge of the page's own column, not of the window.
     The rail stands before the page's container now — it has to, or the mask
     that fades the page would fade it too — and every one of these pages
     centres a column of its own width inside the window: 76rem for the index
     of films, 62 for the learning area, 60 for the introduction room, and the
     narrow measure for the colophon. So the offset is measured off the head
     the emblem belongs beside, and the caught position subtracts the same
     number, which is what keeps the two in step. */
  .emb__piece {
    isolation: isolate;
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--emb-x, 0px);
    transform-origin: 0 0;
    transition: scale 0.45s var(--ease), translate 0.45s var(--ease);
  }
  /* Caught: beside the museum's name, at the size every emblem in the museum
     becomes, and hung from the same line it is. Both numbers are the
     stylesheet's — --emb-k and --emb-y, declared with the room's other
     measurements in bright.css, where a phone gives each of them its own
     answer. Only the sideways reach is arithmetic here, because only it
     depends on the rail: the mark's inset, the mark's own width, whatever the
     plate hangs past it, a gap, and back off the rail's left edge. */
  .emb[data-pinned] .emb__piece {
    scale: var(--emb-k);
    translate:
      calc(var(--mark-x) + var(--lock-w, 10.9rem) + var(--mark-over, 0px) + 0.55rem
           - var(--emb-x, 0px))
      var(--emb-y);
  }
  :global(html[data-motion='off']) .emb__piece { transition: none; }
  .emb__pic { position: relative; display: block; line-height: 0; }
  .emb__pic img {
    block-size: var(--emb-h);
    inline-size: auto;
    max-inline-size: 100%;
    /* The way on carries its own edge rather than a panel behind it — three
       white shadows tight to the shape, so the object is separated from
       whatever is behind it without a ground of its own. See .bh__cue. A haze
       stood here first and read as a faint square behind the picture, which
       is the one thing the emblem must not have; this follows the alpha. */
    filter:
      drop-shadow(0 0 1px rgba(255, 255, 255, 0.98))
      drop-shadow(0 0 4px rgba(255, 255, 255, 0.95))
      drop-shadow(0 0 10px rgba(255, 255, 255, 0.78))
      drop-shadow(0 2px 4px rgba(70, 52, 16, 0.2));
  }
</style>

<script>
  import { measureMark } from '../scripts/mark';

  /* The emblem is caught at half its own height of scrolling, and the mark it
     stands beside is a line of type rather than a share of the viewport — so
     the name is measured and handed to the stylesheet. That measuring is
     mark.ts, which the prize room's sculpture and a laureate's pinned name
     ask the same two questions of; what is left here is this rail's own
     figure, the left edge of the head the emblem stands beside. */
  const rails = [...document.querySelectorAll<HTMLElement>('[data-emb]')];
  const root = document.documentElement;

  if (rails.length) {
    /* the head this emblem stands beside — its own column's left edge */
    const head = document.querySelector<HTMLElement>('.hall-head');

    function measure() {
      measureMark();
      const box = (head ?? rails[0]).getBoundingClientRect();
      root.style.setProperty('--emb-x', `${Math.round(box.left)}px`);
    }

    let ticking = false;
    const test = () => {
      ticking = false;
      for (const rail of rails) {
        const img = rail.querySelector<HTMLElement>('img');
        if (!img) continue;
        rail.toggleAttribute('data-pinned', scrollY >= img.offsetHeight / 2);
      }
    };

    measure();
    test();
    document.fonts?.ready.then(() => { measure(); test(); });
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(test);
    }, { passive: true });
    addEventListener('resize', () => { measure(); test(); });
  }
</script>
