---
/**
 * SiteSearch.astro — one field that reaches every room in the museum.
 *
 * The museum has 39 lecture records, seven rooms, 77 recordings and half a dozen
 * pages. The index of films has a filter, but that is a filter over films: it
 * cannot take you to a room, to the learning area or to the medal on the
 * about page.
 *
 * WHAT IT IS
 * A key in the bar, and behind it a plate that comes down over the room: a
 * field, a list under it, nothing else. No page of its own — a search page is
 * a room a visitor has to walk into and back out of, and this is a drawer.
 *
 * HOW IT MATCHES
 * The whole index ships with the page, because it is small (31 lectures and a
 * dozen pages, ~14 KB) and because a museum that is a set of static files
 * should not need a server to answer 'Kobilka'. Matching is on the plain
 * substring, which is the right rule for both languages here: Han has no word
 * boundaries to tokenise on, and a visitor typing 'kobil' expects Kobilka.
 * What is scored is WHERE the match lands — a name beats a title beats the
 * body — and whether it starts the field, so 'Peace' finds the peace room
 * before it finds a peace prize laureate's biography.
 *
 * AND THEN THE TEXT
 * The rows above are the museum's own list of what it holds, and they cannot
 * answer a word that is on a page but is nobody's name and no room's —
 * 'ubiquitin', '黑箱', 'entanglement'. For those the drawer reads the pages
 * themselves: scripts/search-index.mjs cuts every built page into sections
 * at its headings and writes search/{zh,en}.json beside them, and the drawer
 * fetches the one for its language the first time it opens. A hit from there
 * shows the sentence the word is in and leads to that part of that page.
 *
 * A query that finds nothing anywhere is handed to the index of films, which
 * searches the recordings' own descriptions; see ?q= in BrowsePage.
 */
import { useT, type Lang } from '../i18n/ui';
import {
  allLectures, byCategory, seriesName, categories, catName, catNameAlt, tagName,
  lectureFilms, sittings,
  intro, INTRO, type CategoryKey, type GalleryKey,
} from '../data/catalog';
import { gallery, browse, about, learn, asset, lecture as lectureUrl } from '../i18n/routing';

interface Props {
  lang: Lang;
  /**
   * Which half of this to draw. The key belongs in the bar and the plate does
   * not: a dialog is display:none until it opens, but it still counts as a
   * child, and the bar's fold staggers its keys with :nth-child. So the two
   * are placed separately and share one scope, which is what keeps the key's
   * styling with the thing it opens.
   */
  only?: 'key' | 'panel';
}
const { lang, only } = Astro.props;
const t = useT(lang);
const zh = lang === 'zh';

type Row = {
  /** what is read: the line, the line under it, and the small mark at the end */
  n: string; s: string; m: string;
  /** where it goes, which group it belongs to, and everything it answers to.
      'l' laureate, 'r' room, 'p' page — and 't', a hit in a page's own text,
      which is built in the script from the second index and never here */
  h: string; g: 'l' | 'r' | 'p' | 't'; k: string;
};

const rows: Row[] = [];

/* ---- the laureates ----------------------------------------------------
   Both collections. A drawer that cannot find Aspect, Mourou, Stoddart or
   Robinson by name is a drawer that says the museum does not hold them.
   Ciechanover appears twice on purpose — two different events, two pages —
   so the mark at the end of the line carries the series as well as the year,
   which is the only thing that tells the two rows apart. */
for (const l of allLectures()) {
  const cat = catName(l.prize.category, lang);
  const ser = seriesName(l, lang);
  rows.push({
    n: zh ? `${l.laureate.zh}` : l.laureate.en,
    s: zh ? l.title.zh : l.title.en,
    m: ser ? `${l.prize.year} · ${cat} · ${ser}` : `${l.prize.year} · ${cat}`,
    h: lectureUrl(lang, l.id),
    g: 'l',
    k: [
      l.laureate.en, l.laureate.zh, l.title.en, l.title.zh,
      l.affiliation.institution, l.affiliation.country,
      l.event.host_en, l.event.host_zh, l.event.city,
      String(l.prize.year), cat, catNameAlt(l.prize.category, lang),
      ...l.topic_tags.map((tg) => tagName(tg, lang)),
      ...l.topic_tags,
      l.hook[lang], l.description[lang],
      l.series_zh, l.series_en,
    ].filter(Boolean).join(' ').toLowerCase(),
  });
}

/* ---- the rooms -------------------------------------------------------- */
/* The introduction room is not a prize category and is not in `categories`,
   so it is added by hand — it is the room the bar calls 關於諾獎, one of the
   seven doors off the hall. */
const rooms: GalleryKey[] = [...(Object.keys(categories) as CategoryKey[]), INTRO];
for (const key of rooms) {
  const isIntro = key === INTRO;
  const n = catName(key, lang);
  const n2 = catNameAlt(key, lang);
  /* Sittings, not lecture records — the same figure the hall shows under each
     piece and the room shows on its own head; Südhof's lecture was given
     twice. byCategory, so this is that one figure and not a third sum of its
     own: counted here against `lectures` alone, the drawer went on offering
     nine where both the plinth and the room said twelve. */
  const held = byCategory(key).reduce((a, l) => a + sittings(l), 0);
  rows.push({
    n: isIntro ? t('nav.prize') : n,
    s: isIntro ? t('hall.introDesc') : n2,
    m: isIntro ? t('hall.nobelRoom') : held > 0 ? t('hall.count', { n: held }) : t('hall.soon'),
    h: gallery(lang, key),
    g: 'r',
    k: (isIntro
      ? `${t('nav.prize')} ${intro.zh} ${intro.en} nobel prize 諾貝爾 諾獎 alfred`
      : `${n} ${n2} ${key} ${categories[key as CategoryKey].intro[lang]}`).toLowerCase(),
  });
}

/* ---- the museum's own pages ------------------------------------------- */
const pages: Row[] = [
  { n: t('nav.all'), s: t('learn.toolAllD', { n: lectureFilms() }), m: '',
    h: browse(lang), g: 'p', k: `${t('nav.all')} videos lectures 影片 講座 導讀 專訪 index`.toLowerCase() },
  { n: t('nav.learn'), s: t('learn.blurb'), m: '',
    h: learn(lang), g: 'p', k: `${t('nav.learn')} learn study course 學習 課程 走進諾貝爾 libedu1140`.toLowerCase() },
  { n: t('study.pageTitle'), s: t('study.pageBlurb'), m: '',
    h: `${learn(lang)}#record`, g: 'p', k: `${t('study.pageTitle')} notes progress 筆記 紀錄 匯出 備份`.toLowerCase() },
  { n: t('about.title'), s: t('site.description'), m: '',
    h: about(lang), g: 'p', k: `${t('about.title')} about copyright privacy 版權 隱私 臺灣橋樑計畫 taiwan bridges`.toLowerCase() },
  { n: t('search.guides'), s: t('learn.toolGuidesD'), m: '',
    h: `${browse(lang)}?kind=guide`, g: 'p', k: `${t('search.guides')} guide 導讀 introduction`.toLowerCase() },
];
rows.push(...pages);

/* what stands in the list before anything has been typed: the rooms, then the
   two pages a first-time visitor is most likely to be looking for */
const suggested = [
  ...rows.filter((r) => r.g === 'r').map((r) => rows.indexOf(r)),
  rows.indexOf(pages[0]), rows.indexOf(pages[1]),
];

const groups = { l: t('search.groupLaureate'), r: t('search.groupRoom'), p: t('search.groupPage'), t: t('search.groupText') };
---

{only !== 'panel' && (
<button class="topbar__key ss__key museum-glass-btn museum-glass-btn--nav" type="button"
        data-ss-open aria-haspopup="dialog" aria-label={t('search.label')}>
  <svg class="ss__ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
    <circle cx="11" cy="11" r="6.6" fill="none" stroke="currentColor" stroke-width="1.9" />
    <path d="M16 16 21 21" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
  </svg>
  <span>{t('search.open')}</span>
</button>
)}

{only !== 'key' && (
<dialog class="ss" data-ss aria-label={t('search.label')}
        data-index={JSON.stringify(rows)}
        data-suggested={JSON.stringify(suggested)}
        data-groups={JSON.stringify(groups)}
        data-all={t('search.all')}
        data-empty={t('search.empty')}
        data-browse={browse(lang)}
        data-loading={t('search.loading')}
        data-text={asset(`search/${lang}.json`)}>
  <div class="ss__panel">
    <form class="ss__bar" data-ss-form role="search">
      <svg class="ss__bar-ico" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
        <circle cx="11" cy="11" r="6.6" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M16 16 21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      {/* autofocus, and it is not decoration. A modal dialog's own focusing
          steps run inside showModal(), before any script of ours: with no
          element asking for the caret the browser leaves focus on the dialog
          box itself, so the panel opens with nothing to type into and no
          caret to see. On a phone that is worse than untidy — a soft keyboard
          rises only for a focus that happens inside the press that asked for
          it, and a focus deferred to the next frame has already spent it. */}
      <input class="ss__in" type="search" data-ss-in autocomplete="off" spellcheck="false" autofocus
             enterkeyhint="go" placeholder={t('search.ph')} aria-label={t('search.label')}
             role="combobox" aria-expanded="true" aria-controls="ss-list" aria-autocomplete="list" />
      <button class="ss__close" type="button" data-ss-close aria-label={t('search.close')}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M6 6 18 18M18 6 6 18" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
        </svg>
      </button>
    </form>

    <p class="ss__lede" data-ss-lede>{t('search.start')}</p>
    {/* before the list, not after it: when nothing matched, the sentence that
        says so has to come before the one row that is still offered */}
    <p class="ss__none" data-ss-none hidden></p>
    <ul class="ss__list" id="ss-list" role="listbox" data-ss-list aria-label={t('search.label')}></ul>

    <p class="ss__hint">
      <span class="ss__keys"><kbd>↑</kbd><kbd>↓</kbd></span> {t('search.hintMove')}
      <span class="ss__keys"><kbd>↵</kbd></span> {t('search.hintOpen')}
      <span class="ss__keys"><kbd>esc</kbd></span> {t('search.hintClose')}
    </p>
  </div>

  {/* Both of these are templates for the same reason: Astro stamps its scope
      attribute on the markup it compiles, and an element built with
      createElement in the script below carries no such attribute — so every
      rule written for it silently does nothing. The group headings and the
      hand-off row were both plain createElement, and both were rendering
      unstyled. */}
  <template data-ss-head>
    <li class="ss__head" role="presentation"></li>
  </template>

  <template data-ss-row>
    <li class="ss__row" role="option">
      <a class="ss__hit" href="#">
        <span class="ss__g" data-g></span>
        <span class="ss__txt">
          <span class="ss__n" data-n></span>
          <span class="ss__s" data-s></span>
        </span>
        <span class="ss__m" data-m></span>
      </a>
    </li>
  </template>
</dialog>
)}

<style>
  /* ---------- the key in the bar ---------- */
  /* The bar's own rules are in Base's scoped stylesheet and in bright.css, and
     only the second of those can reach a button this component renders —
     Astro stamps its scope on the template it belongs to, so `.topbar--ghost
     button { pointer-events: auto }` over in Base matches every key but this
     one. Which is why the key was there, was visible, and could not be
     pressed. Both of the things that rule was giving it are restated here. */
  .ss__key {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    cursor: pointer;
    pointer-events: auto;
    font: inherit;
    /* The size, the leading and the padding the four doors are set at. The
       bar's own rules are written for anchors and this is a button, so it was
       inheriting the body's line-height and the kit's own padding — 42px
       against their 36. */
    font-size: var(--step--1);
    line-height: 1.2;
    padding-block: 0.4rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    border: 0;
    background: none;
  }
  .ss__key:hover { color: var(--gold-bright); }
  :global(html[data-theme='bright']) .ss__key,
  :global(html[data-theme='bright']) .ss__key:hover { color: var(--museum-ink); }
  /* A capsule, not a plate. The four doors stand on the plate struck for the
     bar; this one opens a drawer rather than a room, and a different shape is
     how a bar says so without a second colour or a second weight. Same cream,
     same gold rule, drawn rather than photographed because a nine-slice of a
     rectangle cannot be made round. */
  :global(html[data-theme='bright']) .ss__key {
    position: relative;
    isolation: isolate;
    background: none;
    /* And nothing of the tablet left under it. `background: none` took the
       kit's fill and the bar takes its nine-slice skin, but a glass button is
       three things: the fill, the skin, and the blur-and-shadow that make it
       glass. Those last two are properties of the BUTTON, not of a
       pseudo-element, so they survived both — a 7px-rounded rectangle of
       blurred room with a soft drop shadow, standing behind a capsule. That
       is the rounded rectangle still showing. */
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
    /* and if anything of the kit's is ever drawn on the box again, it is
       drawn as a capsule */
    border-radius: 999px;
  }
  /* Drawn on ::after, and inset to match.
     ::before is the button kit's glass skin and the bar hides it — hides it
     for this key too, which is why a capsule drawn there was invisible. And
     the inset: the plate beside it is a picture whose cream panel runs from
     11.9% to 79.3% of its height, so a capsule filling the whole key stood a
     third taller than the four doors next to it. */
  :global(html[data-theme='bright']) .ss__key::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 12% 0 21%;
    /* the kit draws a nine-slice here and blends it; neither applies */
    border: 0;
    border-image: none;
    mix-blend-mode: normal;
    opacity: 1;
    border-radius: 999px;
    background: rgba(251, 246, 235, 0.96);
    /* the plate's own double rule, at the plate's own weight: a gold line,
       then the cream inside it */
    box-shadow:
      inset 0 0 0 1.6px rgba(186, 148, 74, 0.95),
      inset 0 0 0 3px rgba(255, 253, 247, 0.95),
      0 1px 2px rgba(70, 52, 16, 0.14);
  }
  :global(html[data-theme='bright']) .ss__key:hover::after { filter: brightness(1.03); }
  .ss__ico { flex: none; opacity: 0.78; }

  /* ---------- the plate ----------
     A dialog rather than a div, for three things that would otherwise be
     hand-written and wrong: the top layer, so nothing on the page — not the
     pinned way on at 45, not the room fade at 30 — can paint over it; the
     focus trap; and Escape. */
  .ss {
    /* Fixed and full-bleed, stated: a modal dialog is centred by the UA with
       auto margins, and this one carries its own plate. And it takes its own
       presses — the hall's bar is pointer-events: none so that the room can be
       clicked through it, and pointer-events inherits. */
    position: fixed;
    inset: 0;
    margin: 0;
    pointer-events: auto;
    border: 0;
    padding: 0;
    background: none;
    max-inline-size: none;
    max-block-size: none;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
    color: var(--text);
  }
  /* ---------- two museums, one drawer ----------
     The plate takes the ground of whichever museum it opened in. Written as
     three properties rather than as two copies of the panel, because
     everything else about it — the ink, the rules, the marked row — is
     already in tokens that both palettes define. */
  .ss {
    --ss-bg: color-mix(in srgb, var(--bg-1) 94%, transparent);
    --ss-line: var(--line);
    --ss-veil: rgba(12, 9, 6, 0.62);
    --ss-key: rgba(255, 255, 255, 0.08);
  }
  :global(html[data-theme='bright']) .ss {
    --ss-bg: rgba(255, 255, 255, 0.86);
    --ss-line: rgba(20, 18, 16, 0.1);
    --ss-veil: rgba(246, 243, 238, 0.5);
    --ss-key: rgba(20, 18, 16, 0.06);
  }
  .ss::backdrop {
    /* the room seen through frosted glass, not blacked out: this is a drawer
       over a museum, and the museum should still be there behind it */
    background: var(--ss-veil, rgba(246, 243, 238, 0.5));
    backdrop-filter: blur(9px) saturate(1.25);
  }
  /* ::backdrop does not inherit from the element it belongs to, so the veil
     has to be stated for each museum on the pseudo-element itself */
  :global(html[data-theme='bright']) .ss::backdrop { background: rgba(246, 243, 238, 0.5); }
  :global(html:not([data-theme='bright'])) .ss::backdrop { background: rgba(12, 9, 6, 0.62); }
  .ss__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: min(12vh, 6.5rem);
    margin-inline: auto;
    inline-size: min(100% - 2rem, 40rem);
    max-block-size: min(76vh, 40rem);
    display: grid;
    grid-template-rows: auto auto auto minmax(0, 1fr) auto;
    background: var(--ss-bg);
    backdrop-filter: blur(14px) saturate(1.5);
    border-radius: 0.9rem;
    box-shadow:
      inset 0 0 0 1px var(--ss-line),
      0 2px 6px rgba(20, 16, 10, 0.14),
      0 26px 60px -24px rgba(20, 16, 10, 0.6);
    overflow: hidden;
  }
  /* it arrives; it does not appear */
  .ss[open] .ss__panel { animation: ss-in 0.28s var(--museum-ease, var(--ease)) backwards; }
  @keyframes ss-in {
    from { opacity: 0; translate: 0 -0.7rem; scale: 0.985; }
  }
  :global(html[data-motion='off']) .ss[open] .ss__panel { animation: none; }

  /* ---------- the field ---------- */
  .ss__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1rem 0.85rem 1.1rem;
    border-block-end: 1px solid var(--ss-line);
  }
  .ss__bar-ico { flex: none; color: var(--gold-orn, #b8862a); }
  .ss__in {
    flex: 1;
    min-inline-size: 0;
    font: inherit;
    font-size: var(--step-1);
    color: var(--cream);
    background: none;
    border: 0;
    padding: 0.1rem 0;
  }
  .ss__in::placeholder { color: var(--muted-dim); }
  .ss__in:focus { outline: none; }
  .ss__in::-webkit-search-cancel-button { display: none; }
  .ss__close {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border: 0;
    border-radius: 50%;
    background: var(--ss-key);
    color: var(--muted);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .ss__close:hover { filter: brightness(1.3); color: var(--cream); }

  /* ---------- the list ---------- */
  .ss__lede {
    margin: 0;
    padding: 0.75rem 1.1rem 0.2rem;
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .ss__list {
    margin: 0;
    padding: 0.35rem 0.5rem 0.6rem;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .ss__head {
    padding: 0.6rem 0.6rem 0.25rem;
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-dim);
  }
  .ss__hit {
    display: grid;
    grid-template-columns: 0.28rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    border-radius: 0.55rem;
    text-decoration: none;
    color: inherit;
  }
  /* the rule at the head of a row, in the museum's own red — the same mark
     the first entry of every 延伸探索 list carries */
  .ss__g {
    align-self: stretch;
    border-radius: 2px;
    background: var(--line-hi);
  }
  .ss__row[data-g='l'] .ss__g { background: var(--accent); }
  .ss__row[data-g='r'] .ss__g { background: var(--gold-orn, #b8862a); }
  /* a hit in the text is a sentence, not a name: the line is set in the body
     face, and the sentence under it is what the row is for */
  .ss__row[data-g='t'] .ss__n { font-family: inherit; font-size: var(--step--1); }
  .ss__row[data-g='t'] .ss__s { color: var(--text); }
  .ss__txt { display: grid; gap: 0.08rem; min-inline-size: 0; }
  .ss__n {
    font-family: var(--font-han-serif);
    font-size: var(--step-0);
    color: var(--cream);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ss__s {
    font-size: var(--step--1);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ss__m {
    font-size: var(--step--2);
    color: var(--muted-dim);
    white-space: nowrap;
    letter-spacing: 0.06em;
  }
  /* One highlight, and the keyboard and the mouse share it: two different
     'current' rows is how a list like this stops being usable. */
  .ss__row[data-on] .ss__hit {
    background: rgba(169, 50, 43, 0.09);
    box-shadow: inset 0 0 0 1px rgba(169, 50, 43, 0.16);
  }
  .ss__row[data-on] .ss__n { color: var(--accent); }
  .ss__hit :global(mark) {
    background: rgba(184, 134, 42, 0.28);
    color: inherit;
    border-radius: 2px;
    padding: 0 0.08em;
  }

  /* the hand-off to the index of films is a different kind of thing from a
     hit, and is ruled off from them */
  .ss__row--all { margin-block-start: 0.35rem; border-block-start: 1px solid var(--ss-line); padding-block-start: 0.35rem; }
  .ss__row--all .ss__n { font-family: inherit; font-size: var(--step--1); color: var(--accent); }
  .ss__row--all .ss__g { background: none; }

  .ss__none { margin: 0; padding: 1.1rem 1.15rem 0.2rem; font-size: var(--step--1); color: var(--muted); }
  .ss__none :global(b) { color: var(--cream); font-weight: 500; }

  .ss__hint {
    margin: 0;
    padding: 0.55rem 1.1rem 0.65rem;
    border-block-start: 1px solid var(--ss-line);
    font-size: var(--step--2);
    color: var(--muted-dim);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .ss__keys { display: inline-flex; gap: 0.15rem; margin-inline-start: 0.5rem; }
  .ss__keys:first-child { margin-inline-start: 0; }
  .ss__hint kbd {
    font: inherit;
    font-size: 0.92em;
    min-inline-size: 1.35em;
    text-align: center;
    padding: 0.05em 0.3em;
    border-radius: 0.28rem;
    background: var(--ss-key);
    box-shadow: inset 0 0 0 1px var(--ss-line);
    color: var(--muted);
  }

  /* On a phone the plate is very nearly the screen, and the keyboard takes
     half of what is left — so the hint line goes, because a row of key caps is
     no use to a thumb.

     It used to start half a rem from the top. A phone's address bar sits over
     the top of the window in several of the states a phone is held in, and
     what it covered was the field: the panel opened and the thing you had
     opened it to type into was behind the browser's own chrome. So the gap is
     ten times what it was, at the owner's word — and the cap has to come down
     by the same amount plus the half-rem the panel keeps at the foot, or the
     bottom of the list lands off a screen that cannot scroll: the dialog is
     100% of the window with `overflow: visible`, the plate clips its own
     overflow, and the document behind is locked while the dialog is open.
     What it costs is about a screen-row and a half of results, and the list
     scrolls. */
  @media (max-width: 40rem) {
    .ss__panel {
      inset-block-start: 5rem;
      inline-size: min(100% - 1rem, 40rem);
      max-block-size: calc(100svh - 5.5rem);
      border-radius: 0.7rem;
    }
    .ss__hint { display: none; }
    .ss__in { font-size: 1.05rem; }   /* 16px or more, or iOS zooms the page */
    /* A hit in the text is its sentence, and on a phone the sentence is what
       was being cut: the page's name on the right took a third of the row and
       the one line left showed fourteen characters, often not the marked
       ones. So the name goes under the sentence and the sentence has two
       lines. */
    .ss__row[data-g='t'] .ss__hit { grid-template-columns: 0.28rem minmax(0, 1fr); }
    .ss__row[data-g='t'] .ss__g { grid-row: 1 / 3; }
    .ss__row[data-g='t'] .ss__m { grid-column: 2; justify-self: start; margin-block-start: -0.1rem; }
    .ss__row[data-g='t'] .ss__s {
      white-space: normal;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }
  }
</style>

<script>
  /**
   * The drawer.
   *
   * What the museum holds is in one attribute on the dialog, so the first
   * keystroke needs no fetch. What the pages SAY is a second file, fetched
   * the first time the drawer opens and folded once — see `fold` — so that a
   * query can be matched against it as fast as against the first. What the
   * script does is decide an order and paint it; see the note at the head of
   * this file for why the match is a plain substring.
   */
  type Row = { n: string; s: string; m: string; h: string; g: 'l' | 'r' | 'p' | 't'; k: string;
               /** a text hit carries its sentence ready-marked */ frag?: DocumentFragment };
  type Section = { h: string; a: string; x: string };
  type Page = { u: string; t: string; s: Section[] };
  /** a page, folded: the text as it is matched, and where each folded
      character came from in the text as it is shown */
  type Folded = { s: string; map: number[] };
  type Ready = { page: Page; title: Folded; secs: { sec: Section; head: Folded; body: Folded }[] };

  /**
   * One spelling for the match. Case is folded, width is folded (a full-width
   * 'Ｋ' is a 'k'), the accents come off ('Südhof' answers to 'sudhof'), and
   * the museum's own separator in a Chinese name — 布萊恩‧科比爾卡 — is struck,
   * so that a name typed without it still finds the person. Every character
   * of the result remembers which character of the original it came from,
   * which is what lets a hit be cut out of the ORIGINAL and shown.
   */
  function fold(text: string): Folded {
    let s = '';
    const map: number[] = [];
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (c === '\u2027' || c === '\u00b7' || c === '\u30fb' || c === '\u2022') continue;
      /* a typewriter's quotes for the typesetter's: the same word is on one
         page with ’ and on another with ' */
      const q = c === '\u2018' || c === '\u2019' ? "'" : c === '\u201c' || c === '\u201d' ? '"' : c;
      const f = q.normalize('NFKC').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      for (const ch of f) { s += ch; map.push(i); }
    }
    return { s, map };
  }
  const foldQ = (q: string) => fold(q).s;

  const dlg = document.querySelector<HTMLDialogElement>('[data-ss]');
  const openers = [...document.querySelectorAll<HTMLButtonElement>('[data-ss-open]')];

  if (dlg && openers.length) {
    const rows: Row[] = JSON.parse(dlg.dataset.index ?? '[]');
    const suggested: number[] = JSON.parse(dlg.dataset.suggested ?? '[]');
    const groups: Record<string, string> = JSON.parse(dlg.dataset.groups ?? '{}');
    const input = dlg.querySelector<HTMLInputElement>('[data-ss-in]')!;
    const list = dlg.querySelector<HTMLUListElement>('[data-ss-list]')!;
    const lede = dlg.querySelector<HTMLElement>('[data-ss-lede]')!;
    const none = dlg.querySelector<HTMLElement>('[data-ss-none]')!;
    const tpl = dlg.querySelector<HTMLTemplateElement>('[data-ss-row]')!;
    const headTpl = dlg.querySelector<HTMLTemplateElement>('[data-ss-head]')!;
    const form = dlg.querySelector<HTMLFormElement>('[data-ss-form]')!;

    let shown: Row[] = [];
    let at = 0;

    /* ── the second index ─────────────────────────────────────────────────
       Fetched once, on the first opening, and folded once. Until it has
       arrived the drawer answers from the first index alone; when it lands,
       whatever is in the field is painted again. A fetch that fails leaves
       the drawer exactly as it was before there was a second index. */
    let ready: Ready[] | null = null;
    let asked = false;
    function loadText() {
      if (asked || !dlg!.dataset.text) return;
      asked = true;
      fetch(dlg!.dataset.text)
        .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        .then((data: { pages: Page[] }) => {
          ready = data.pages.map((page) => ({
            page,
            title: fold(page.t),
            secs: page.s.map((sec) => ({ sec, head: fold(sec.h), body: fold(sec.x) })),
          }));
          if (dlg!.open && input.value.trim()) paint();
        })
        /* one more try at the next opening; until then the drawer answers
           from what it has and says it is still waiting */
        .catch(() => { ready = null; asked = false; });
    }
    const waiting = () => asked && !ready;

    /**
     * Where a query lands in the pages' own text. Every term has to be in
     * the section — its heading, its body, or the page's title — and what
     * decides the order is where the FIRST term lands: a title, a heading,
     * the body. Two sections of one page at most, so that a page which says
     * a word nine times does not fill the list nine times over.
     */
    function textHits(q: string, taken: Set<string>): { r: Row; sc: number }[] {
      if (!ready) return [];
      const terms = q.split(/\s+/).filter(Boolean).map(foldQ).filter(Boolean);
      if (!terms.length) return [];
      const first = terms[0];
      const out: { r: Row; sc: number }[] = [];
      for (const { page, title, secs } of ready) {
        const pagePath = page.u;
        const known = taken.has(pagePath);
        let taken2 = 0;
        for (const { sec, head, body } of secs) {
          if (taken2 >= 2) break;
          const all = terms.every((t) => title.s.includes(t) || head.s.includes(t) || body.s.includes(t));
          if (!all) continue;
          /* the sentence quoted is the first term's, if it is in the body at
             all; otherwise the first term that is — 'sudhof 阿茲海默' quotes
             the sentence about Alzheimer's, since the name is in the heading */
          const inBody = terms.find((t) => body.s.includes(t));
          const atBody = inBody ? body.s.indexOf(inBody) : -1;
          const term = inBody ?? first;
          const atHead = head.s.indexOf(first);
          let sc: number;
          if (atBody >= 0) {
            let n = 0;
            for (let i = atBody; i >= 0 && n < 6; i = body.s.indexOf(term, i + term.length)) n++;
            sc = 24 + n * 2 + (inBody === first ? 2 : 0);
          } else if (atHead >= 0) sc = 40;
          else if (title.s.includes(first)) sc = 46;
          else continue;
          /* a page the first index has already put in the list is not put
             in it again for its name — only for a sentence in its body */
          if (known && atBody < 0) continue;
          taken2++;

          const { text, frag } = snippet(sec.x, body, atBody, term, terms);
          const n = sec.h || page.t;
          /* a hit in the body lands on its sentence; a hit in a heading lands
             on the heading by its own words, because several headings on one
             page can share one ancestor's anchor */
          const fragment = atBody >= 0
            ? textFragment(sec.x, body, atBody, term)
            : atHead >= 0 ? textFragment(sec.h, head, atHead, first) : '';
          out.push({
            sc,
            r: {
              n, s: text, m: sec.h ? page.t : '', g: 't', k: '',
              h: page.u + hashFor(sec.a, fragment),
              frag,
            },
          });
        }
      }
      return out;
    }

    /** the section's anchor, the fragment, both or neither — never a bare # */
    const hashFor = (a: string, frag: string) => (a || frag ? `#${a}${frag}` : '');

    /** the sentence around the first match, cut from the original text, with
        every term in it marked; or the start of the section when the match
        is in the heading or the title */
    function snippet(x: string, body: Folded, at: number, first: string, terms: string[]) {
      let start = 0, end = Math.min(x.length, 110);
      let cutL = false, cutR = end < x.length;
      if (at >= 0) {
        /* within the block the match is in — blocks are joined on newlines
           by the indexer — and cut short with an ellipsis only when the block
           itself runs on further than the row can show */
        const o1 = body.map[at];
        const bs = x.lastIndexOf('\n', o1 - 1) + 1;
        const beAt = x.indexOf('\n', o1);
        let be = beAt < 0 ? x.length : beAt;
        /* a block of a few words — a label, a date, a name on its own line —
           is shown with the line after it, which is what it was labelling */
        if (be - bs < 16 && beAt >= 0) {
          const next = x.indexOf('\n', be + 1);
          be = next < 0 ? x.length : next;
        }
        start = Math.max(bs, o1 - 26);
        end = Math.min(be, o1 + first.length + 84);
        /* not through the middle of a Latin word */
        while (start > bs && /[A-Za-z0-9]/.test(x[start - 1]) && /[A-Za-z0-9]/.test(x[start])) start--;
        if (start > bs && x[start] >= '\udc00' && x[start] <= '\udfff') start--;
        cutL = start > bs;
        cutR = end < be;
      }
      const raw = (cutL ? '…' : '') + x.slice(start, end) + (cutR ? '…' : '');
      const f = fold(raw);
      /* every term's every occurrence, as ranges in the original */
      const ranges: [number, number][] = [];
      for (const t of terms) {
        for (let i = f.s.indexOf(t); i >= 0; i = f.s.indexOf(t, i + t.length)) {
          ranges.push([f.map[i], f.map[i + t.length - 1] + 1]);
        }
      }
      ranges.sort((a, b) => a[0] - b[0]);
      const frag = document.createDocumentFragment();
      let pos = 0;
      for (const [a, b] of ranges) {
        if (a < pos) continue;
        frag.append(raw.slice(pos, a));
        const m = document.createElement('mark');
        m.textContent = raw.slice(a, b);
        frag.append(m);
        pos = b;
      }
      frag.append(raw.slice(pos));
      return { text: raw, frag };
    }

    /**
     * The URL's own way of saying 'this sentence': a text fragment. The page
     * opens scrolled to the clause the match is in, with the clause marked,
     * in every browser that reads them; in one that does not, the hash before
     * it still lands the reader on the section. The clause runs between two
     * marks of punctuation, because a boundary the browser is certain of is
     * one it will honour in either language.
     */
    function textFragment(x: string, body: Folded, at: number, first: string): string {
      if (at < 0) return '';
      const o1 = body.map[at];
      const o2 = body.map[at + first.length - 1] + 1;
      const STOP = /[\n。！？；，、：「」『』（）()\[\].!?;:,"“”·‧]/;
      let a = o1, b = o2;
      while (a > 0 && !STOP.test(x[a - 1]) && o1 - a < 70) a--;
      while (b < x.length && !STOP.test(x[b]) && b - o2 < 70) b++;
      /* a fragment has to start and end on a word: where the cap fell inside
         one, back off to the space before or after it */
      const W = /[A-Za-z0-9]/;
      while (a > 0 && a < o1 && W.test(x[a - 1]) && W.test(x[a])) a--;
      while (b < x.length && b > o2 && W.test(x[b - 1]) && W.test(x[b])) b++;
      /* and never between the two halves of one character */
      const lo = (c: string) => c >= '\udc00' && c <= '\udfff';
      if (a > 0 && lo(x[a])) a--;
      if (b < x.length && lo(x[b])) b++;
      const clause = x.slice(a, b).trim();
      if (!clause) return '';
      const enc = (t: string) => encodeURIComponent(t).replace(/-/g, '%2D');
      try {
        /* A clause of a word or two — a term in brackets, a name in quotes —
           is on most pages more than once, and the browser lands on the
           first. So a short one is pinned by what stands around it: up to
           twenty characters before and after, within the same block. The
           prefix has to end on a word and the suffix begin on one; both do,
           because what bounded the clause was punctuation. */
        if (clause.length >= 12) return `:~:text=${enc(clause)}`;
        const nl = (i: number, dir: -1 | 1) => {
          let j = i;
          while (j > 0 && j < x.length && x[j + (dir < 0 ? -1 : 0)] !== '\n' && Math.abs(j - i) < 20) j += dir;
          return j;
        };
        let pa = nl(a, -1), sb = nl(b, 1);
        while (pa > 0 && pa < a && W.test(x[pa - 1]) && W.test(x[pa])) pa++;
        while (sb < x.length && sb > b && W.test(x[sb - 1]) && W.test(x[sb])) sb--;
        /* Neither may be cut inside a Han word — the browser will not take
           「其」 for 「其後」 — and Han has no spaces to cut at, so each is
           trimmed to the punctuation or space nearest the clause's side of
           the window: the prefix loses its head up to the first mark, the
           suffix its tail from the last. */
        let prefix = x.slice(pa, a);
        let suffix = x.slice(b, sb);
        const cutP = prefix.search(/[\s。！？；，、：「」『』（）()\[\].!?;:,"“”·‧]/);
        if (cutP >= 0 && cutP < prefix.length - 2) prefix = prefix.slice(cutP + 1);
        const marks = [...suffix.matchAll(/[\s。！？；，、：「」『』（）()\[\].!?;:,"“”·‧]/g)];
        const lastM = marks.length ? marks[marks.length - 1].index! : -1;
        if (lastM >= 2) suffix = suffix.slice(0, lastM + 1);
        prefix = prefix.trim();
        suffix = suffix.trim();
        return `:~:text=${prefix ? enc(prefix) + '-,' : ''}${enc(clause)}${suffix ? ',-' + enc(suffix) : ''}`;
      } catch {
        return '';
      }
    }

    /* The first index, folded once — see fold(): 'sudhof' has to find Südhof
       here as well as in the text */
    const folded = new Map<Row, { n: string; s: string; k: string }>();
    const fo = (r: Row) => {
      let f = folded.get(r);
      if (!f) { f = { n: fold(r.n).s, s: fold(r.s).s, k: fold(r.k).s }; folded.set(r, f); }
      return f;
    };

    /** Where the match lands is the whole ranking: a name beats a subtitle
        beats the body, and starting the field beats being inside it. */
    function score(r: Row, q: string): number {
      const { n, s, k } = fo(r);
      let sc = 0;
      if (n.startsWith(q)) sc = 100;
      else if (n.includes(q)) sc = 70;
      else if (s.startsWith(q)) sc = 45;
      else if (s.includes(q)) sc = 34;
      else if (k.includes(q)) sc = 18;
      else return 0;
      /* a room or a page is a bigger thing than one lecture, and a visitor
         typing three letters is usually after the bigger thing */
      if (r.g !== 'l') sc += 6;
      /* the shorter the field the more of it the query is */
      sc += Math.max(0, 8 - n.length / 6);
      return sc;
    }

    /** the query, marked where it lands in a line — found in the folded line,
        cut out of the original one */
    function mark(text: string, q: string): DocumentFragment {
      const frag = document.createDocumentFragment();
      if (!q) { frag.append(text); return frag; }
      const f = fold(text);
      const i = f.s.indexOf(q);
      if (i < 0) { frag.append(text); return frag; }
      const a = f.map[i], b = f.map[i + q.length - 1] + 1;
      const m = document.createElement('mark');
      m.textContent = text.slice(a, b);
      frag.append(text.slice(0, a), m, text.slice(b));
      return frag;
    }

    function paint() {
      const q = foldQ(input.value.trim());
      list.replaceChildren();
      none.hidden = true;

      /* Relevance decides which rows, and which group leads; the group then
         keeps its rows together. Sorting on score alone interleaved the three
         and printed 得主 / 展廳 / 得主 down the list. */
      if (q) {
        const own = rows.map((r) => ({ r, sc: score(r, q) }))
          .filter((x) => x.sc > 0)
          .sort((a, b) => b.sc - a.sc)
          .slice(0, 24);
        /* the pages the first index has already answered with, by address */
        const taken = new Set(own.map((x) => x.r.h.replace(/[#?].*$/, '')));
        /* two rows that would open the same place are one row */
        const seenH = new Set<string>();
        const text = textHits(q, taken).sort((a, b) => b.sc - a.sc)
          .filter((x) => !seenH.has(x.r.h) && seenH.add(x.r.h)).slice(0, 12);
        const hits = [...own, ...text];
        const rank = new Map<string, number>();
        hits.forEach((x) => { if (!rank.has(x.r.g)) rank.set(x.r.g, rank.size); });
        shown = hits
          .sort((a, b) => (rank.get(a.r.g)! - rank.get(b.r.g)!) || (b.sc - a.sc))
          .map((x) => x.r);
      } else {
        shown = suggested.map((i) => rows[i]).filter(Boolean);
      }

      lede.hidden = !!q;

      if (q && !shown.length) {
        none.hidden = false;
        none.replaceChildren();
        if (waiting()) {
          none.append(dlg!.dataset.loading ?? '…');
        } else {
          const [before, after] = (dlg!.dataset.empty ?? '{q}').split('{q}');
          const b = document.createElement('b');
          b.textContent = input.value.trim();
          none.append(before, b, after ?? '');
        }
      }

      let group = '';
      shown.forEach((r, i) => {
        if (r.g !== group) {
          group = r.g;
          const hf = headTpl.content.cloneNode(true) as DocumentFragment;
          hf.querySelector('li')!.textContent = groups[r.g] ?? '';
          list.append(hf);
        }
        const frag = tpl.content.cloneNode(true) as DocumentFragment;
        const li = frag.querySelector<HTMLElement>('.ss__row')!;
        const a = frag.querySelector<HTMLAnchorElement>('.ss__hit')!;
        li.dataset.g = r.g;
        li.id = `ss-o${i}`;
        a.href = r.h;
        frag.querySelector('[data-n]')!.append(mark(r.n, q));
        /* a text hit arrives with its sentence already marked, term by term */
        frag.querySelector('[data-s]')!.append(r.frag ?? mark(r.s, q));
        frag.querySelector('[data-m]')!.textContent = r.m;
        li.addEventListener('mousemove', () => select(i, false));
        list.append(frag);
      });

      /* the whole index, for a query this drawer could not place: the films'
         own descriptions are searched there and not here */
      if (q) {
        /* the same template as a hit, so it carries the same scope and the
           same shape — only its class and its one line differ */
        const frag = tpl.content.cloneNode(true) as DocumentFragment;
        const li = frag.querySelector<HTMLElement>('.ss__row')!;
        const a = frag.querySelector<HTMLAnchorElement>('.ss__hit')!;
        li.classList.add('ss__row--all');
        li.dataset.g = 'x';
        li.id = `ss-o${shown.length}`;
        a.href = `${dlg!.dataset.browse}?q=${encodeURIComponent(input.value.trim())}`;
        frag.querySelector('[data-n]')!.textContent =
          (dlg!.dataset.all ?? '').replace('{q}', input.value.trim());
        const at2 = shown.length;
        li.addEventListener('mousemove', () => select(at2, false));
        list.append(frag);
        shown = [...shown, { n: '', s: '', m: '', h: a.href, g: 'p', k: '' }];
      }

      select(0, false);
    }

    function select(i: number, scroll = true) {
      const items = [...list.querySelectorAll<HTMLElement>('.ss__row')];
      if (!items.length) return;
      at = Math.max(0, Math.min(i, items.length - 1));
      items.forEach((el, j) => el.toggleAttribute('data-on', j === at));
      input.setAttribute('aria-activedescendant', items[at].id);
      if (scroll) items[at].scrollIntoView({ block: 'nearest' });
    }

    function open() {
      if (dlg!.open) return;
      dlg!.showModal();
      input.value = '';
      loadText();
      /* The caret, not the first row: this opens because someone means to
         type. `autofocus` on the field is what actually puts it there — the
         dialog's own focusing steps run inside showModal() above, inside the
         press, which is the only moment a phone will raise its keyboard. This
         is the second ask, for the ways in that are not a press: the two
         keyboard shortcuts below, and any browser that reads autofocus only
         on a page's first load. It runs in the same turn, not a frame later,
         so it spends nothing. */
      input.focus();
      paint();
    }

    for (const b of openers) b.addEventListener('click', open);
    /* A hit on the page the reader is already on is a same-document move,
       and the browser will not make it while a modal dialog is open — the
       row did nothing at all. So the drawer closes before the browser reads
       the address; and where the address is the one already in the bar, the
       hash is cleared first so there is a move to make. */
    list.addEventListener('click', (ev) => {
      const a = (ev.target as Element).closest<HTMLAnchorElement>('a.ss__hit');
      if (!a) return;
      const to = new URL(a.href, location.href);
      if (to.origin !== location.origin || to.pathname !== location.pathname || to.search !== location.search) return;
      dlg!.close();
      if (to.hash && to.hash === location.hash) history.replaceState(history.state, '', location.pathname + location.search);
    });
    dlg.querySelector('[data-ss-close]')?.addEventListener('click', () => dlg.close());
    /* the backdrop is part of the dialog's own box, so a press that lands on
       the dialog itself rather than on the plate is a press outside */
    dlg.addEventListener('mousedown', (ev) => { if (ev.target === dlg) dlg.close(); });

    let t = 0;
    input.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(paint, 90);
    });

    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const items = [...list.querySelectorAll<HTMLAnchorElement>('.ss__hit')];
      items[at]?.click();
    });

    dlg.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowDown') { ev.preventDefault(); select(at + 1); }
      else if (ev.key === 'ArrowUp') { ev.preventDefault(); select(at - 1); }
      else if (ev.key === 'Home' && ev.target === input && !input.value) select(0);
      else if (ev.key === 'Enter' && ev.target !== input) return;
    });

    /* Two ways in from the keyboard, and neither may steal a keystroke from a
       field: slash is what every index uses, and cmd-K is what every drawer
       like this one uses. */
    addEventListener('keydown', (ev) => {
      const el = document.activeElement;
      const typing = el instanceof HTMLElement &&
        (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
      if ((ev.key === 'k' || ev.key === 'K') && (ev.metaKey || ev.ctrlKey)) {
        ev.preventDefault(); open();
      } else if (ev.key === '/' && !typing && !dlg.open) {
        ev.preventDefault(); open();
      }
    });
  }
</script>
