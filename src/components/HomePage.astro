---
import Base from '../layouts/Base.astro';
import Hall from './Hall.astro';
import Hall3D from './Hall3D.astro';
import HallGL from './HallGL.astro';
import HallModels from './HallModels.astro';
import HallBright from './HallBright.astro';
import LectureCard from './LectureCard.astro';
import VideoFacade from './VideoFacade.astro';
import { useT, type Lang } from '../i18n/ui';
import { browse, lecture as lectureUrl } from '../i18n/routing';
import { lectures, byDateDesc, catName, nextUpcoming, recommended, localDate, catPrizeName, videoCounts, totalSittings } from '../data/catalog';

interface Props { lang: Lang; style?: 'flat' | 'room' | 'gl' | 'models' }
const { lang, style = 'flat' } = Astro.props;
/** the bright build has one hall of its own — see BRIGHT in astro.config.mjs */
const bright = process.env.THEME === 'bright';
const t = useT(lang);

const byDate = byDateDesc();

/* The announcement slot is never empty: the next lecture if the schedule still
   has one, otherwise the richest lecture on the site. `today` is the build
   date — see nextUpcoming() in src/data/catalog.ts. */
const today = new Date().toISOString().slice(0, 10);
const upcoming = nextUpcoming(today);
const featured = upcoming ?? recommended();
const latest = byDate.filter((l) => l.id !== featured.id).slice(0, 6);
const featuredCat = catName(featured.prize.category, lang);
const featuredPrize = catPrizeName(featured.prize.category, lang);
const featuredDate = localDate(featured.event.date, lang, true);
const featuredHost = lang === 'zh' ? featured.event.host_zh : featured.event.host_en;

/* The number of films this museum shows, which is the number the index of
   films lists — 導讀 + 講座 + 專訪, the three figures standing next to it in
   this very row. It was totalVideos(), which counts something else: every
   file on the site, including the second upload of six lectures, two extra
   sittings and five opening-ceremony clips, none of which is a row in the
   index. 74 beside a page that says 62 is not a richer count, it is a
   contradiction. */
/* Six figures rather than three, and each one counted rather than repeated:
   the first pair used to be the same number under two labels. Laureates are
   distinct people — a laureate who came twice is one laureate — and the three
   kinds of film are what the browse page already filters by. */
const kinds = videoCounts();
const nLaureates = new Set(lectures.map((l) => l.laureate.en)).size;
const nHosts = new Set(lectures.map((l) => l.event.host_en)).size;
const figures = [
  { n: nLaureates,      label: t('hall.stat.laureates') },
  { n: kinds.all,       label: t('hall.stat.videos') },
  /* sittings, not lectures — see 'A lecture, and a sitting' in catalog.ts */
  { n: totalSittings(),  label: t('hall.stat.lectures') },
  { n: kinds.guide,     label: t('hall.stat.guide') },
  { n: kinds.record,    label: t('hall.stat.interview') },
  { n: nHosts,          label: t('hall.stat.hosts') },
];
---

<Base lang={lang} bare>
  {bright ? <HallBright lang={lang} />
   : style === 'gl' ? <HallGL lang={lang} />
   : style === 'room' ? <Hall3D lang={lang} />
   : style === 'models' ? <HallModels lang={lang} />
   : <Hall lang={lang} />}

  {/* Everything under the hall travels together. In the bright museum it
      travels over an open room: this carries no ground of its own, so the
      strip, the cards and the video panes are what is seen, and the hall is
      seen between them. It is also where the cue at the foot of the hall
      leads. */}
  <div class="after" id="more">
  <section class="strip">
    <div class="wrap">
      <dl class="stats">
        {figures.map((f) => <div><dt>{f.n}</dt><dd>{f.label}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="feature wrap" aria-labelledby="feat-h">
    <div class="section-head">
      <h2 id="feat-h" class="section-h">{upcoming ? t('home.upcoming') : t('hall.featured')}</h2>
    </div>

    <div class="feature__grid" data-cat={featured.prize.category}>
      {featured.video.guide || featured.video.lecture ? (
        <VideoFacade
          id={(featured.video.guide ?? featured.video.lecture)!}
          title={`${featured.laureate[lang]} — ${featured.title.en}`}
          kind="guide"
          label={featured.video.guide ? t('lec.guide') : t('lec.lecture')}
          playHint={t('lec.playHint')}
          eager
        />
      ) : (
        <div class="feature__date" aria-hidden="true">
          <span class="feature__date-d">{featured.event.date.slice(8)}</span>
          <span class="feature__date-m">{featured.event.date.slice(0, 7)}</span>
        </div>
      )}

      {/* The whole block is the way in. A single '觀看 →' at the foot asked
          the reader to find the one live word in a paragraph they had just
          finished reading; the paragraph is about one lecture and there is
          only one place it can lead. */}
      <a class="feature__text stack" href={lectureUrl(lang, featured.id)}
         aria-label={`${featured.laureate[lang]} — ${upcoming ? t('home.upcomingCta') : t('hall.watch')}`}>
        <p class="eyebrow">{t('lec.prize', { year: featured.prize.year, category: featuredPrize })}</p>
        <h3 class="feature__who">{featured.laureate.en}</h3>
        {lang === 'zh' && <p class="gloss">{featured.laureate.zh}</p>}
        <p class="feature__hook">{featured.hook[lang]}</p>
        {upcoming ? (
          <p class="feature__when">{featuredDate} · {featuredHost}</p>
        ) : (
          <p>{featured.description[lang]}</p>
        )}
      </a>
    </div>
  </section>

  <section class="latest wrap" aria-labelledby="latest-h">
    <div class="section-head">
      <h2 id="latest-h" class="section-h">{t('hall.latest')}</h2>
      {/* The home page's one primary. Everything else on it is a destination
          the reader can reach from the hall or the bar; this is the single
          action the page is asking for, which is what the v2 kit reserves
          --primary for. The `more` class is gone with it: it painted the
          link gold and hung a white halo behind it, both of which were for
          bare text lying on the hall, not for a button. */}
      <a class="museum-glass-btn museum-glass-btn--primary" href={browse(lang)}>
        <span>{t('nav.all')}</span><span aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="grid" role="list">
      {latest.map((rec) => <li><LectureCard lang={lang} rec={rec} /></li>)}
    </ul>
  </section>
  </div>
</Base>

<style>
  /* opaque on the dark site, where there is nothing behind it; the bright
     museum takes the ground away entirely — see bright.css */
  .after { position: relative; z-index: 1; background: var(--bg-0); }
  .strip { border-block: 1px solid var(--line); background: var(--bg-1); }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.6rem, 1fr));
    gap: clamp(0.5rem, 1.4vw, 0.9rem);
    padding-block: 1.6rem; margin: 0;
    max-inline-size: 62rem; margin-inline: auto;
  }
  .stats div { text-align: center; }
  .stats dt {
    font-family: var(--font-display); font-size: var(--step-1);
    color: var(--gold-bright); line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .stats dd { margin: 0.3rem 0 0; font-size: var(--step--1); color: var(--muted); letter-spacing: 0.1em; }

  .section-h { font-size: var(--step-2); color: var(--cream); }
  .section-h::after {
    content: ''; display: block; inline-size: 3rem;
    border-block-start: 1px solid var(--gold); margin-block-start: 0.6rem; opacity: 0.6;
  }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

  .feature { margin-block-start: clamp(3rem, 8vw, 5.5rem); }
  .feature__grid { display: grid; gap: clamp(1.25rem, 3vw, 2.5rem); margin-block-start: 1.8rem; }
  @media (min-width: 56rem) { .feature__grid { grid-template-columns: 1.25fr 1fr; align-items: center; } }
  .feature__text {
    --gap: 0.5rem;
    display: grid;
    align-content: start;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius);
  }
  .feature__text:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .feature__hook {
    font-family: var(--font-hook); font-size: var(--step-1);
    color: var(--accent); line-height: 1.5;
  }
  .feature__who { font-family: var(--font-display); }
  .feature__when {
    font-size: var(--step-0); color: var(--cream);
    border-inline-start: 2px solid var(--accent); padding-inline-start: 0.85rem;
  }
  /* a lecture with no video yet still needs something to look at */
  .feature__date {
    display: grid; place-content: center; gap: 0.2rem; aspect-ratio: 16 / 9;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--radius);
    background:
      radial-gradient(70% 90% at 50% 20%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      var(--bg-1);
    text-align: center;
  }
  .feature__date-d {
    font-family: var(--font-display); font-size: var(--step-4); line-height: 1;
    color: var(--accent); font-variant-numeric: lining-nums tabular-nums;
  }
  .feature__date-m {
    font-size: var(--step--1); letter-spacing: 0.2em; color: var(--muted);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .more { font-size: var(--step--1); letter-spacing: 0.1em; text-decoration: none; color: var(--gold); }
  .more:hover { color: var(--gold-bright); }

  .latest { margin-block-start: clamp(3rem, 8vw, 5.5rem); }
  .grid {
    display: grid; gap: clamp(0.9rem, 2vw, 1.5rem); margin-block-start: 1.8rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
</style>
