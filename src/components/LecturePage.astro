---
import Base from '../layouts/Base.astro';
import ScrollCue from './ScrollCue.astro';
import VideoFacade from './VideoFacade.astro';
import LectureCard from './LectureCard.astro';
import Sculpture, { type CategoryKey } from './Sculpture.astro';
import ExtLink from './ExtLink.astro';
import StudyPanel from './StudyPanel.astro';
import CompareBlock from './CompareBlock.astro';
import { useT, type Lang } from '../i18n/ui';
import { gallery, home, asset } from '../i18n/routing';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { catName, tagName, relatedTo, localDate, type Lecture, catPrizeName,
         isNtu, seriesName } from '../data/catalog';

interface Props { lang: Lang; rec: Lecture }
const { lang, rec } = Astro.props;
const t = useT(lang);

const cat: CategoryKey = rec.prize.category;
const catPrize = catPrizeName(cat, lang);
const date = localDate(rec.event.date, lang, true);
const host = lang === 'zh' ? rec.event.host_zh : rec.event.host_en;
/* English is primary for names, as it is for the lecture titles; the Chinese
   rendering sits under it as a gloss. `who` is the plain-text form used for
   page titles and accessible labels. */
const who = rec.laureate.en;

const next = relatedTo(rec, 3);
/* Which collection this record belongs to. A record of 臺大「諾貝爾獎得主講座」
   renders on this page exactly as a 臺灣橋樑計畫 lecture does — the two things
   that differ are the series line in the facts list, and the three places
   below where a Bridges assumption would otherwise print something untrue:
   a 導讀 that is not coming, 天下's programme hub, and the study panel, whose
   chooser in the learning area lists the programme's 31. */
const ntu = isNtu(rec);
const seriesOf = seriesName(rec, lang);
/* Stoddart's sitting had no published talk title, so the series stands in the
   title's place. Printing it again as a fact would say the same words twice
   on one card. */
const series = seriesOf === rec.title.en || seriesOf === rec.title.zh ? null : seriesOf;
/** NTU 共同教育中心 collects all six NTU lectures and their material */
const NTU_CGE = 'https://cge.ntu.edu.tw/cl_n_203079.html';

/* the prize's own sculpture, in the bright museum — see GalleryPage for the
   note on why anything under public/ is fingerprinted here */
import { bright } from '../theme';
const stampAsset = (rel: string) => {
  const hash = createHash('sha256')
    .update(readFileSync(new URL(`../../public/${rel}`, import.meta.url)))
    .digest('hex').slice(0, 8);
  return `${asset(rel)}?v=${hash}`;
};
/* ---- 延伸探索 ---- the rail's list; see the aside below. */
const deeper = [
  { url: rec.links.nobel_lecture, title: t('lec.nobelLecture'), desc: t('lec.nobelLectureNote') },
  { url: rec.links.nobel_facts,   title: t('lec.nobelFacts'),   desc: t('lec.nobelFactsNote') },
  rec.links.ntu_spotlight && { url: rec.links.ntu_spotlight, title: t('lec.ntuSpotlight') },
  rec.links.ntu_epaper    && { url: rec.links.ntu_epaper,    title: t('lec.ntuNews') },
  rec.links.instagram     && { url: rec.links.instagram,     title: t('lec.instagram') },
  rec.links.ntu_spe       && { url: rec.links.ntu_spe,       title: t('lec.ntuSpe') },
  /* The record's own page at 共同教育中心 where it has one, otherwise the
     centre's index of the programme. Note that speech.ntu.edu.tw — where
     these recordings are published — sits behind a bot challenge and answers
     403 to any client, so it is never linked from here. */
  { url: rec.links.ntu_cge ?? NTU_CGE, title: t('lec.ntuCge'), desc: t('lec.ntuCgeNote') },
  /* 天下's hub covers 臺灣橋樑計畫. A record outside that programme is not in
     it, and an ExtLink with no href renders as a button that does nothing. */
  rec.links.cw_hub        && { url: rec.links.cw_hub, title: t('lec.cwHub'), desc: t('lec.cwHubNote') },
].filter(Boolean) as { url: string; title: string; desc?: string }[];

const piece = bright ? {
  model: stampAsset(`assets/models/gold/${cat}.glb`),
  poster: stampAsset(`assets/models/gold/${cat}.webp`),
  mark: stampAsset(`assets/marks/${cat}.webp`),
} : null;

---

<Base
  lang={lang}
  title={`${who} — ${rec.title.en}`}
  description={rec.description[lang]}
  segments={['lecture', rec.id]}
  bare={bright}
>
  <article class="lec" data-cat={cat}>
    {/* Outside the header, not inside it. .lec__head used to carry
      isolation:isolate — it had to, or the room behind it at z-index:-1 would
      have sunk through the page — and an isolated ancestor caps everything
      under it: this mark's z-index of 60 was being counted inside the header
      rather than against the page, so the first <figure class="vf"> further
      down the document, positioned and later in source order, painted straight
      over it. The room is outside the header now too, so the isolation has
      gone with it; the mark stays out here, where its 60 means what it says,
      exactly as on the prize pages. */}
  {bright && (
    <a class="gr__lock lec__lock" href={home(lang)} aria-label={t('nav.backHall')}>
      <span class="gr__lock-name">{t('site.tagline')}</span>
    </a>
  )}
  {/* And the laureate's name beside it, once the page has been scrolled far
      enough to take the real one off the top of the screen. A room in this
      museum is a person, and a person's page that has been read for two
      screens is a page with nothing on it saying whose it is.

      A second copy rather than the h1 itself, and out here rather than in the
      header, for the reason above: the header isolates, so a name pinned from
      inside it could never be counted against the mark. It is aria-hidden
      because the h1 it repeats is still in the document — a reader using a
      screen reader has been told whose page this is already, and does not
      need to be told again every time the page moves. */}
  {bright && <span class="lec__pin" aria-hidden="true">{who}</span>}
  {/* The same room as the hall and the prize pages. A laureate's page is the
      innermost room of the three, not a document that fell out of them.

      Outside the header and fixed, exactly as on the prize pages: the room is
      what the page is read in front of, not a picture at the top of it. Inside
      the header it could only be absolute, and an absolute room scrolls away
      with its box. */}
  {bright && (
    <div class="lec__room" aria-hidden="true">
      <picture>
        <source srcset={asset('media/bright-hall.webp')} type="image/webp" />
        <img src={asset('media/bright-hall.jpg')} alt="" width="1672" height="941"
             fetchpriority="high" decoding="async" />
      </picture>
    </div>
  )}
  {/* the same room again, over the page and masked to the band at the top of
      the window — see 'the band every page dissolves into' in bright.css */}
  {bright && (
    <div class="lec__room" data-roomtop aria-hidden="true">
      <picture>
        <source srcset={asset('media/bright-hall.webp')} type="image/webp" />
        <img src={asset('media/bright-hall.jpg')} alt="" width="1672" height="941"
             decoding="async" />
      </picture>
    </div>
  )}
  {/* Out of the band with the prize's own piece beside it: the eyebrow above
      the laureate's name was going white a finger's width into the page while
      the piece it stands beside stayed gold. See 'what a room is called does
      not dissolve' in bright.css. The header carries no ground of its own in
      daylight — see the rule below — so nothing but its type rises. */}
  <header class:list={['lec__head', bright && 'room-head']} data-fade>
      <div class="wrap lec__head-in">
        <div class="lec__crest" aria-hidden="true">
          {piece ? (
            <span class="bh__art">
              <model-viewer class="bh__mv" src={piece.model} alt="" poster={piece.poster}
                camera-orbit="35deg 98deg 1.55m" camera-target="0m 0m 0m"
                min-camera-orbit="auto auto 1.55m" max-camera-orbit="auto auto 1.55m"
                field-of-view="30deg" interaction-prompt="none" disable-zoom
                environment-image="neutral" exposure="1.35"
                shadow-intensity="0.55" shadow-softness="0.9" autoplay>
                <img class="bh__poster" slot="poster" src={piece.poster} alt="" width="640" height="1280" />
              </model-viewer>
              <span class="bh__face" aria-hidden="true">
                <img class="bh__mark" src={piece.mark} alt="" width="192" height="192" decoding="async" />
                <span class="bh__name">{catName(cat, lang)}</span>
                <span class="bh__name-en">{catName(cat, lang === 'zh' ? 'en' : 'zh')}</span>
              </span>
            </span>
          ) : <Sculpture cat={cat} size={110} id={`lec-${rec.id}`} />}
        </div>
        <div class="lec__id">
          <p class="eyebrow lec__prize">
            <a href={gallery(lang, cat)}>{t('lec.prize', { year: rec.prize.year, category: catPrize })}</a>
          </p>
          <h1 class="lec__who">{rec.laureate.en}</h1>
          {lang === 'zh' && <p class="gloss lec__who-zh">{rec.laureate.zh}</p>}
          <p class="lec__hook">{rec.hook[lang]}</p>
          <h2 class="lec__title">{rec.title.en}</h2>
          {lang === 'zh' && <p class="gloss lec__title-zh">{rec.title.zh}</p>}
          <dl class="lec__facts">
            <div><dt>{t('lec.date')}</dt><dd>{date}</dd></div>
            <div><dt>{t('lec.at')}</dt><dd>{host}</dd></div>
            <div><dt>{t('lec.affiliation')}</dt><dd>{rec.affiliation.institution}, {rec.affiliation.country}</dd></div>
            {series && <div><dt>{t('lec.series')}</dt><dd>{series}</dd></div>}
          </dl>
          <ul class="tags" role="list">
            {rec.topic_tags.map((tg) => <li>{tagName(tg, lang)}</li>)}
          </ul>
        </div>
      </div>
    </header>

    {/* the page's own ground, so the fixed room is wiped by the page rising
        over it rather than showing through the words — see .gr__sheet */}
    <div class="lec__sheet" data-fade>
    <span id="lec-body" class="gr__anchor"></span>
    <div class="wrap lec__body">
      <div class="lec__main stack" style="--gap:2.5rem">
        {/* 1. the on-ramp: guide video if it exists */}
        {rec.video.guide ? (
          <section aria-labelledby="h-guide">
            <h3 id="h-guide" class="lec__h">{t('lec.guide')}</h3>
            <VideoFacade id={rec.video.guide} title={`${t('lec.guide')} — ${who}`} kind="guide"
                         note={t('lec.guideNote')} playHint={t('lec.playHint')} eager />
          </section>
        ) : ntu ? null : (
          /* 「製作中，敬請期待」 is a promise about the programme's own 導讀
             films. Nothing was ever filmed for the NTU collection, so the
             line would be a promise the museum cannot keep. */
          <p class="lec__soon">{t('lec.guideSoon')}</p>
        )}

        {/* 2. why this matters */}
        <section class="lec__about">
          <p class="lec__lede">{rec.description[lang]}</p>
        </section>

        {/* 3. the lecture itself */}
        <section aria-labelledby="h-lec">
          <h3 id="h-lec" class="lec__h">{t('lec.lecture')}</h3>
          {rec.video.lecture ? (
            <VideoFacade id={rec.video.lecture} title={`${rec.title.en} — ${who}`} kind="lecture"
                         note={t('lec.lectureNote')} playHint={t('lec.playHint')} />
          ) : (
            <p class="lec__soon">{t('lec.noVideo')}</p>
          )}
          {rec.video.extra_sessions.length > 0 && (
            <div class="lec__sessions">
              <h4 class="lec__h4">{t('lec.session')}</h4>
              <div class="lec__row">
                {rec.video.extra_sessions.map((s) => (
                  <VideoFacade id={s.id} title={`${rec.title.en} — ${s.label}`} label={s.label}
                               playHint={t('lec.playHint')} />
                ))}
              </div>
            </div>
          )}
        </section>

        {/* 4. interviews */}
        {rec.interviews.length > 0 && (
          <section aria-labelledby="h-itv">
            <h3 id="h-itv" class="lec__h">{t('lec.interview')}</h3>
            <div class="lec__row">
              {rec.interviews.map((iv) => (
                <VideoFacade
                  id={iv.id}
                  title={`${who} — ${lang === 'zh' ? iv.source_zh : iv.source_en}`}
                  kind="interview"
                  label={lang === 'zh' ? iv.source_zh : iv.source_en}
                  playHint={t('lec.playHint')}
                />
              ))}
            </div>
          </section>
        )}
        <CompareBlock lang={lang} rec={rec} />
        {/* The note panel writes into the same store the learning area reads,
            and that chooser lists the programme's 31. A note saved here on a
            record it does not list would be a note the student could never
            find again. */}
        {!ntu && <StudyPanel lang={lang} rec={rec} />}
      </div>

      {/* 5. go deeper — a sidebar to this laureate's page, not a conclusion
          to it */}
      <aside class="lec__aside" aria-labelledby="h-deep">
        <h3 id="h-deep" class="lec__h">{t('lec.deeper')}</h3>
        <ul class="links" role="list">
          {/* The Nobel Lecture and the prize's own page for this laureate are
              the two entries that are theirs on nobelprize.org, so they share
              one rectangle rather than standing a gap apart with only the
              first of them marked. The rest of the list is elsewhere: NTU,
              the press, the museum's own. */}
          <li class="links__key">
            <ul class="links__in" role="list">
              {deeper.slice(0, 2).map((l) => (
                <li>
                  <ExtLink lang={lang} href={l.url}>{l.title}</ExtLink>
                  {l.desc && <span>{l.desc}</span>}
                </li>
              ))}
            </ul>
          </li>
          {deeper.slice(2).map((l) => (
            <li>
              <ExtLink lang={lang} href={l.url}>{l.title}</ExtLink>
              {l.desc && <span>{l.desc}</span>}
            </li>
          ))}
        </ul>
      </aside>

    </div>

    {next.length > 0 && (
      <section class="wrap lec__next" aria-labelledby="h-next">
        <h3 id="h-next" class="lec__h">{t('lec.next')}</h3>
        <ul class="grid" role="list">
          {next.map((r) => <li><LectureCard lang={lang} rec={r} /></li>)}
        </ul>
      </section>
    )}

    </div>
  </article>

  {bright && <ScrollCue lang={lang} href="#lec-body" />}
</Base>

<style>
  .lec__head {
    position: relative;
    border-block-end: 1px solid var(--line);
    background:
      radial-gradient(70% 100% at 12% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
      var(--bg-1);
    padding-block: clamp(2rem, 6vw, 3.5rem);
  }
  /* The room behind the page, cropped to the floor and the colonnade, and
     pinned: it is the same band the prize pages stand in and it takes their
     measurement — see --gr-room-h in bright.css. The header is taller than
     that band and always was; what is under it is the veil's own white, which
     the gradient below already reaches by its foot, so the join is invisible.
     `picture` has to be told it is a block of full height, or the image's
     100% resolves against an auto-height inline box, falls back to its own
     aspect ratio, and paints 941px of rotunda into a band meant to be a
     third of that. */
  .lec__room {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: -1;
    block-size: var(--gr-room-h);
    overflow: hidden;
    pointer-events: none;
  }
  .lec__room picture { display: block; block-size: 100%; }
  /* the ground the page is read on, over the pinned room */
  .lec__sheet { position: relative; background: var(--bg-0); }
  .lec__room img {
    inline-size: 100%; block-size: 100%;
    object-fit: cover; object-position: 50% 80%;
  }
  /* enough veil to read a page of prose over, which is the difference between
     this room and the two that only carry a title */
  .lec__room::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom,
      rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.88) 58%, var(--bg-0));
  }
  :global(html[data-theme='bright']) .lec__head {
    background: none;
    border-block-end: 0;
    padding-block: calc(clamp(2rem, 6vw, 3.5rem) + 2.4rem) clamp(2rem, 6vw, 3.5rem);
  }
  .lec__lock { inset-block-start: 0.62rem; }

  /* Beside the mark, on the mark's own line, at the size the mark's own name
     is set at. The reach is the museum's one figure for 'beside the mark' —
     the same expression the caught emblem uses on the four rooms that hang
     one, less the rail offset a fixed element does not have. It carries the
     white edge rather than a plate of its own: two plates side by side would
     read as two marks, and the museum has one. */
  .lec__pin {
    position: fixed;
    inset-block-start: 0.62rem;
    inset-inline-start: calc(var(--mark-x) + var(--lock-w, 10.9rem)
                             + var(--mark-over, 0px) + 0.55rem);
    /* above the mark's 60, which is the top of the ladder — see 'the band
       every page dissolves into' in bright.css */
    z-index: 61;
    /* As far as the bar's own keys and no further, measured — that row is five
       labels in one of two languages and folds into a column on a phone, so
       the room beside the mark is never the same number twice. Where the whole
       name will not go on one line it wraps rather than being cut: a name
       ending in an ellipsis names nobody, and the part that identifies anyone
       is the end of it. The block is at least the mark's own height and the
       lines are centred in it, so one line sits on the mark's line and two sit
       either side of it. */
    max-inline-size: var(--pin-max, 40vw);
    min-block-size: var(--lock-h);
    display: grid;
    align-content: center;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.24;
    color: var(--cream);
    text-shadow: var(--ink-edge);
    pointer-events: none;
    opacity: 0;
    translate: 0 -0.25rem;
    transition: opacity 0.35s var(--ease), translate 0.35s var(--ease);
  }
  .lec__pin[data-pinned] { opacity: 1; translate: none; }
  :global(html[data-motion='off']) .lec__pin { transition: none; }
  /* A phone has about ninety pixels beside the mark once the bar's keys have
     opened into their column, so the name is set a step smaller there and
     takes the two or three lines it needs. */
  @media (max-width: 48rem) {
    .lec__pin { font-size: var(--step--1); }
  }

  /* One name at a time. The small one arrives at the moment the big one's top
     edge reaches the top of the window — the owner's own cue — and until the
     head was lifted out of the band the big one was half dissolved by then, so
     the two never met. Now it is not, and two of the same name a finger apart
     read as a fault. So the head hands its name over. */
  .lec__who { transition: opacity 0.3s var(--ease); }
  .lec__who[data-handed] { opacity: 0; }
  :global(html[data-motion='off']) .lec__who { transition: none; }
  /* the prize's own piece, in the bright museum */
  .lec__crest .bh__art {
    inline-size: 7.5rem;
    block-size: 13.7rem;      /* the cage's ratio — see the note in HallBright */
    aspect-ratio: auto;
    max-inline-size: none;
  }
  .lec__head-in { display: grid; gap: 1.5rem; }
  @media (min-width: 52rem) { .lec__head-in { grid-template-columns: auto 1fr; gap: 2.5rem; align-items: start; } }
  .lec__crest { --sculpt-hi: #ffe9c2; --sculpt-lo: #6d451a; opacity: 0.9; }
  @media (max-width: 52rem) { .lec__crest { display: none; } }

  .lec__prize a { color: var(--accent); text-decoration: none; letter-spacing: 0.16em; }
  .lec__prize a:hover { text-decoration: underline; }
  .lec__who {
    font-family: var(--font-display);
    font-size: var(--step-3); color: var(--cream); margin-block-start: 0.35rem;
  }
  .lec__who-zh { margin-block-start: 0.1rem; }
  .lec__hook {
    font-family: var(--font-hook); font-size: var(--step-1);
    color: var(--accent); line-height: 1.55; margin-block-start: 0.9rem; max-inline-size: 34ch;
  }
  .lec__title { font-size: var(--step-1); color: var(--text); margin-block-start: 1.1rem; max-inline-size: 46ch; font-weight: 400; }
  .lec__title-zh { margin-block-start: 0.2rem; max-inline-size: 46ch; }

  .lec__facts { display: flex; flex-wrap: wrap; gap: 0 2.5rem; margin-block-start: 1.4rem; }
  .lec__facts dt { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-dim); }
  .lec__facts dd { margin: 0.1rem 0 0.7rem; font-size: var(--step--1); color: var(--text); }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.4rem 0 0; padding: 0; }
  .tags li {
    font-size: 0.7rem; letter-spacing: 0.06em; color: var(--muted);
    border: 1px solid var(--line); border-radius: var(--radius-control); padding: 0.14rem 0.7rem;
  }

  .lec__body { display: grid; gap: clamp(2rem, 5vw, 3.5rem); padding-block-start: clamp(2rem, 6vw, 3.5rem); }
  @media (min-width: 62rem) { .lec__body { grid-template-columns: minmax(0, 1fr) 17rem; align-items: start; } }

  .lec__h { font-size: var(--step-1); color: var(--cream); margin-block-end: 0.9rem; }
  .lec__h::before {
    content: ''; display: inline-block; inline-size: 0.5rem; block-size: 0.5rem;
    background: var(--accent); margin-inline-end: 0.6rem; vertical-align: 0.12em; border-radius: 1px;
  }
  .lec__h4 { font-size: var(--step-0); color: var(--muted); margin-block: 1.5rem 0.7rem; font-weight: 400; }

  .lec__lede { font-size: var(--step-1); line-height: 1.85; color: var(--text); max-inline-size: 54ch; }
  .lec__soon {
    font-size: var(--step--1); color: var(--muted-dim); border: 1px dashed var(--line);
    border-radius: var(--radius); padding: 1rem 1.2rem; max-inline-size: none;
  }

  .lec__row { display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }

  .lec__aside {
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); padding: 1.3rem 1.4rem;
  }
  .links { display: grid; gap: 1rem; padding: 0; margin: 0; }
  .links li { display: grid; gap: 0.15rem; }
  .links a { font-size: var(--step-0); text-decoration: none; border-block-end: 1px solid var(--line-hi); justify-self: start; }
  /* the original Nobel Lecture is required reading for the course, and the
     prize's own page for this laureate is the citation behind it, so the two
     lead the list together rather than sitting among the general references */
  .links__key {
    padding: .7rem .85rem; margin-block-end: .3rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  /* two entries in one rectangle, and the gap between the pair has to be
     larger than the gap between a title and its own line of description, or
     the four lines read as one entry of four */
  .links__in { display: grid; gap: .75rem; padding: 0; margin: 0; }
  .links__key a { color: var(--cream); border-block-end-color: color-mix(in srgb, var(--accent) 60%, transparent); }
  .links a:hover { border-block-end-color: currentColor; }
  .links span { font-size: var(--step--1); color: var(--muted-dim); line-height: 1.55; }

  .lec__next { margin-block-start: clamp(3rem, 8vw, 5rem); }
  .grid {
    display: grid; gap: clamp(0.9rem, 2vw, 1.5rem); margin-block-start: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
</style>


<script>
  import '../../vendor/model-viewer.min.js';
  import { dressPlinths } from '../scripts/plinth';
  import { measureMark } from '../scripts/mark';
  dressPlinths();

  /* The name arrives when the real one leaves: the cue is the h1's own top
     edge touching the top of the window, which is the moment the page stops
     saying whose it is. Nothing here animates the movement — the stylesheet
     interpolates it from one attribute, the way every other catch in this
     museum does.

     measureMark() is what puts --lock-w and --mark-over on <html>. The two
     other pages that place something beside the mark run it for themselves;
     a laureate's page has neither an emblem rail nor a sculpture, so it is
     the only reader here and has to ask. */
  const who = document.querySelector<HTMLElement>('.lec__who');
  const pin = document.querySelector<HTMLElement>('.lec__pin');
  const bar = document.querySelector<HTMLElement>('.topbar__nav');

  if (who && pin) {
    let queued = false;
    const test = () => {
      queued = false;
      /* How much room there is between the mark and the bar's keys. It is not
         a constant: the row is five labels in either of two languages, and on
         a phone it is folded until half a screen has gone by and then opens
         into a column that is wider than the key it folded behind. So it is
         read here rather than guessed, on the same frames the catch itself
         is decided on. */
      if (bar) {
        const room = bar.getBoundingClientRect().left
          - pin.getBoundingClientRect().left - 12;
        pin.style.setProperty('--pin-max', `${Math.max(0, Math.round(room))}px`);
      }
      const on = who.getBoundingClientRect().top <= 0;
      pin.toggleAttribute('data-pinned', on);
      /* and the head lets go of the name in the same movement */
      who.toggleAttribute('data-handed', on);
    };
    measureMark();
    test();
    addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(test);
    }, { passive: true });
    addEventListener('resize', () => { measureMark(); test(); });
    document.fonts?.ready.then(() => { measureMark(); test(); });
  }
</script>
