---
/**
 * HallGL.astro — the WebGL rotunda (style B).
 *
 * The canvas is decoration. Every gallery link is real markup underneath it,
 * so the hall works identically with WebGL blocked, JavaScript off, a screen
 * reader, or motion turned off — the canvas simply never appears.
 */
import Sculpture from './Sculpture.astro';
import StyleSwitch from './StyleSwitch.astro';
import MotionToggle from './MotionToggle.astro';
import { useT, type Lang } from '../i18n/ui';
import { gallery } from '../i18n/routing';
import { lectures, catName, catNameAlt, categoryList, introParts, INTRO, type CategoryKey } from '../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const ORDER: CategoryKey[] = categoryList().map((c) => c.key);
const counts = lectures.reduce<Record<string, number>>((a, l) => {
  a[l.prize.category] = (a[l.prize.category] ?? 0) + 1; return a;
}, {});
const cats = ORDER.map((key) => ({
  key, name: catName(key, lang), nameAlt: catNameAlt(key, lang),
  n: counts[key] ?? 0, href: gallery(lang, key),
}));
const [introA, introConj, introB] = introParts(lang);

const stills = lectures
  .filter((l) => l.video.guide || l.video.lecture)
  .slice(0, 11)
  .map((l) => `https://i.ytimg.com/vi/${l.video.guide ?? l.video.lecture}/mqdefault.jpg`);
---

<section class="hallgl" aria-labelledby="hall-title">
  <StyleSwitch lang={lang} current="gl" />
  <MotionToggle lang={lang} />
  <canvas
    class="hallgl__canvas"
    data-rotunda
    data-cats={JSON.stringify(cats.map((c) => ({ key: c.key, href: c.href, label: c.name })))}
    data-stills={JSON.stringify(stills)}
    aria-hidden="true"
  ></canvas>
  <div class="hallgl__scrim" aria-hidden="true"></div>
  <div class="hallgl__veil" data-veil aria-hidden="true"></div>

  <div class="masthead">
    <h1 id="hall-title" class="title">{t('site.tagline')}</h1>
    <p class="hint">{t('hall.hint')}</p>
  </div>

  <nav class="deck" aria-label={t('hall.enter')}>
    {cats.map((c) => (
      <a class="tile" href={c.href} data-cat={c.key}>
        <span class="tile__art" aria-hidden="true"><Sculpture cat={c.key} size={72} plinth={false} /></span>
        <span class="tile__name">{c.name}</span>
        <span class="tile__name-en">{c.nameAlt}</span>
        <span class="tile__n">{c.n > 0 ? t('hall.count', { n: c.n }) : t('hall.soon')}</span>
      </a>
    ))}
  </nav>

  <a class="intro" href={gallery(lang, INTRO)} data-cat={INTRO}>
    <span class="intro__medal" aria-hidden="true"><Sculpture cat={INTRO} size={72} plinth={false} /></span>
    <span class="intro__text">
      <span class="intro__eyebrow">{t('hall.nobelRoom')}</span>
      <span class="intro__title">{introA}<span class="conj">{introConj}</span>{introB}</span>
      <span class="intro__desc">{t('hall.introDesc')}</span>
    </span>
    <span class="intro__cta" aria-hidden="true">{t('hall.introCta')} →</span>
  </a>
</section>

<style>
  .hallgl {
    position: relative;
    min-block-size: min(100svh, 64rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    padding-block: max(clamp(1.5rem, 4vh, 3.5rem), 4.6rem) clamp(2.5rem, 6vh, 4.5rem);
    overflow: hidden;
    isolation: isolate;
    background: #0d0803;
  }
  .hallgl__canvas {
    position: absolute; inset: 0; z-index: -2;
    inline-size: 100%; block-size: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .hallgl__canvas[data-ready] { opacity: 1; }
  /* the scene gave up on a slow machine; the last frame stands as artwork */
  .hallgl__canvas[data-static] { opacity: 1; }
  /* the walk-in wash: the room brightens into the gallery's own colour */
  .hallgl__veil {
    position: absolute; inset: 0; z-index: 40; pointer-events: none;
    opacity: 0;
    background: radial-gradient(60% 60% at 50% 52%,
      color-mix(in srgb, var(--veil, #e0aa53) 92%, #fff) 0%,
      color-mix(in srgb, var(--veil, #e0aa53) 60%, #0b0703) 55%,
      #0b0703 100%);
    transition: opacity .42s ease-in;
  }
  .hallgl__veil[data-on] { opacity: 1; }

  .hallgl__scrim {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(72% 56% at 50% 34%, transparent 38%, rgba(9,6,3,.72) 100%),
      linear-gradient(to bottom, rgba(9,6,3,.62) 0 16%, transparent 34%, transparent 62%, rgba(9,6,3,.9) 100%);
  }

  .masthead { text-align: center; display: grid; justify-items: center; gap: .45rem; padding-inline: 1rem; }
  .title { font-size: var(--step-4); color: var(--cream); max-inline-size: 22ch; text-shadow: 0 2px 50px rgba(0,0,0,.85); }
  .hint { font-size: var(--step--1); color: var(--muted); letter-spacing: .18em; margin-block-start: .5rem; }

  /* the deck sits over the render — glass cards, so the room stays visible */
  .deck {
    display: grid; grid-template-columns: repeat(6, 1fr);
    gap: clamp(.4rem, 1vw, .9rem);
    inline-size: min(100% - 2rem, 78rem);
    margin: auto auto 0;
    align-self: end;
  }
  .tile {
    display: grid; justify-items: center; gap: .1rem;
    text-decoration: none; color: var(--text);
    padding: .45rem .4rem .55rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, #100a04 52%, transparent);
    backdrop-filter: blur(7px);
    transition: transform .4s var(--ease), border-color .4s, background .4s;
  }
  .tile:focus-visible {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--accent) 62%, transparent);
    background: color-mix(in srgb, #1d1309 78%, transparent);
  }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--accent) 62%, transparent);
      background: color-mix(in srgb, #1d1309 78%, transparent);
    }
  }
  .tile__art { inline-size: clamp(28px, 3.2vw, 38px); opacity: .8; }
  .tile__art :global(svg) { inline-size: 100%; block-size: auto; }
  .tile__name { font-family: var(--font-han-serif); font-size: var(--step-0); color: var(--cream); margin-block-start: .3rem; text-align: center; }
  /* the other language, set under the first */
  .tile__name-en {
    display: block; text-align: center;
    font-size: var(--step--2); letter-spacing: .06em;
    color: var(--muted); margin-block-start: .1rem;
  }
  .tile:hover .tile__name { color: var(--accent); }
  .tile__n { font-size: var(--step--1); color: var(--muted-dim); }

  .intro {
    display: flex; align-items: center; gap: clamp(.75rem, 2.5vw, 2rem);
    inline-size: min(100% - 2rem, 54rem);
    margin: clamp(1rem, 2.5vh, 1.75rem) auto 0;
    padding: .5rem clamp(1rem, 3vw, 1.9rem) .5rem .7rem;
    text-decoration: none; color: var(--text);
    border: 1px solid var(--line); border-radius: 999px;
    background: color-mix(in srgb, #140d06 72%, transparent);
    backdrop-filter: blur(8px);
    transition: border-color .4s, transform .4s, box-shadow .4s;
  }
  .intro:hover, .intro:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    transform: translateY(-2px); box-shadow: var(--shadow-lift);
  }
  .intro__medal { flex: none; inline-size: clamp(2.6rem, 5vw, 3.4rem); }
  .intro__medal :global(svg) { inline-size: 100%; block-size: auto; }
  .intro__text { display: grid; gap: .1rem; flex: 1 1 auto; min-inline-size: 0; }
  .intro__eyebrow { font-size: .66rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); }
  .intro__title { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); line-height: 1.3; }
  .intro__title .conj { font-size: .62em; opacity: .7; margin-inline: .18em; vertical-align: .08em; }
  .intro__desc { font-size: var(--step--1); color: var(--muted); line-height: 1.6; }
  .intro__cta { flex: none; font-size: var(--step--1); letter-spacing: .1em; color: var(--gold); transition: translate .35s; }
  .intro:hover .intro__cta { translate: .25rem 0; }

  @media (max-width: 62rem) {
    .deck { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 34rem) {
    .deck { grid-template-columns: repeat(2, 1fr); }
    .hallgl { min-block-size: 0; }
    .intro { border-radius: var(--radius); padding: 1rem; flex-wrap: wrap; }
    .intro__cta { inline-size: 100%; }
  }

  /* clear the style switcher and the motion toggle, which stack down the
     left on narrow screens */
  @media (max-width: 34rem) {
    .hallgl { padding-block-start: 8.7rem; }
  }
</style>

<script>
  import { createRotunda } from '../scripts/rotunda';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-rotunda]');
  if (canvas) {
    // never load the scene where it cannot pay for itself
    const tiny = matchMedia('(max-width: 34rem)').matches;
    const saveData = (navigator as any).connection?.saveData === true;
    const gl = (() => {
      try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; }
    })();

    if (gl && !tiny && !saveData) {
      const cats = JSON.parse(canvas.dataset.cats ?? '[]');
      const stills = JSON.parse(canvas.dataset.stills ?? '[]');
      const css = getComputedStyle(document.documentElement);
      const colored = cats.map((c: any) => ({
        ...c,
        color: css.getPropertyValue(`--c-${c.key}`).trim() || '#e0aa53',
      }));
      const scene = createRotunda({ canvas, cats: colored, stills });
      canvas.setAttribute('data-ready', '');
      (window as any).__rotunda = scene;   // handle for the screenshot harness

      // clicking a gallery flies the camera into it before the page changes
      const veil = document.querySelector<HTMLElement>('[data-veil]');
      document.querySelectorAll<HTMLAnchorElement>('.tile[data-cat]').forEach((a) => {
        a.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          const key = a.dataset.cat;
          if (!key) return;
          e.preventDefault();
          veil?.style.setProperty('--veil', getComputedStyle(a).getPropertyValue('--accent'));
          let gone = false;
          const go = () => { if (!gone) { gone = true; location.href = a.href; } };
          if (canvas.hasAttribute('data-static')) { go(); return; }   // scene gave up; just navigate
          scene.walkInto(key, () => {
            veil?.setAttribute('data-on', '');
            setTimeout(go, 420);
          });
          // if the GPU is struggling, the flight must never hold the visitor here
          setTimeout(() => veil?.setAttribute('data-on', ''), 700);
          setTimeout(go, 1800);
        });
      });
    }
  }
</script>
