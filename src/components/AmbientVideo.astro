---
/**
 * AmbientVideo.astro — the drifting light-and-ember loop behind the hall.
 *
 * 12 seconds, seamless (every motion period divides the clip length). It is
 * pure decoration: muted, inert, and replaced by its own poster frame under
 * reduced-motion or Save-Data, where the video never downloads.
 */
import { asset } from '../i18n/routing';
interface Props { opacity?: number }
const { opacity = 0.55 } = Astro.props;
---
<div class="amb" style={`--amb-o:${opacity}`} aria-hidden="true">
  <img class="amb__poster" src={asset('media/ambient-poster.jpg')} alt="" width="640" height="360" />
  <video class="amb__vid" data-ambient muted loop playsinline preload="none"
         poster={asset('media/ambient-poster.jpg')}>
    <source data-src={asset('media/ambient.webm')} type="video/webm" />
    <source data-src={asset('media/ambient.mp4')} type="video/mp4" />
  </video>
</div>

<style>
  .amb { position: absolute; inset: 0; z-index: -3; overflow: hidden; pointer-events: none; }
  .amb__poster, .amb__vid {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%;
    object-fit: cover;
    opacity: var(--amb-o);
  }
  .amb__vid { opacity: 0; transition: opacity 1.4s ease; }
  .amb__vid[data-on] { opacity: var(--amb-o); }
  .amb__vid[data-on] + .amb__poster,
  .amb:has(.amb__vid[data-on]) .amb__poster { opacity: 0; transition: opacity 1.4s ease; }
</style>

<script>
  import { motionOn } from '../scripts/motion';

  const v = document.querySelector<HTMLVideoElement>('[data-ambient]');
  const saveData = (navigator as any).connection?.saveData === true;

  function enable() {
    if (!v || saveData || v.dataset.wired) return;
    v.dataset.wired = '1';
    // sources are inert until we opt in, so the poster alone is all that loads
    v.querySelectorAll('source').forEach((s) => {
      const u = s.getAttribute('data-src');
      if (u) s.setAttribute('src', u);
    });
    v.load();
    // the loop is rendered fast so it compresses well; slowed here so the
    // embers drift rather than race
    v.playbackRate = 0.4;
    const play = () => v.play().then(() => v.setAttribute('data-on', '')).catch(() => {});
    if (v.readyState >= 2) play();
    else v.addEventListener('canplay', play, { once: true });
    // some profiles refuse autoplay even when muted; a first gesture recovers it
    addEventListener('pointerdown', play, { once: true });
    document.addEventListener('visibilitychange', () => (document.hidden ? v.pause() : play()));
  }

  function sync() {
    if (!v) return;
    if (motionOn()) enable();
    else { v.pause(); v.removeAttribute('data-on'); }
  }
  sync();
  addEventListener('motionpref', sync);
</script>
