---
/**
 * VideoCard.astro — one video in the browse list.
 *
 * Cards link to the lecture page, which is where the video is actually
 * embedded and where its context lives. A record not tied to a laureate has
 * no lecture page, so that one card goes to YouTube instead.
 */
import { useT, type Lang } from '../i18n/ui';
import { lecture as lectureUrl } from '../i18n/routing';
import { localDate, type VideoItem, catPrizeName } from '../data/catalog';
import { still } from '../data/stills';

interface Props { lang: Lang; v: VideoItem }
const { lang, v } = Astro.props;
const t = useT(lang);

const KIND_LABEL = {
  guide: t('browse.kindGuide'),
  lecture: t('browse.kindLecture'),
  record: t('browse.kindRecord'),
}[v.kind];

/* The picture that stands for this recording, in the museum's own order: a
   frame cut out of it where one was needed, then the best of the four
   YouTube samples where the laureate was recognised in one, then the
   uploader's. See src/data/stills.ts. */
const { src: poster } = still(v.yt);
const href = v.lecture
  ? lectureUrl(lang, v.lecture.id)
  : `https://www.youtube.com/watch?v=${v.yt}`;
const external = !v.lecture;
const source = lang === 'zh' ? v.sourceZh : v.sourceEn;
/* What stands under the name. For a lecture that is its title; for a record
   tied to nobody's page it is what that person is, which the catalogue has
   carried in `role_zh` / `role_en` since the record was seeded. It used to be
   one person's job title written into this file, which meant every future
   record would have printed it — and with the NTU collection arriving that
   would have put 「世界和平基金會主席」 under four Nobel laureates. */
const sub = v.lecture
  ? (v.lecture.title[lang === 'zh' ? 'zh' : 'en'] ?? v.lecture.title.en)
  : (lang === 'zh' ? v.roleZh : v.roleEn) ?? '';
/* The series a recording was given in, where it belongs to the NTU collection
   rather than to 臺灣橋樑計畫 — the card's own way of saying which of the
   museum's two collections it came out of. */
const seriesLine = lang === 'zh' ? v.seriesZh : v.seriesEn;
---

<a
  class="vc"
  href={href}
  data-cat={v.category ?? 'nobel'}
  data-kind={v.kind}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span class="vc__media">
    <img src={poster} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="vc__scrim"></span>
    <span class="vc__kind">{KIND_LABEL}</span>
    {v.sessionLabel && <span class="vc__session">{v.sessionLabel}</span>}
    <span class="vc__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="13" height="13"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
    </span>
  </span>

  <span class="vc__body">
    {v.lecture && (
      <span class="vc__prize">
        {t('lec.prize', { year: v.lecture.prize.year, category: catPrizeName(v.lecture.prize.category, lang) })}
      </span>
    )}
    {source && <span class="vc__prize vc__prize--src">{source}</span>}
    <span class="vc__who">{v.personEn}</span>
    {lang === 'zh' && <span class="vc__who-zh gloss">{v.personZh}</span>}
    <span class="vc__sub">{sub}</span>
    <span class="vc__meta">
      {localDate(v.date, lang)}
      {seriesLine && <span class="vc__series"> · {seriesLine}</span>}
      {external && <span class="vc__ext"> · {t('browse.watchOn')} ↗</span>}
    </span>
  </span>
</a>

<style>
  /* the collection a film came out of, set in the meta line beside its date */
  .vc__series { color: var(--muted-dim); }

  .vc {
    display: grid; grid-template-rows: auto 1fr;
    text-decoration: none; color: var(--text);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); overflow: hidden; block-size: 100%;
    transition: border-color .35s var(--ease), transform .35s var(--ease),
                box-shadow .35s var(--ease), background .35s var(--ease);
  }
  .vc:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--surface-hi);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }

  .vc__media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-2); }
  .vc__media img {
    inline-size: 100%; block-size: 100%; object-fit: cover;
    filter: saturate(.85) contrast(1.02) brightness(.82);
    transition: transform .7s var(--ease), filter .5s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .vc:hover {
      border-color: color-mix(in srgb, var(--accent) 55%, transparent);
      background: var(--surface-hi);
      transform: translateY(-3px);
      box-shadow: var(--shadow-lift);
    }
    .vc:hover .vc__media img { transform: scale(1.055); filter: saturate(1) brightness(.95); }
  }
  .vc__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(18,12,6,.86), transparent 62%); }

  /* a lecture given twice is two rows; this says which sitting */
  .vc__session {
    position: absolute; inset-block-start: 0.55rem; inset-inline-end: 0.55rem;
    font-size: 0.62rem; letter-spacing: 0.06em;
    padding: 0.15rem 0.5rem; border-radius: 999px;
    background: rgba(20, 18, 16, 0.62); color: #fff;
  }
  .vc__kind {
    position: absolute; inset-block-start: .6rem; inset-inline-start: .6rem;
    font-size: .66rem; letter-spacing: .12em; font-weight: 500;
    color: var(--on-accent); background: var(--accent-block); border-radius: 2px;
    padding: .16rem .55rem;
  }
  /* the three types are told apart by colour as well as by label */
  .vc[data-kind='guide']   .vc__kind { background: var(--kind-guide); }
  .vc[data-kind='lecture'] .vc__kind { background: var(--kind-lecture); }
  .vc[data-kind='record']  .vc__kind { background: var(--kind-record); }

  .vc__play {
    position: absolute; inset-block-end: .55rem; inset-inline-end: .6rem;
    display: inline-flex; align-items: center;
    color: var(--cream); background: rgba(18,12,6,.66);
    border: 1px solid var(--line); border-radius: var(--radius-control); padding: .16rem .4rem;
  }

  .vc__body { display: grid; gap: .16rem; padding: .9rem 1rem 1.05rem; align-content: start; }
  .vc__prize { font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .vc__prize--src { color: var(--muted); letter-spacing: .08em; text-transform: none; }
  .vc__who { font-family: var(--font-display); font-size: var(--step-1); color: var(--cream); line-height: 1.3; margin-block-start: .2rem; }
  .vc__who-zh { display: block; margin-block-start: -.1rem; }
  .vc__sub {
    margin-block-start: .4rem; font-size: var(--step--1); color: var(--muted); line-height: 1.6;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .vc__meta { margin-block-start: .5rem; font-size: var(--step--1); color: var(--muted-dim); }
  .vc__ext { color: var(--accent); }
</style>
