---
/**
 * Explore.astro — 延伸探索, the section a room ends on.
 *
 * Every room in this museum eventually points outward: the prize pages to the
 * Nobel Foundation's own pages for that prize, the video index to the prize
 * itself. That pointing used to happen halfway up the prize pages, in a strip
 * of buttons wedged under the statistics and titled 延伸材料 — a row of keys
 * at the point where the reader had not yet reached the lectures, which is the
 * one place on the page they were least likely to want it.
 *
 * So it is a section at the foot instead, and the links are cards rather than
 * keys: a card can carry the line of description each of these has, and a
 * reader who has come this far is choosing where to go next rather than
 * operating a control. Same links, same descriptions, same hosts — the whole
 * change is where they sit and what shape they are.
 *
 * The laureate pages already end this way, in their own aside; this is that
 * same idea given to the rooms that had nothing at the bottom.
 */
import { useT, type Lang } from '../i18n/ui';

/** one card: where it goes, what it is called, and a line about it */
export interface ExploreItem {
  url: string;
  title: string;
  desc?: string;
}

interface Props {
  lang: Lang;
  items: ExploreItem[];
  note?: string;
  /** the introduction room is entirely about the prize; a heading saying so
      again is a heading saying nothing */
  heading?: boolean;
  /** wrap the section in the page's own gutter (off where a page supplies it) */
  wrap?: boolean;
  /**
   * 'cards' — four tiles across, for a room whose whole page this is.
   * 'panel' — the rail's own look, for a page that ends on it: one framed
   *   block, the same border, ground and list the sidebar uses, laid out in
   *   columns because at the foot of a page there is a page's width to use.
   */
  variant?: 'cards' | 'panel';
}
const { lang, items, note, heading = true, wrap = true, variant = 'cards' } = Astro.props;
const t = useT(lang);
const Wrap = wrap ? 'div' : Fragment;
---

<section class="xp" aria-labelledby={heading ? 'xp-h' : undefined}
         aria-label={heading ? undefined : t('explore.title')}
         data-bare={heading ? undefined : ''}>
  <Wrap class={wrap ? 'wrap' : undefined}>
    {heading && <h2 id="xp-h" class="xp__h">{t('explore.title')}</h2>}
    {note && <p class="xp__note">{note}</p>}
    {variant === 'panel' ? (
      <div class="xp__panel">
        <ul class="xp__links" role="list">
          {items.map((l, i) => (
            <li class:list={[i === 0 && 'xp__key']}>
              <a href={l.url} target="_blank" rel="noopener noreferrer">{l.title}
                <span class="xp__ext" aria-hidden="true"> ↗</span>
                <span class="visually-hidden">{t('a11y.newTab')}</span>
              </a>
              {l.desc && <span class="xp__d">{l.desc}</span>}
            </li>
          ))}
        </ul>
      </div>
    ) : (
    <ul class="cards" role="list">
      {items.map((l) => (
        <li>
          <a href={l.url} target="_blank" rel="noopener noreferrer">
            <span class="cards__t">{l.title}</span>
            {l.desc && <span class="cards__d">{l.desc}</span>}
            <span class="cards__host">{new URL(l.url).hostname.replace(/^www\./, '')} ↗</span>
            <span class="visually-hidden">{t('a11y.newTab')}</span>
          </a>
        </li>
      ))}
    </ul>
    )}
  </Wrap>
</section>

<style>
  .xp {
    border-block-start: 1px solid var(--line);
    margin-block-start: clamp(2.5rem, 7vw, 4.5rem);
    padding-block: clamp(1.8rem, 5vw, 2.8rem) clamp(2rem, 5vw, 3rem);
  }
  /* headingless — the introduction room is about the prize from its title
     down, so a band saying '延伸探索' over four cards about the prize is a
     label on a label */
  .xp[data-bare] { border-block-start: 0; margin-block-start: 0; padding-block-start: 0; }
  .xp__h { font-size: var(--step-2); color: var(--cream); }
  .xp__h::after {
    content: ''; display: block; inline-size: 3rem;
    border-block-start: 1px solid var(--accent); margin-block-start: 0.6rem; opacity: 0.7;
  }
  .xp__note {
    margin-block-start: 0.9rem;
    font-size: var(--step--1); color: var(--muted); line-height: 1.7;
    max-inline-size: 56ch;
  }
  /* The card is .cards, the same class the introduction room's four wear, so
     the bright museum's material for these — borderless, champagne at the
     foot — reaches them without being written twice. See 'the introduction
     room's four cards' in bright.css. */
  .cards {
    display: grid; gap: 0.9rem; padding: 0; margin-block-start: 1.4rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .cards a {
    display: grid; gap: 0.3rem; block-size: 100%; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.1rem 1.25rem 0.95rem;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .cards a:hover, .cards a:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: var(--surface-hi); transform: translateY(-2px);
  }
  .cards__t { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); line-height: 1.35; }
  .cards__d { font-size: var(--step--1); color: var(--muted); line-height: 1.65; }
  .cards__host {
    margin-block-start: 0.45rem; font-size: 0.66rem; letter-spacing: 0.08em;
    color: var(--muted-dim); font-family: var(--font-body);
  }
  .cards a:hover .cards__host { color: var(--accent); }

  /* ---------- the panel: the rail, laid out sideways ----------
     Same frame, same ground, same list and same highlighted first entry as
     the sidebar on a prize room and a laureate's page — see .gh__aside in
     GalleryPage. What differs is only the shape of the space it is in: a
     sidebar is 17rem and stacks, and the foot of a page is the page's width,
     so the list runs in columns instead. */
  .xp__panel {
    margin-block-start: 1.4rem;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface);
    padding: 1.4rem 1.5rem 1.5rem;
  }
  .xp__links {
    display: grid; gap: 1.1rem 1.8rem; padding: 0; margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .xp__links li { display: grid; gap: 0.15rem; align-content: start; }
  .xp__links a {
    font-size: var(--step-0); text-decoration: none;
    border-block-end: 1px solid var(--line-hi); justify-self: start;
  }
  .xp__links a:hover { border-block-end-color: currentColor; }
  .xp__ext { opacity: 0.6; }
  .xp__d { font-size: var(--step--1); color: var(--muted-dim); line-height: 1.55; }
  /* the first entry is the one the room would send you to if it could only
     send you to one; the sidebar marks it the same way */
  .xp__key {
    padding: .7rem .85rem; margin-block-end: .3rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .xp__key a { color: var(--cream); border-block-end-color: color-mix(in srgb, var(--accent) 60%, transparent); }
</style>
