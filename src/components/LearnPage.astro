---
/**
 * LearnPage.astro — the museum's learning area.
 *
 * This is a MUSEUM feature, for anyone who wants to study the collection
 * seriously: a way in, a way to keep notes, a way to compare the two versions
 * of a laureate's talk.
 *
 * One NTU course, 走進諾貝爾 (LibEdu1140), is built around this material and
 * its requirements are described in a subordinate section near the foot of
 * the page. That section must stay subordinate — the museum is not a course
 * tool, and a visitor who is not taking the course should never feel they
 * have wandered into someone's classroom.
 */
import Base from '../layouts/Base.astro';
import ScrollCue from './ScrollCue.astro';
import ExtLink from './ExtLink.astro';
import RoomBack from './RoomBack.astro';
import PageEmblem from './PageEmblem.astro';
import StudyDesk from './StudyDesk.astro';
import { useT, type Lang } from '../i18n/ui';
import { browse } from '../i18n/routing';
import { lectures, totalSittings } from '../data/catalog';

/* the museum's own room behind this page too — see RoomBack */
const bright = process.env.THEME === 'bright';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const zh = lang === 'zh';

const SYLLABUS = 'https://nol.ntu.edu.tw/nol/coursesearch/print_table.php?course_id=H01%2014500&class=&dpt_code=0000&ser_no=57608&semester=115-1&lang=CH';
const ADD_FORM = 'https://forms.gle/hfiaP1MbtQXmryir6';
const NOBEL = 'https://www.nobelprize.org/';
const CGE = 'https://cge.ntu.edu.tw/cl_n_203079.html';

const facts = [
  [zh ? '課號' : 'Course code', 'LibEdu1140 · H01 14500'],
  [zh ? '學期' : 'Semester', zh ? '115-1（2 學分）' : '115-1 (2 credits)'],
  [zh ? '時間' : 'Time', zh ? '星期四 9,10 節（16:30–18:20）' : 'Thu periods 9–10 (16:30–18:20)'],
  [zh ? '地點' : 'Room', zh ? '博雅 201' : 'Boya 201'],
  [zh ? '授課教師' : 'Teacher', zh ? '吳俊輝' : 'Jiun-Huei Proty Wu'],
];

const marks = [
  { pct: 50, zh: '出席', en: 'Attendance',
    zhN: '2 場校內演講必到，缺席任一場即不及格；其他課堂每缺一堂扣 10 分。校外場次每場加 5 分，最多加 10 分。',
    enN: 'Both campus lectures are compulsory; missing either is a fail. Other sessions cost 10 points each. Outside sessions add 5 points each, up to 10.' },
  { pct: 20, zh: '小組報告', en: 'Group report',
    zhN: '演講前後的口頭報告。', enN: 'Oral reports before and after each lecture.' },
  { pct: 10, zh: '提問競賽', en: 'Question competition',
    zhN: '演講前提出有深度、有邏輯、有原創性的問題，由專家評分。遲交第一天扣 3 分、第二天 6 分、第三天 9 分。',
    enN: 'Submit a deep, logical, original question before the lecture; judged by experts. Late: −3, −6, −9 on days one to three.' },
  { pct: 10, zh: '影音觀後個人筆記', en: 'Viewing notes',
    zhN: '自選 6 場臺灣橋樑計畫影音，連同其原版 Nobel Lecture 一併觀看，每場繳交筆記（摘要／反思／延伸問題）。遲交扣分同上。',
    enN: 'Choose 6 Taiwan Bridges videos, watch each with its original Nobel Lecture, and submit a note for each (summary / reflection / question). Same late penalty.' },
  { pct: 10, zh: '期末個人報告', en: 'Final report',
    zhN: '第 17 週週一 09:00 前以 Google 表單繳交，逾時零分。',
    enN: 'Due 09:00 Monday of week 17 via Google Form. Late means zero.' },
];

/* ---- the 1+3 ----
 * Three stages, and a step before them: choosing what to watch is numbered 0
 * because it happens once, not once per lecture.
 */
const cycle = [
  { n: '0', k: '選擇演講', e: 'Choose a lecture',
    zh: '從導讀影片開始，或直接瀏覽全部影片，依獎項、主題或年份挑一場。',
    en: 'Start with a guide video, or browse the whole collection and choose by prize, topic or year.',
    links: [
      { href: browse(lang) + '?kind=guide', zh: '從導讀影片開始', en: 'Start with a guide video',
        zhD: '一支約 90 秒，講座內容的概覽。', enD: 'About 90 seconds each: an overview of what the lecture covers.' },
      { href: browse(lang), zh: '瀏覽所有影片', en: 'Browse every video',
        zhD: `${totalSittings()} 場演講，含導讀、講座與專訪，可依獎項與主題篩選。`,
        enD: `${totalSittings()} sittings — guides, lectures and interviews, filtered by prize and topic.` },
    ] },
  { n: '1', k: '準備', e: 'Prepare',
    zh: '導讀影片、原版 Nobel Lecture、官方得獎理由，以及一個帶著走的問題。不懂的名詞先上網查一查，帶著背景進場，聽到的會完全不同。',
    en: 'The guide video, the original Nobel Lecture, the official citation, and a question to carry in. Look up whatever you do not know first: an hour of background changes what the fifty minutes is worth.' },
  { n: '2', k: '參與', e: 'Attend',
    zh: '', en: '',
    ways: [
      { k: 'attendLive' }, { k: 'attendOnline' },
    ] },
  { n: '3', k: '反思', e: 'Reflect',
    zh: '論點摘要、個人反思，以及至少一個延伸問題。',
    en: 'A summary of the argument, a personal response, and at least one further question.' },
];
---

<Base lang={lang} title={t('learn.title')} description={t('learn.blurb')} segments={['learn']} bare={bright}>
  {bright && <RoomBack lang={lang} room="learn-hall" />}
  {bright && <PageEmblem src="assets/ui/learn-emblem.webp" w={710} h={720} outside />}
  <div class="wrap course" data-fade>
    {/* The emblem struck for this area, on the same rail the about page's
        medal hangs from and caught the same way — see PageEmblem, and
        --emb-h in bright.css, where the size the three of them share lives. */}

    <header class:list={['course__head', bright && 'hall-head']}>
      {/* no eyebrow: the museum's name over a page inside the museum is the
          name said twice */}
      <h1>{t('learn.title')}</h1>
      {/* the three stages, said once in gold at the door of the room they
          belong to — the sub-title the owner asked for */}
      <p class="course__stages">{t('learn.stages')}</p>
    </header>
    <p class="course__blurb hall-note"><span>{t('learn.blurb')}</span></p>

    <section class="course__sec" aria-labelledby="cy">
      <h2 id="cy">{t('learn.cycleTitle')}</h2>
      {/* Two thirds of the column, at the owner's word. It is the one long
          paragraph on the page and at full width it read as body copy for a
          section that is really four plates. */}
      <p class="course__note course__note--two-thirds">{t('learn.cycleNote')}</p>
      <ol class="cycle" role="list">
        {cycle.map((c) => (
          <li data-step={c.n}>
            <span class="cycle__n">{c.n}</span>
            <span class="cycle__k">{zh ? c.k : c.e}</span>
            {(zh ? c.zh : c.en) && <span class="cycle__t">{zh ? c.zh : c.en}</span>}
            {c.ways && (
              <>
                <span class="cycle__t">{t('learn.attendSplit')}</span>
                <ul class="ways" role="list">
                  {c.ways.map((w) => (
                    <li>
                      <b>{t(`learn.${w.k}` as any)}</b>
                      <span>{t(`learn.${w.k}D` as any)}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {c.links && (
              <ul class="cycle__go" role="list">
                {c.links.map((l) => (
                  <li>
                    <a href={l.href}>{zh ? l.zh : l.en}</a>
                    <span>{zh ? l.zhD : l.enD}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>

    {/* The record itself, not a door to it: it is the only thing in the museum
        that keeps anything, and it belongs in the room where the three stages
        that produce it are set out. See StudyDesk. */}
    <section class="course__sec" id="record" aria-labelledby="tools">
      <h2 id="tools">{t('learn.toolProgress')}</h2>
      <p class="course__note">{t('learn.toolsNote')}</p>
      <StudyDesk lang={lang} />
    </section>

    <section class="course__sec" aria-labelledby="rd">
      <h2 id="rd">{t('learn.readTitle')}</h2>
      <ul class="links" role="list">
        <li>
          <ExtLink lang={lang} href={NOBEL}>nobelprize.org</ExtLink>
          <span>{t('learn.readNobel')}</span>
        </li>
        <li>
          <ExtLink lang={lang} href={CGE}>{t('lec.ntuCge')}</ExtLink>
          <span>{t('lec.ntuCgeNote')}</span>
        </li>
      </ul>
    </section>

    <!-- Subordinate by design: one course happens to use this collection. -->
    <aside class="forcourse" aria-labelledby="fc">
      <h2 id="fc">{t('learn.courseTitle')}</h2>
      <p class="forcourse__lede">{t('learn.courseLede')}</p>
      <dl class="course__facts">
        {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
      <details class="forcourse__more">
        <summary>{t('learn.courseMarks')}</summary>
        <ul class="marks" role="list">
          {marks.map((m) => (
            <li>
              <span class="marks__pct">{m.pct}%</span>
              <span class="marks__body">
                <b>{zh ? m.zh : m.en}</b>
                <span>{zh ? m.zhN : m.enN}</span>
              </span>
            </li>
          ))}
        </ul>
        <p class="course__note">{t('learn.marksNote')}</p>
      </details>
      <p class="course__links">
        <ExtLink lang={lang} href={SYLLABUS}>{t('learn.syllabus')}</ExtLink>
        <ExtLink lang={lang} href={ADD_FORM}>{t('learn.addCode')}</ExtLink>
      </p>
    </aside>
  </div>

  {bright && <ScrollCue lang={lang} href="#cy" />}
</Base>

<style>
  :global(html[data-theme='bright']) .course { padding-block-start: 3.4rem; }
  .course { padding-block: clamp(2rem, 5vw, 3.5rem); max-inline-size: 62rem; }
  .course__head h1 { font-size: var(--step-3); color: var(--cream); margin-block-start: .3rem; }
  /* the emblem, the centring and the indent are .hall-head's, in bright.css */
  .course__stages {
    margin: 0;
    font-size: var(--step-0);
    letter-spacing: 0.16em;
    text-indent: 0.16em;
    color: var(--gold);
  }

  /* ---------- the step before the three ----------
     Step 0 is a door rather than a stage, so it says so: the two ways into the
     collection are inside it, listed, and the plate is marked at its head. */
  .cycle > li[data-step='0'] { border-color: color-mix(in srgb, var(--gold) 40%, var(--line)); }
  /* --gold-deep, not --gold-orn. The ornament gold is a rule and a mark
     colour, not a fill: white on it measures 3.24:1, which is where this
     museum's own contrast sweep found the worst ground in the building. The
     deep gold takes white at better than 7:1 and still reads as a different
     mark from the three steps after it. */
  .cycle > li[data-step='0'] .cycle__n { background: var(--gold-deep); }
  .cycle__go, .ways { list-style: none; margin: .55rem 0 0; padding: 0; display: grid; gap: .5rem; }
  .cycle__go li, .ways li { display: grid; gap: .1rem; }
  .cycle__go a {
    font-size: var(--step--1); color: var(--accent); text-decoration: none;
    justify-self: start; border-block-end: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .cycle__go a:hover { color: var(--gold-bright); border-block-end-color: var(--gold); }
  .cycle__go span, .ways span { font-size: var(--step--2); color: var(--muted-dim); line-height: 1.6; }
  .ways b { font-weight: 500; font-size: var(--step--1); color: var(--cream); }
  .ways li {
    padding-inline-start: .65rem;
    border-inline-start: 2px solid color-mix(in srgb, var(--gold) 45%, transparent);
  }
  .course__blurb { font-size: var(--step-1); line-height: 1.9; color: var(--text); margin-block-start: 1rem; max-inline-size: 54ch; }
  .course__facts { display: flex; flex-wrap: wrap; gap: 0 2.4rem; margin-block-start: 1.4rem; }
  .course__facts dt { font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted-dim); }
  .course__facts dd { margin: .1rem 0 .7rem; font-size: var(--step--1); color: var(--text); }
  .course__links { display: flex; gap: 1.4rem; flex-wrap: wrap; margin-block-start: .4rem; }

  .course__sec { margin-block-start: clamp(2.2rem, 5vw, 3.2rem); }
  .course__sec h2 {
    font-size: var(--step-2); color: var(--cream);
    padding-block-start: 1.4rem; border-block-start: 1px solid var(--line);
  }
  .course__note { font-size: var(--step--1); color: var(--muted); margin-block-start: .8rem; }
  .course__note--two-thirds { max-inline-size: 66%; }
  @media (max-width: 48rem) { .course__note--two-thirds { max-inline-size: none; } }

  .cycle { display: grid; gap: .8rem; padding: 0; margin-block-start: 1.2rem; }
  @media (min-width: 52rem) { .cycle { grid-template-columns: repeat(4, 1fr); } }
  /* > li, not li: the two ways of attending and the two doors into the
     collection are lists inside a stage, and a bare descendant selector gave
     every one of them the stage's own plate — four plates inside four
     plates. */
  .cycle > li {
    display: grid; gap: .3rem; align-content: start;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); padding: 1rem 1.1rem;
  }
  .cycle__n {
    inline-size: 26px; block-size: 26px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--gold); color: var(--bg-0); font-size: .8rem;
  }
  .cycle__k { font-family: var(--font-han-serif); font-size: var(--step-1); color: var(--cream); }
  .cycle__t { font-size: var(--step--1); color: var(--muted); line-height: 1.7; }

  .marks { display: grid; gap: .7rem; padding: 0; margin-block-start: 1.2rem; }
  .marks li { display: flex; gap: 1rem; align-items: baseline; }
  .marks__pct {
    flex: none; inline-size: 3.2rem; text-align: end;
    font-family: var(--font-display); font-size: var(--step-2); color: var(--gold);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .marks__body { display: grid; gap: .15rem; }
  .marks__body b { font-weight: 500; color: var(--cream); font-size: var(--step-0); }
  .marks__body span { font-size: var(--step--1); color: var(--muted); line-height: 1.7; }

  .links { display: grid; gap: 1rem; padding: 0; margin-block-start: 1.2rem; }
  .links li { display: grid; gap: .15rem; }
  .links :global(a) { font-size: var(--step-0); text-decoration: none; border-block-end: 1px solid var(--line-hi); justify-self: start; }
  .links span { font-size: var(--step--1); color: var(--muted-dim); line-height: 1.6; }

  /* deliberately quieter than everything above: this is a footnote about one
     course, not the purpose of the page */
  .forcourse {
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    border: 1px solid var(--line); border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-1) 70%, transparent);
    padding: 1.2rem 1.3rem 1.1rem;
  }
  .forcourse h2 {
    font-size: var(--step-1); color: var(--muted); border: 0; padding: 0;
    font-family: var(--font-han-serif);
  }
  .forcourse__lede { font-size: var(--step--1); color: var(--muted); line-height: 1.8; margin-block-start: .5rem; max-inline-size: 60ch; }
  .forcourse .course__facts { margin-block-start: 1rem; }
  .forcourse__more { margin-block-start: .4rem; }
  .forcourse__more summary {
    cursor: pointer; font-size: var(--step--1); color: var(--gold);
    list-style: none;
  }
  .forcourse__more summary::-webkit-details-marker { display: none; }
  .forcourse__more summary::before { content: '▸'; margin-inline-end: .45rem; transition: rotate .2s; display: inline-block; }
  .forcourse__more[open] summary::before { rotate: 90deg; }
  .forcourse .marks { margin-block-start: 1rem; }
</style>
