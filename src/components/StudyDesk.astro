---
/**
 * StudyDesk.astro — everything the visitor has written, in one place.
 *
 * A section of 學習專區, not a page of its own: it is the third of the
 * learning area's tools and the only one that keeps anything, so it stands
 * where the three stages that produced these notes are set out.
 *
 * Reads only from localStorage, so it ships as an empty shell and is filled
 * in by script. That also means it is correct for a visitor who is not taking
 * the course: they simply see the empty state.
 */
import { useT, type Lang } from '../i18n/ui';
import { path } from '../i18n/routing';
import { allLectures, categories, localDate, seriesName } from '../data/catalog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

/** the script needs id → title and id → url without refetching the catalogue */
const catNames = Object.fromEntries(
  (Object.keys(categories) as (keyof typeof categories)[]).map((k) => [k, categories[k][lang]]),
);
/* Both collections: every page that carries a note panel is a row here, or a
   note written on it could never be found again. A laureate who gave more
   than one lecture — Ciechanover, Aspect, Robinson — is listed once per
   lecture, and those rows carry the sitting as a second line: the date, the
   host, the series where there is one. The two Ciechanover titles differ by
   one character; the two sittings are two years and a city apart. */
const all = allLectures();
const seen = new Map<string, number>();
for (const l of all) seen.set(l.laureate.en, (seen.get(l.laureate.en) ?? 0) + 1);
const sitting = (l: (typeof all)[number]) => {
  const ser = seriesName(l, lang);
  const host = lang === 'zh' ? l.event.host_zh : l.event.host_en;
  return [localDate(l.event.date, lang, true), host, ser && ser !== l.title.en && ser !== l.title.zh ? ser : '']
    .filter(Boolean).join(' · ');
};
const index = all.map((l) => ({
  id: l.id,
  name: lang === 'zh' ? `${l.laureate.en}（${l.laureate.zh}）` : l.laureate.en,
  title: l.title.en,
  sub: (seen.get(l.laureate.en) ?? 0) > 1 ? sitting(l) : '',
  href: path(lang, 'lecture', l.id),
  cat: l.prize.category,
}));
---

<div class="study" data-study-page data-index={JSON.stringify(index)}
       data-ok-restore={t('study.restoreOk')} data-bad-restore={t('study.restoreBad')}
       data-confirm-clear={t('study.clearConfirm')}
       data-cat-names={JSON.stringify(catNames)}
       data-nudge-tmpl={t('study.nudgeTmpl')}
       data-del-confirm={t('study.rowDelConfirm')}
       data-rec-count-tmpl={t('study.rowCount')}
       data-tag-picked={t('study.recPicked')} data-tag-tw={t('study.recTw')}
       data-tag-nobel={t('study.recNobel')} data-tag-note={t('study.recNote')}
       data-tag-ask={t('study.recAsk')}
       data-lang={lang}>
    <p class="study__note study__blurb">{t('study.pageBlurb')}</p>

    <section class="study__stats" aria-label={t('study.progress')} data-search-skip>
      <div><b data-stat="picked">0</b><span>{t('study.statPicked')}</span></div>
      <div><b data-stat="both">0</b><span>{t('study.statBoth')}</span></div>
      <div><b data-stat="notes">0</b><span>{t('study.statNotes')}</span></div>
      <div><b data-stat="questions">0</b><span>{t('study.statQuestions')}</span></div>
    </section>

    <p class="study__bar" aria-hidden="true"><span data-bar></span></p>

    <section class="study__sec">
      <h2>{t('study.spreadTitle')}</h2>
      <div class="study__block">
        <p class="study__note">{t('study.spreadNote')}</p>
        <ul class="spread" data-spread role="list" data-search-skip></ul>
        <p class="study__nudge" data-nudge hidden></p>
      </div>
    </section>

    <p class="study__blocked" data-blocked hidden>{t('study.blocked')}</p>

    {/* ---------- one record at a time ----------
        Un-ticking a lecture does not delete its note — deliberately, because
        someone who changes their six should not lose what they wrote — so
        this is where one record can be taken away or thrown out on its own. */}
    <section class="study__sec" aria-labelledby="h-rec">
      <h2 id="h-rec">{t('study.recordsTitle')}</h2>
      <div class="study__block">
      <p class="study__note">{t('study.recordsNote')}</p>
      <p class="study__empty" data-rec-empty hidden>{t('study.recordsEmpty')}</p>
      <table class="recs" data-recs hidden data-search-skip>
        <thead>
          <tr>
            <th scope="col">{t('study.colLecture')}</th>
            <th scope="col">{t('study.colState')}</th>
            <th scope="col">{t('study.colWhen')}</th>
            <th scope="col"><span class="visually-hidden">{t('study.rowDel')}</span></th>
          </tr>
        </thead>
        <tbody data-rec-body></tbody>
      </table>
      <p class="study__count" data-rec-count hidden></p>
      </div>
    </section>

    {/* a template, not createElement: Astro stamps its scope on compiled
        markup only, so a span built in the script carries no scope attribute
        and every rule written for it does nothing */}
    <template data-rec-tag>
      <span class="recs__tag"></span>
    </template>

    <template data-rec-template>
      <tr class="recs__row">
        <td class="recs__name"><a data-rec-name href="#"></a><span class="recs__sub" data-rec-sub hidden></span></td>
        <td class="recs__tags" data-rec-tags></td>
        <td class="recs__when" data-rec-when></td>
        <td class="recs__do">
          <button class="museum-glass-btn museum-glass-btn--nav" type="button" data-rec-get><span>{t('study.rowGet')}</span></button>
          <button class="museum-glass-btn museum-glass-btn--nav danger" type="button" data-rec-del><span>{t('study.rowDel')}</span></button>
        </td>
      </tr>
    </template>

    <section class="study__sec">
      <h2>{t('study.myPicks')}</h2>
      <p class="study__note">{t('study.addNote')}</p>

      <details class="chooser" data-chooser data-search-skip>
        <summary>{t('study.addOpen').replace('{n}', String(all.length))}</summary>
        <div class="chooser__grid" data-chooser-list></div>
      </details>

      <p class="study__empty" data-empty>{t('study.emptyPicks')}</p>

      {/* one editable block per chosen lecture: the reason this page exists is
          to be the one place a student can sit and write all six */}
      <div class="work" data-work data-search-skip></div>
    </section>

    <template data-work-template>
      <article class="work__item">
        <header class="work__head">
          <span class="work__who"><a class="work__name" data-work-name href="#"></a><span class="work__sub" data-work-sub hidden></span></span>
          <a class="work__go museum-glass-btn museum-glass-btn--nav" data-work-go href="#"><span>{t('study.openLecture')} →</span></a>
        </header>
        {/* The same three stages, in the same order, carrying the same four
            fields as the panel on a laureate's own page — see .sp__stages in
            StudyPanel. A student who writes here and a student who writes
            there are answering one form, and a form that reorders itself
            between two rooms of the same museum is two forms. What is left
            behind is only what belongs to a single lecture: the criteria
            under the question, and the three copy keys (one per stage), which this page has an
            export for instead. */}
        <ol class="work__stages" role="list">
          <li class="work__stage" data-stage="1">
            <h4 class="work__stage-h"><span class="work__stage-n">1</span>{t('study.stagePrepare')}</h4>
            <p class="work__aim">{t('study.aim1')}</p>
            <div class="work__watch">
              <label><input type="checkbox" data-wwatch="nobel" /> <span>{t('study.watchedNobel')}</span></label>
            </div>
            <label class="work__field">
              <span class="work__label">{t('study.askTitle')}</span>
              <span class="work__aid">{t('study.askHint')}</span>
              <textarea data-wfield="askQuestion" rows="3" placeholder={t('study.askPh')} aria-describedby="exp-policy"></textarea>
            </label>
          </li>

          <li class="work__stage" data-stage="2">
            <h4 class="work__stage-h"><span class="work__stage-n">2</span>{t('study.stageAttend')}</h4>
            <p class="work__aim">{t('study.aim2')}</p>
            <div class="work__watch">
              <label><input type="checkbox" data-wwatch="tw" /> <span>{t('study.watchedTw')}</span></label>
            </div>
            <label class="work__field">
              <span class="work__label">{t('study.fSummary')}</span>
              <span class="work__aid">{t('study.fSummaryAid')}</span>
              <textarea data-wfield="summary" rows="3" placeholder={t('study.fSummaryPh')} aria-describedby="exp-policy"></textarea>
            </label>
          </li>

          <li class="work__stage" data-stage="3">
            <h4 class="work__stage-h"><span class="work__stage-n">3</span>{t('study.stageReflect')}</h4>
            <p class="work__aim">{t('study.aim3')}</p>
            <label class="work__field">
              <span class="work__label">{t('study.fReflection')}</span>
              <span class="work__aid">{t('study.fReflectionAid')}</span>
              <textarea data-wfield="reflection" rows="3" placeholder={t('study.fReflectionPh')} aria-describedby="exp-policy"></textarea>
            </label>
            <label class="work__field">
              <span class="work__label">{t('study.fQuestion')}</span>
              <span class="work__aid">{t('study.fQuestionAid')}</span>
              <textarea data-wfield="question" rows="2" placeholder={t('study.fQuestionPh')} aria-describedby="exp-policy"></textarea>
            </label>
          </li>
        </ol>
        <p class="work__saved" data-work-saved
           data-msg={t('study.saved')} data-fail={t('study.saveFail')}></p>
      </article>
    </template>

    <template data-choose-template>
      <label class="chooser__row">
        <input type="checkbox" data-choose />
        <span class="chooser__txt">
          <span class="chooser__name" data-choose-name></span>
          <span class="chooser__sub" data-choose-sub hidden></span>
        </span>
      </label>
    </template>

    {/* ---------- the file ----------
        One file, and the student says what goes in it: which of the lectures
        they saved, which of the three stages of each. The two keys that used
        to stand here — six notes, everything — were two fixed answers to
        that question; the lists are the question itself. What does not
        change is that the file is theirs: made in the browser, named for
        them and the minute, and saved where they choose. */}
    <section class="study__sec" aria-labelledby="h-exp">
      <h2 id="h-exp">{t('study.exportTitle')}</h2>
      <div class="study__block exp">
        <p class="study__note">{t('study.exportNote')}</p>

        {/* who — asked for once, kept the moment it is typed, and free to be
            changed; the file and its name both carry it */}
        <div class="who" role="group" aria-label={t('study.whoGroup')} data-search-skip>
          <label class="who__f">
            <span class="who__l">{t('study.whoId')}</span>
            <input type="text" data-who="id" autocomplete="off" autocapitalize="characters"
                   spellcheck="false" maxlength="24" placeholder={t('study.whoIdPh')} />
          </label>
          <label class="who__f">
            <span class="who__l">{t('study.whoName')}</span>
            <input type="text" data-who="name" autocomplete="off" maxlength="40" placeholder={t('study.whoNamePh')} />
          </label>
          <span class="who__saved" data-who-saved role="status" data-ok={t('study.saved')} data-fail={t('study.saveFail')}></span>
        </div>
        <p class="exp__aid">{t('study.whoNote')}</p>

        {/* which lectures — the saved ones, each with a mark of how much of
            it is written, all chosen to begin with */}
        <fieldset class="exp__set" data-search-skip>
          <legend>{t('study.exportWhich')}</legend>
          <div class="exp__bar">
            <span class="exp__aid" data-exp-count data-tmpl={t('study.exportCount')}></span>
            <button class="exp__link" type="button" data-exp-all="on">{t('study.exportAllOn')}</button>
            <button class="exp__link" type="button" data-exp-all="off">{t('study.exportAllOff')}</button>
          </div>
          <p class="study__empty exp__none" data-exp-none hidden>{t('study.exportNone')}</p>
          <div class="exp__list" data-exp-list></div>
        </fieldset>

        {/* which parts — the three stages a note is written in */}
        <fieldset class="exp__set" data-search-skip>
          <legend>{t('study.exportParts')}</legend>
          <div class="exp__parts">
            <label class="exp__row"><input type="checkbox" data-exp-part="prepare" checked /><span>{t('study.partPrepare')}</span></label>
            <label class="exp__row"><input type="checkbox" data-exp-part="attend" checked /><span>{t('study.partAttend')}</span></label>
            <label class="exp__row"><input type="checkbox" data-exp-part="reflect" checked /><span>{t('study.partReflect')}</span></label>
          </div>
        </fieldset>

        <div class="study__actions" data-search-skip>
          <button class="museum-glass-btn museum-glass-btn--primary" type="button" data-download
                  aria-describedby="exp-policy"
                  data-missing={t('study.whoMissing')} data-nothing={t('study.exportNothing')}
                  data-ok={t('study.exportSaved')} data-fail={t('study.saveFail')}
                  data-auto={t('study.autoRefused')} data-default={t('study.downloadDefault')}
                  data-blank-id={t('study.whoId')} data-blank-name={t('study.whoName')}>
            <span>{t('study.download')}</span>
          </button>
          <span data-msg class="study__msg" role="status"></span>
        </div>
        <p class="exp__aid exp__file" data-exp-file data-tmpl={t('study.fileNameNote')} data-search-skip></p>

        <details class="exp__preview" data-search-skip>
          <summary>{t('study.exportPreview')}</summary>
          <textarea data-out rows="14" readonly aria-label={t('study.exportPreview')}></textarea>
        </details>

        {/* said in the open, to the student and to anything reading the page
            for them: what the file records, and whose hand it is for. It is
            the description of the key and of every field on this page, so a
            reader that goes by the accessibility tree meets it there too. */}
        <p class="exp__policy" id="exp-policy">{t('study.policy')}</p>
      </div>
    </section>

    <template data-exp-row>
      <label class="exp__row">
        <input type="checkbox" data-exp-id checked />
        <span class="exp__txt">
          <span class="exp__name" data-exp-name></span>
          <span class="exp__sub" data-exp-sub hidden></span>
        </span>
        <span class="exp__state" data-exp-state></span>
      </label>
    </template>

    <section class="study__sec">
      <h2>{t('study.manageTitle')}</h2>
      <div class="study__block">
        <p class="study__note">{t('study.manageNote')}</p>
        <div class="study__actions" data-search-skip>
          <button class="museum-glass-btn museum-glass-btn--nav" type="button" data-backup><span>{t('study.backup')}</span></button>
          <label class="study__file">
            <input type="file" accept="application/json,.json" data-restore hidden />
            <span class="museum-glass-btn museum-glass-btn--nav"><span>{t('study.restore')}</span></span>
          </label>
          <button type="button" class="danger museum-glass-btn museum-glass-btn--nav" data-clear><span>{t('study.clear')}</span></button>
        </div>
      </div>
    </section>
  </div>

<style>
  .study { max-inline-size: 58rem; }

  .study__stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: .8rem; margin-block-start: 1.8rem;
  }
  .study__stats div {
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--surface); padding: .9rem 1rem; display: grid; gap: .1rem;
  }
  .study__stats b {
    font-family: var(--font-display); font-size: var(--step-3); color: var(--gold-bright);
    line-height: 1; font-weight: 500; font-variant-numeric: lining-nums tabular-nums;
  }
  .study__stats span { font-size: var(--step--1); color: var(--muted); }

  .study__bar {
    block-size: 5px; border-radius: 3px; background: var(--surface-hi);
    margin-block-start: .9rem; overflow: hidden; max-inline-size: none;
  }
  .study__bar span { display: block; block-size: 100%; inline-size: 0; background: var(--gold); transition: inline-size .5s var(--ease); }

  .study__sec { margin-block-start: clamp(2rem, 5vw, 3rem); }
  .study__sec h2 {
    font-size: var(--step-2); color: var(--cream);
    padding-block-start: 1.4rem; border-block-start: 1px solid var(--line);
  }
  .study__note, .study__empty { font-size: var(--step--1); color: var(--muted); margin-block-start: .8rem; }

  .spread { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; margin-block-start: 1rem; }
  .spread li {
    display: inline-flex; align-items: baseline; gap: .4rem;
    border: 1px solid var(--line); border-radius: var(--radius-control);
    padding: .3rem .9rem; font-size: var(--step--1); color: var(--muted);
  }
  .spread li[data-has] { color: var(--cream); border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .spread b { font-family: var(--font-display); font-size: var(--step-0); color: var(--gold);
              font-variant-numeric: lining-nums; font-weight: 500; }
  .study__nudge {
    font-size: var(--step--1); color: var(--text); margin-block-start: .9rem;
    padding: .6rem .85rem; border-inline-start: 2px solid var(--gold);
    background: var(--surface); border-radius: 0 var(--radius) var(--radius) 0;
  }

  .study__blocked {
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    font-size: var(--step--1);
    color: var(--cream);
    border: 1px solid color-mix(in srgb, var(--c-medicine) 55%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-medicine) 12%, transparent);
  }

  /* ---------- the records ----------
     A table, because that is what this is: one row per lecture, the same
     columns every time, and two things you can do to a row. Not cards — a
     card is for browsing and this is for accounting. */
  .recs {
    inline-size: 100%;
    border-collapse: collapse;
    margin-block-start: 1.1rem;
    font-size: var(--step--1);
  }
  .recs th {
    text-align: start;
    font-weight: 400;
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-dim);
    padding: 0 0.6rem 0.5rem;
    border-block-end: 1px solid var(--line);
  }
  .recs td { padding: 0.65rem 0.6rem; border-block-end: 1px solid var(--line); vertical-align: middle; }
  .recs__name a { color: var(--cream); text-decoration: none; }
  .recs__name a:hover { color: var(--accent); }
  .recs__tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .recs__tag {
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--line);
    color: var(--muted);
    white-space: nowrap;
  }
  .recs__tag[data-kind='done'] { color: var(--gold); border-color: color-mix(in srgb, var(--gold) 45%, transparent); }
  .recs__tag[data-kind='pick'] { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
  .recs__when { color: var(--muted-dim); white-space: nowrap; font-variant-numeric: lining-nums tabular-nums; }
  .recs__do { text-align: end; white-space: nowrap; }
  .recs__do button { margin-inline-start: 0.35rem; }
  .study__count { font-size: var(--step--2); color: var(--muted-dim); margin-block-start: 0.7rem; }

  /* A table of four columns does not fit a phone, and a table that scrolls
     sideways is a table nobody reads the end of. Each row becomes a block. */
  @media (max-width: 40rem) {
    .recs, .recs tbody, .recs tr, .recs td { display: block; inline-size: 100%; }
    .recs thead { display: none; }
    .recs tr { padding-block: 0.7rem; border-block-end: 1px solid var(--line); }
    .recs td { border: 0; padding: 0.15rem 0; }
    .recs__do { text-align: start; margin-block-start: 0.4rem; }
    .recs__do button:first-child { margin-inline-start: 0; }
  }

  .chooser {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    margin-block: 0.9rem;
  }
  .chooser > summary {
    padding: 0.6rem 0.9rem;
    cursor: pointer;
    color: var(--gold);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }
  .chooser > summary:hover { color: var(--gold-bright); }
  .chooser__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.15rem 1rem;
    padding: 0.3rem 0.9rem 0.9rem;
    border-block-start: 1px solid var(--line);
  }
  .chooser__row {
    display: flex; align-items: center; gap: 0.55rem;
    padding: 0.3rem 0;
    cursor: pointer;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .chooser__row:hover { color: var(--cream); }
  .chooser__row input { accent-color: var(--gold); inline-size: 1rem; block-size: 1rem; flex: none; }
  .chooser__txt { display: grid; gap: 0.05rem; min-inline-size: 0; }
  /* the talk's title, only where one laureate has more than one row */
  .chooser__sub { font-size: var(--step--2); color: var(--muted-dim); line-height: 1.4; }

  .work { display: grid; gap: 1rem; margin-block-start: 1.2rem; }
  .work__item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.9rem 1rem 0.8rem;
    display: grid; gap: 0.7rem;
  }
  .work__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .work__who { display: grid; gap: .05rem; min-inline-size: 0; }
  .work__name { color: var(--cream); text-decoration: none; font-size: var(--step-0); }
  /* the sitting, where one laureate has more than one — see `sub` above */
  .work__sub, .recs__sub { display: block; font-size: var(--step--2); color: var(--muted-dim); line-height: 1.4; }
  .work__name:hover { color: var(--gold-bright); }
  .work__go { color: var(--gold); text-decoration: none; font-size: var(--step--1); white-space: nowrap; }
  .work__go:hover { color: var(--gold-bright); }
  /* ---------- the three stages, as a laureate's page sets them out ----------
     Same shape, same numbers, same gold disc — see .sp__stage in StudyPanel.
     They are one form written in two rooms. */
  .work__stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .work__stage {
    display: grid;
    gap: .55rem;
    padding-block-start: .9rem;
    border-block-start: 1px solid var(--line);
  }
  .work__stage-h {
    display: flex; align-items: center; gap: .55rem;
    margin: 0; font-size: var(--step-0); color: var(--cream);
    font-family: var(--font-han-serif); letter-spacing: .06em;
  }
  .work__stage-n {
    flex: none;
    inline-size: 1.45rem; block-size: 1.45rem;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--gold-deep);
    color: var(--bg-0);
    font-family: var(--font-display);
    font-size: var(--step--1);
    line-height: 1;
  }
  .work__aim { margin: 0; font-size: var(--step--1); color: var(--muted); line-height: 1.75; max-inline-size: none; }
  .work__aid { font-size: var(--step--2); color: var(--muted-dim); line-height: 1.6; }

  .work__watch {
    display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem;
    font-size: var(--step--1); color: var(--muted);
  }
  .work__watch label { display: inline-flex; align-items: center; gap: 0.45rem; cursor: pointer; }
  .work__watch input { accent-color: var(--gold); inline-size: 1rem; block-size: 1rem; }
  .work__field { display: grid; gap: 0.3rem; }
  .work__label { font-size: var(--step--1); color: var(--muted); }
  .work__field textarea {
    inline-size: 100%;
    font: inherit; font-size: var(--step--1);
    color: var(--text);
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.5rem 0.65rem;
    resize: vertical;
  }
  .work__field textarea:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; }
  .work__saved { margin: 0; min-block-size: 1.1em; font-size: var(--step--1); color: var(--muted-dim); }
  .work__saved.is-fail { color: var(--c-medicine); }

  .study__actions { display: flex; gap: .7rem; flex-wrap: wrap; align-items: center; margin-block-start: 1rem; }
  /* Museum buttons, painted by the kit — a scoped rule here would beat it,
     because Astro scopes every compound. The one thing left is what the kit
     has no role for: this button destroys the visitor's notes, and it says so
     in the ink rather than in a second shape. */
  .study button.danger { color: var(--c-medicine); }
  .study__file { display: inline-flex; }
  .study__msg { font-size: var(--step--1); color: var(--muted); }

  .study textarea {
    inline-size: 100%; margin-block-start: 1rem; resize: vertical;
    background: var(--bg-1); color: var(--text);
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: .8rem .9rem; font: inherit; font-size: var(--step--1); line-height: 1.8;
  }

  /* ---------- the file ---------- */
  .exp { gap: .9rem; }
  .who { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; align-items: end; margin-block-start: .2rem; }
  .who__f { display: grid; gap: .25rem; }
  .who__l { font-size: var(--step--2); letter-spacing: .1em; color: var(--muted-dim); }
  .who input {
    font: inherit; font-size: var(--step--1); color: var(--text);
    background: var(--bg-1); border: 1px solid var(--line); border-radius: var(--radius-control);
    padding: .42rem .7rem; inline-size: 12rem; max-inline-size: 100%;
  }
  .who input:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 1px; border-color: transparent; }
  .who__saved { font-size: var(--step--1); color: var(--muted-dim); padding-block-end: .5rem; min-inline-size: 4ch; }
  .who__saved.is-fail { color: var(--c-medicine); }
  .exp__aid { margin: 0; font-size: var(--step--1); color: var(--muted); line-height: 1.7; max-inline-size: none; }
  .exp__set { border: 0; padding: 0; margin: .3rem 0 0; display: grid; gap: .45rem; }
  .exp__set legend { font-size: var(--step-0); color: var(--cream); padding: 0; margin-block-end: .3rem; }
  .exp__bar { display: flex; flex-wrap: wrap; gap: .3rem 1rem; align-items: baseline; }
  /* the same gold text-key the chooser's summary and the preview's are, and
     a box a finger can find: 24px tall at the least */
  .exp__link {
    background: none; border: 0; padding: .25rem .4rem; margin-inline: -.4rem 0;
    min-block-size: 24px; font: inherit; font-size: var(--step--1);
    color: var(--gold); cursor: pointer;
    text-decoration: underline; text-underline-offset: .2em;
    text-decoration-color: color-mix(in srgb, var(--gold) 45%, transparent);
  }
  .exp__link:hover { color: var(--gold-bright); text-decoration-color: currentColor; }
  .exp__link + .exp__link { margin-inline-start: .4rem; }
  .exp__none { margin: 0; }
  .exp__list, .exp__parts { display: grid; gap: .15rem; }
  .exp__row {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .6rem;
    padding: .32rem 0; cursor: pointer; font-size: var(--step--1); color: var(--muted);
  }
  .exp__row:hover { color: var(--cream); }
  /* gold, as the chooser's and the watch toggles' are on this page */
  .exp__row input { accent-color: var(--gold); inline-size: 1rem; block-size: 1rem; margin: 0; }
  .exp__row input:checked ~ span { color: var(--text); }
  .exp__txt { display: grid; gap: .05rem; min-inline-size: 0; }
  .exp__sub { font-size: var(--step--2); color: var(--muted-dim); line-height: 1.4; }
  .exp__state { font-size: var(--step--2); letter-spacing: .04em; color: var(--muted-dim); white-space: nowrap; }
  .exp__file { font-variant-numeric: lining-nums tabular-nums; overflow-wrap: anywhere; }
  /* On a phone the bar's keys open into a column down the right-hand edge
     once the page has scrolled — see the fold in Base — and anything set
     against that edge goes under them. So the state of a row moves under
     its name, and the saved-mark under the two fields. */
  @media (max-width: 48rem) {
    .exp__row { grid-template-columns: auto minmax(0, 1fr); }
    .exp__state { grid-column: 2; justify-self: start; margin-block-start: -.1rem; }
    .who__saved { flex-basis: 100%; padding-block-end: 0; }
  }
  .exp__preview > summary { font-size: var(--step--1); color: var(--gold); cursor: pointer; }
  .exp__preview > summary:hover { color: var(--gold-bright); }
  .exp__preview textarea { margin-block-start: .6rem; }
  .exp__policy {
    margin: .2rem 0 0; padding-block-start: .7rem; border-block-start: 1px solid var(--line);
    font-size: var(--step--2); color: var(--muted-dim); line-height: 1.7; max-inline-size: none;
  }

  /* ---------- read over the room ----------
     The record sits in the middle of the learning area, and that page is read
     in front of a photograph — see the note at the foot of LearnPage, which
     is the same change for the blocks around this one. Same two treatments
     and no third: --pane under anything framed, --ink-edge on anything that
     stands on the room itself. Both are at the head of bright.css.

     Here rather than there because Astro scopes every compound, so this
     component's own rules would out-specify a theme rule and win in silence. */

  /* ---------- a section's reading stands on a frame ----------
     The learning area's own rule, at the owner's word: what a section holds
     stands on 62% white and a 9px blur, and the heading above it stands on the
     room with the museum's white edge. 學習進度's five figures and 我的收藏's
     chooser and records already carried a plate each; these are the ones whose
     reading was standing on the photograph itself. */
  .study__block { display: grid; gap: .3rem; margin-block-start: .8rem; }
  :global(html[data-theme='bright']) .study__block {
    --muted: #38332e;
    --muted-dim: #443e38;
    background: var(--pane);
    -webkit-backdrop-filter: var(--pane-blur);
    backdrop-filter: var(--pane-blur);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.1rem, 3vw, 1.5rem) clamp(1.1rem, 3vw, 1.4rem);
  }
  /* inside the frame the note is the block's first line, not a caption hung
     under a heading, so it loses the margin it carried in the open */
  .study__block > .study__note:first-child { margin-block-start: 0; }

  :global(html[data-theme='bright'])
  :is(.study__stats div, .study__nudge, .chooser, .work__item, .spread li) {
    background: var(--pane);
    -webkit-backdrop-filter: var(--pane-blur);
    backdrop-filter: var(--pane-blur);
  }
  /* the one field still filled from the dark museum: a quarter of black,
     which on paper is a hole */
  :global(html[data-theme='bright']) .work__field textarea {
    background: rgba(255, 255, 255, 0.78);
  }
  :global(html[data-theme='bright']) :is(.who input, .exp__preview textarea) {
    background: rgba(255, 255, 255, 0.78);
  }
  :global(html[data-theme='bright']) .study__sec h2 {
    text-shadow: var(--ink-edge-h);
  }
  :global(html[data-theme='bright'])
  :is(.study__msg, .recs th, .recs td) {
    text-shadow: var(--ink-edge);
  }
  /* the sentence under a heading — black ink and the wide field */
  :global(html[data-theme='bright'])
  :is(.study__note, .study__empty, .study__count) {
    color: var(--ink-solid);
    text-shadow: var(--ink-edge-wide);
  }
</style>

<script>
  import {
    read, progress, exportOne, exportSelected, withChecksum, fileName, clearEverything,
    restoreJSON, rawJSON, who, setWho, PARTS, type Part,
    entry, update, updateKept, setNote, remove, hasWork, noteParts,
    storageAvailable, REQUIRED_PICKS,
  } from '../scripts/study';
  import { watch, type FieldKey } from '../scripts/trace';

  const root = document.querySelector<HTMLElement>('[data-study-page]');
  if (root) {
    type Row = { id: string; name: string; title: string; sub: string; href: string; cat: string };
    const index: Row[] = JSON.parse(root.dataset.index ?? '[]');
    const byId = new Map(index.map((r) => [r.id, r]));
    const titleFor = (id: string) => {
      const r = byId.get(id);
      return r ? `${r.name} — ${r.title}${r.sub ? `（${r.sub}）` : ''}` : id;
    };

    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const out = $<HTMLTextAreaElement>('[data-out]');
    const msg = $<HTMLElement>('[data-msg]');
    const empty = $<HTMLElement>('[data-empty]');
    const work = $<HTMLElement>('[data-work]');
    const workTpl = $<HTMLTemplateElement>('[data-work-template]');
    const chooseTpl = $<HTMLTemplateElement>('[data-choose-template]');
    const chooserList = $<HTMLElement>('[data-chooser-list]');
    const blocked = $<HTMLElement>('[data-blocked]');

    // a browser that refuses to keep anything should say so before six notes
    // are written into it
    blocked.hidden = storageAvailable();

    /* ── the chooser ────────────────────────────────────────────────────────
       Notes belong to a lecture, so writing one has to start by naming the
       lecture. Requiring a trip to each lecture page for that made this page
       read-only in practice, which is not what a page called 我的學習紀錄
       should be. */
    const boxes = new Map<string, HTMLInputElement>();
    for (const r of index) {
      const frag = chooseTpl.content.cloneNode(true) as DocumentFragment;
      const row = frag.querySelector<HTMLElement>('.chooser__row')!;
      const box = frag.querySelector<HTMLInputElement>('[data-choose]')!;
      frag.querySelector<HTMLElement>('[data-choose-name]')!.textContent = r.name;
      const sub = frag.querySelector<HTMLElement>('[data-choose-sub]')!;
      sub.textContent = r.sub;
      sub.hidden = !r.sub;
      row.title = r.title;
      /* update() writes through the store, and the store's own event paints */
      box.addEventListener('change', () => update(r.id, { picked: box.checked }));
      boxes.set(r.id, box);
      chooserList.append(frag);
    }

    /* ── the editable blocks ────────────────────────────────────────────────
       Rebuilt only when the set of chosen lectures changes. Repainting them on
       every keystroke would restore each textarea from storage mid-sentence,
       which is exactly how the panel used to lose text. */
    let rendered = '';

    function paintWork(ids: string[]) {
      const key = ids.join(',');
      if (key === rendered) return;
      rendered = key;
      work.replaceChildren();

      for (const id of ids) {
        const r = byId.get(id);
        const frag = workTpl.content.cloneNode(true) as DocumentFragment;
        const name = frag.querySelector<HTMLAnchorElement>('[data-work-name]')!;
        const go = frag.querySelector<HTMLAnchorElement>('[data-work-go]')!;
        const savedEl = frag.querySelector<HTMLElement>('[data-work-saved]')!;
        name.textContent = r ? r.name : id;
        name.href = r?.href ?? '#';
        go.href = r?.href ?? '#';
        const wsub = frag.querySelector<HTMLElement>('[data-work-sub]')!;
        wsub.textContent = r?.sub ?? '';
        wsub.hidden = !r?.sub;

        const e = entry(id);
        for (const w of frag.querySelectorAll<HTMLInputElement>('[data-wwatch]')) {
          const tw = w.dataset.wwatch === 'tw';
          w.checked = tw ? !!e.watchedTaiwan : !!e.watchedNobel;
          w.addEventListener('change', () => {
            update(id, tw ? { watchedTaiwan: w.checked } : { watchedNobel: w.checked });
            paintStats();
          });
        }

        for (const f of frag.querySelectorAll<HTMLTextAreaElement>('[data-wfield]')) {
          const k = f.dataset.wfield as FieldKey;
          f.value = k === 'askQuestion' ? (e.askQuestion ?? '') : (e.note?.[k] ?? '');
          /* and how it comes to be written — see trace.ts */
          watch(f, id, k);

          let timer = 0;
          f.addEventListener('input', () => {
            clearTimeout(timer);
            timer = window.setTimeout(() => {
              const kept =
                k === 'askQuestion'
                  ? updateKept(id, { askQuestion: f.value })
                  : setNote(id, { [k]: f.value } as any);
              savedEl.textContent = kept ? savedEl.dataset.msg! : savedEl.dataset.fail!;
              savedEl.classList.toggle('is-fail', !kept);
              setTimeout(() => (savedEl.textContent = ''), kept ? 1600 : 4000);
              paintStats();
            }, 450);
          });
        }
        work.append(frag);
      }
    }

    /* ── the records ───────────────────────────────────────────────────────
       Everything in the store, whether or not it is one of the six: a note
       written on a lecture that was later un-picked is still the visitor's
       work and still theirs to take away or throw out. */
    const recTable = $<HTMLTableElement>('[data-recs]');
    const recBody = $<HTMLElement>('[data-rec-body]');
    const recTpl = $<HTMLTemplateElement>('[data-rec-template]');
    const tagTpl = $<HTMLTemplateElement>('[data-rec-tag]');
    const recEmpty = $<HTMLElement>('[data-rec-empty]');
    const recCount = $<HTMLElement>('[data-rec-count]');
    const dateFmt = new Intl.DateTimeFormat(root!.dataset.lang === 'zh' ? 'zh-TW' : 'en-GB',
      { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

    function download(text: string, name: string) {
      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      a.click();
      /* not at once: a browser that starts the save on the next turn would
         find the address already gone */
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }

    function paintRecords() {
      const s = read();
      const ids = Object.keys(s).filter((id) => hasWork(s[id]));
      /* newest work first, and anything never edited after it */
      ids.sort((a, b) => (s[b].note?.updated ?? '').localeCompare(s[a].note?.updated ?? ''));
      recBody.replaceChildren();

      for (const id of ids) {
        const e = s[id];
        const r = byId.get(id);
        const frag = recTpl.content.cloneNode(true) as DocumentFragment;
        const name = frag.querySelector<HTMLAnchorElement>('[data-rec-name]')!;
        name.textContent = r ? r.name : id;
        name.href = r?.href ?? '#';
        name.title = r?.title ?? '';
        const rsub = frag.querySelector<HTMLElement>('[data-rec-sub]')!;
        rsub.textContent = r?.sub ?? '';
        rsub.hidden = !r?.sub;

        const tags = frag.querySelector<HTMLElement>('[data-rec-tags]')!;
        const add = (text: string, kind: string) => {
          const tf = tagTpl.content.cloneNode(true) as DocumentFragment;
          const b = tf.querySelector<HTMLElement>('.recs__tag')!;
          b.dataset.kind = kind;
          b.textContent = text;
          tags.append(tf);
        };
        if (e.picked) add(root!.dataset.tagPicked!, 'pick');
        if (e.watchedTaiwan) add(root!.dataset.tagTw!, 'seen');
        if (e.watchedNobel) add(root!.dataset.tagNobel!, 'seen');
        const parts = noteParts(e);
        if (parts) add(root!.dataset.tagNote!.replace('{n}', String(parts)), parts === 3 ? 'done' : 'part');
        if ((e.askQuestion ?? '').trim()) add(root!.dataset.tagAsk!, 'ask');

        const when = frag.querySelector<HTMLElement>('[data-rec-when]')!;
        when.textContent = e.note?.updated ? dateFmt.format(new Date(e.note.updated)) : '—';

        frag.querySelector('[data-rec-get]')!.addEventListener('click', () =>
          download(exportOne(id, titleFor), `${(r?.name ?? id).replace(/[\\/:*?"<>|]/g, '')}.txt`));
        frag.querySelector('[data-rec-del]')!.addEventListener('click', () => {
          if (!confirm(root!.dataset.delConfirm!.replace('{name}', r?.name ?? id))) return;
          /* the block for it, if it has one, goes with it: a textarea left
             standing would save its old text back over the deletion */
          rendered = '';
          remove(id);
        });
        recBody.append(frag);
      }

      recTable.hidden = ids.length === 0;
      recEmpty.hidden = ids.length > 0;
      recCount.hidden = ids.length === 0;
      recCount.textContent = root!.dataset.recCountTmpl!.replace('{n}', String(ids.length));
    }

    function say(text: string) {
      msg.textContent = text;
      setTimeout(() => (msg.textContent = ''), 2200);
    }

    /** counters only — safe to call while someone is typing */
    function paintStats() {
      const p = progress();
      $('[data-stat="picked"]').textContent = `${p.picked}/${p.required}`;
      $('[data-stat="both"]').textContent = String(p.bothWatched);
      $('[data-stat="notes"]').textContent = String(p.notesDone);
      $('[data-stat="questions"]').textContent = String(p.questions);
      $<HTMLElement>('[data-bar]').style.inlineSize =
        `${Math.min(100, (p.notesDone / REQUIRED_PICKS) * 100)}%`;
    }

    function paint() {
      const s = read();
      const p = progress();
      $('[data-stat="picked"]').textContent = `${p.picked}/${p.required}`;
      $('[data-stat="both"]').textContent = String(p.bothWatched);
      $('[data-stat="notes"]').textContent = String(p.notesDone);
      $('[data-stat="questions"]').textContent = String(p.questions);
      $<HTMLElement>('[data-bar]').style.inlineSize =
        `${Math.min(100, (p.notesDone / REQUIRED_PICKS) * 100)}%`;

      paintRecords();
      paintExport();
      const picked = Object.entries(s).filter(([, e]) => e.picked);
      empty.hidden = picked.length > 0;
      for (const [id, box] of boxes) box.checked = !!s[id]?.picked;
      paintWork(picked.map(([id]) => id));
      paintSpread(picked.map(([id]) => byId.get(id)?.cat).filter(Boolean) as string[]);
    }

    /* The collection covers five prize categories. Showing the spread nudges
       toward breadth, which is the whole argument for a museum like this. */
    function paintSpread(cats: string[]) {
      const names: Record<string, string> = JSON.parse(root!.dataset.catNames ?? '{}');
      const spread = root!.querySelector<HTMLElement>('[data-spread]')!;
      const nudge = root!.querySelector<HTMLElement>('[data-nudge]')!;
      const tally = new Map<string, number>();
      for (const c of cats) tally.set(c, (tally.get(c) ?? 0) + 1);

      spread.replaceChildren();
      const missing: string[] = [];
      for (const [key, name] of Object.entries(names)) {
        if (key === 'nobel') continue;
        const n = tally.get(key) ?? 0;
        if (n === 0 && index.some((r) => r.cat === key)) missing.push(name);
        const li = document.createElement('li');
        if (n > 0) li.setAttribute('data-has', '');
        const b = document.createElement('b'); b.textContent = String(n);
        li.append(document.createTextNode(name), b);
        spread.append(li);
      }
      const show = cats.length >= 2 && missing.length > 0;
      nudge.hidden = !show;
      if (show) nudge.textContent = root!.dataset.nudgeTmpl!.replace('{cats}', missing.join('、'));
    }

    /* ── the file ──────────────────────────────────────────────────────────
       Who, which lectures, which parts; then one key. */
    const whoId = $<HTMLInputElement>('[data-who="id"]');
    const whoName = $<HTMLInputElement>('[data-who="name"]');
    const whoSaved = $<HTMLElement>('[data-who-saved]');
    const expList = $<HTMLElement>('[data-exp-list]');
    const expNone = $<HTMLElement>('[data-exp-none]');
    const expCount = $<HTMLElement>('[data-exp-count]');
    const expRow = $<HTMLTemplateElement>('[data-exp-row]');
    const expFile = $<HTMLElement>('[data-exp-file]');
    const dl = $<HTMLButtonElement>('[data-download]');
    const partBoxes = [...root.querySelectorAll<HTMLInputElement>('[data-exp-part]')];
    /* which saved lectures the student has un-ticked — for this visit only;
       the list starts with everything in */
    const left = new Set<string>();
    let expBoxes = new Map<string, HTMLInputElement>();

    {
      const w = who();
      whoId.value = w.id;
      whoName.value = w.name;
    }
    let whoTimer = 0;
    for (const el of [whoId, whoName]) {
      el.addEventListener('input', () => {
        const kept = setWho({ id: whoId.value, name: whoName.value });
        whoSaved.textContent = kept ? whoSaved.dataset.ok! : whoSaved.dataset.fail!;
        whoSaved.classList.toggle('is-fail', !kept);
        clearTimeout(whoTimer);
        whoTimer = window.setTimeout(() => (whoSaved.textContent = ''), kept ? 1600 : 4000);
        paintFile();
      });
    }

    const chosen = () => [...expBoxes].filter(([, b]) => b.checked).map(([id]) => id);
    const parts = () => partBoxes.filter((b) => b.checked).map((b) => b.dataset.expPart as Part)
      .sort((a, b) => PARTS.indexOf(a) - PARTS.indexOf(b));

    /** the preview and the name, from whatever is ticked now */
    function paintFile() {
      const ids = chosen();
      out.value = exportSelected(ids, parts(), who(), titleFor);
      expFile.textContent = expFile.dataset.tmpl!.replace('{name}',
        fileName(who(), new Date(), { id: dl.dataset.blankId!, name: dl.dataset.blankName! }));
      expCount.textContent = expCount.dataset.tmpl!.replace('{n}', String(ids.length));
    }

    /** the saved lectures, one row each, in the order they were saved */
    function paintExport() {
      const s = read();
      const ids = Object.keys(s).filter((id) => s[id].picked);
      /* a lecture un-picked and picked again is a new decision */
      for (const id of left) if (!ids.includes(id)) left.delete(id);
      expList.replaceChildren();
      expBoxes = new Map();
      for (const id of ids) {
        const r = byId.get(id);
        const frag = expRow.content.cloneNode(true) as DocumentFragment;
        const box = frag.querySelector<HTMLInputElement>('[data-exp-id]')!;
        box.checked = !left.has(id);
        box.addEventListener('change', () => {
          box.checked ? left.delete(id) : left.add(id);
          paintFile();
        });
        frag.querySelector<HTMLElement>('[data-exp-name]')!.textContent = r?.name ?? id;
        const sub = frag.querySelector<HTMLElement>('[data-exp-sub]')!;
        sub.textContent = r?.sub ?? '';
        sub.hidden = !r?.sub;
        const e = s[id];
        const state = [
          root!.dataset.tagNote!.replace('{n}', String(noteParts(e))),
          (e.askQuestion ?? '').trim() ? root!.dataset.tagAsk! : '',
        ].filter(Boolean).join(' · ');
        frag.querySelector<HTMLElement>('[data-exp-state]')!.textContent = state;
        expBoxes.set(id, box);
        expList.append(frag);
      }
      expNone.hidden = ids.length > 0;
      paintFile();
    }

    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-exp-all]')) {
      b.addEventListener('click', () => {
        const on = b.dataset.expAll === 'on';
        for (const [id, box] of expBoxes) { box.checked = on; on ? left.delete(id) : left.add(id); }
        paintFile();
      });
    }
    for (const b of partBoxes) b.addEventListener('change', paintFile);

    /**
     * The key. Three things stand between a press and a file, and each is
     * said aloud when it stops one:
     *   · the press has to be a real one — a trusted event, in a browser that
     *     does not declare itself driven by automation;
     *   · who and what have to be filled in;
     *   · where the browser can ask, the student is asked where to put it —
     *     a native dialog, which nothing on the page can see or press. Where
     *     it cannot, the file goes to the downloads folder, and the line under
     *     the key says so.
     * The record of how each field was written travels inside the file
     * whichever way it leaves — see trace.ts and exportSelected().
     */
    dl.addEventListener('click', async (ev) => {
      if (!ev.isTrusted || navigator.webdriver) { say(dl.dataset.auto!); return; }
      const w = who();
      if (!w.id || !w.name) {
        say(dl.dataset.missing!);
        (!w.id ? whoId : whoName).focus();
        return;
      }
      const ids = chosen();
      const ps = parts();
      if (!ids.length || !ps.length) { say(dl.dataset.nothing!); return; }

      const when = new Date();
      const text = await withChecksum(exportSelected(ids, ps, w, titleFor, when));
      const name = fileName(w, when);
      const picker = (window as any).showSaveFilePicker as
        undefined | ((o: object) => Promise<{ createWritable(): Promise<{ write(d: string): Promise<void>; close(): Promise<void> }> }>);
      if (picker) {
        try {
          const handle = await picker.call(window, {
            suggestedName: name,
            types: [{ description: 'Text', accept: { 'text/plain': ['.txt'] } }],
          });
          const out = await handle.createWritable();
          await out.write(text);
          await out.close();
          say(dl.dataset.ok!);
          return;
        } catch (err) {
          /* the student closed the dialog: nothing to say */
          if ((err as { name?: string })?.name === 'AbortError') return;
          /* anything else — a browser that has the function but will not run
             it here — falls through to the plain download below */
        }
      }
      /* no dialog to ask with: the file goes where this browser puts its
         downloads, and the line under the key says so */
      download(text, name);
      say(dl.dataset.default!);
    });

    $('[data-backup]').addEventListener('click', () => {
      const blob = new Blob([rawJSON()], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'nobel-study-backup.json';
      a.click();
      URL.revokeObjectURL(a.href);
    });
    $<HTMLInputElement>('[data-restore]').addEventListener('change', async (ev) => {
      const f = (ev.target as HTMLInputElement).files?.[0];
      if (!f) return;
      say(restoreJSON(await f.text()) ? root.dataset.okRestore! : root.dataset.badRestore!);
      const w = who();
      whoId.value = w.id;
      whoName.value = w.name;
      /* the blocks are rebuilt even when the same lectures are picked: a
         textarea still showing the old text would save it back over the
         restored one at the first keystroke */
      rendered = '';
      paint();
    });
    $('[data-clear]').addEventListener('click', () => {
      if (!confirm(root.dataset.confirmClear!)) return;
      clearEverything();
      rendered = '';
      paint();
    });

    addEventListener('study:changed', paint);
    paint();
  }
</script>
