---
/**
 * PageNav.astro — two standing controls in the lower right of every page.
 *
 * The galleries and lecture pages run long, and the only way back up was the
 * scrollbar. These two do not move with the page: one returns to the top of
 * the current page, one returns to wherever the visitor came from.
 *
 * Both are conditional rather than permanent, so a short page shows nothing:
 *   · "top"  appears only once the page has been scrolled past a screenful
 *   · "back" appears only when the previous page was inside the museum, so it
 *     can never dead-end on a search engine or an empty history
 *
 * Below 48rem the labels drop and the pills become 44px circles — the same
 * decision the style switcher makes with its own descriptions.
 */
import { useT, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<div class="pn" data-pn>
  {/* "top" sits in the upper slot so that when it fades in, the corner-anchored
      "back" below it does not shift */}
  <button class="pn__b museum-glass-btn museum-glass-btn--nav" type="button" data-pn-act="top" aria-label={t('nav.toTop')}>
    <svg class="pn__i" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V6" /><path d="M5.5 12.5 12 6l6.5 6.5" />
    </svg>
    <span class="pn__t" aria-hidden="true">{t('nav.toTop')}</span>
  </button>

  <button class="pn__b museum-glass-btn museum-glass-btn--nav" type="button" data-pn-act="back" aria-label={t('nav.back')}>
    <svg class="pn__i" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H6" /><path d="M11.5 5.5 5 12l6.5 6.5" />
    </svg>
    <span class="pn__t" aria-hidden="true">{t('nav.back')}</span>
  </button>
</div>

<style>
  .pn {
    position: fixed;
    inset-block-end: clamp(1rem, 2.6vw, 1.9rem);
    inset-inline-end: clamp(1rem, 3vw, 2.5rem);
    /* under the walk-in overlay (40) so the transition covers it, above
       everything in normal page flow */
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  /* These are nav keys from the button kit; what is left here is the state
     machine — they are hidden until the page has been scrolled, and that is
     the one thing the kit knows nothing about. No look-and-feel here: a
     scoped rule would beat the kit. */
  .pn__b {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* `translate`, not `transform`: they are separate properties and compose,
       so the arrival slide and the kit's hover lift can both be true at once.
       On `transform` this rule would have won on specificity and the key
       would have been the one button on the site that does not answer. */
    translate: 0 6px;
    transition:
      opacity 0.3s var(--ease), translate 0.3s var(--ease);
  }
  .pn__b.is-on {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    translate: none;
  }
  /* no history worth returning to: the slot goes away entirely rather than
     standing there as a dead control */
  .pn__b[hidden] { display: none; }


  .pn__i { inline-size: 1rem; block-size: 1rem; flex: none; }
  .pn__t { white-space: nowrap; }

  /* icon-only below the point where a label would crowd the content */
  @media (max-width: 48rem) {
    .pn__t { display: none; }
    /* icon-only, and square rather than round: the kit's key is a rectangle
       with a small radius and its skin is a nine-slice, which a circle would
       cut the corners off. Same 44px either way. */
    .pn__b {
      padding: 0;
      min-inline-size: 2.75rem;
      min-block-size: 2.75rem;
    }
    .pn__i { inline-size: 1.15rem; block-size: 1.15rem; }
  }

  @media print { .pn { display: none; } }
</style>

<script>
  import { motionOn } from '../scripts/motion';

  const wrap = document.querySelector<HTMLElement>('[data-pn]');
  const toTop = wrap?.querySelector<HTMLButtonElement>('[data-pn-act="top"]');
  const back = wrap?.querySelector<HTMLButtonElement>('[data-pn-act="back"]');

  if (toTop && back) {
    // ── back ──────────────────────────────────────────────────────────────
    // history.length is unreliable (a fresh tab already reports 2), so the
    // referrer decides: it is set on every same-origin navigation and empty
    // on a direct hit, which is exactly the distinction wanted here.
    let cameFromHere = false;
    try {
      cameFromHere =
        !!document.referrer && new URL(document.referrer).origin === location.origin;
    } catch { /* malformed referrer: treat as a direct hit */ }

    if (cameFromHere) back.classList.add('is-on');
    else back.hidden = true;

    back.addEventListener('click', () => history.back());

    // ── back to top ───────────────────────────────────────────────────────
    // a screenful, floored so that a short page on a small phone still has to
    // travel a real distance before the control appears
    const threshold = () => Math.max(320, innerHeight * 0.6);

    let queued = false;
    const sync = () => {
      queued = false;
      toTop.classList.toggle('is-on', scrollY > threshold());
    };
    addEventListener(
      'scroll',
      () => {
        if (!queued) { queued = true; requestAnimationFrame(sync); }
      },
      { passive: true },
    );
    addEventListener('resize', sync, { passive: true });
    sync();

    toTop.addEventListener('click', () => {
      scrollTo({ top: 0, behavior: motionOn() ? 'smooth' : 'auto' });
      // move the reading position too, or a keyboard visitor is returned to
      // the top visually while their focus stays deep in the page
      document.getElementById('main')?.focus({ preventScroll: true });
    });
  }
</script>
