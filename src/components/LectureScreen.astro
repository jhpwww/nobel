---
/**
 * LectureScreen.astro — lecture footage running behind the hall.
 *
 * This is the "video museum" cue: not an abstract loop, but the lectures
 * themselves, muted and dimmed, behind the sculptures.
 *
 * Never a live youtube-nocookie embed: measured on the deployed site, one
 * streamed 0.27–0.30 MB/s for as long as the tab was open — 21 MB a minute for
 * decoration at 38–50% opacity under a grading layer — and iOS will not
 * autoplay a cross-origin iframe without a gesture, so on a phone it sat
 * paused with a pause glyph over the hall.
 *
 * So the footage is short self-hosted cuts that loop: a few hundred KB once,
 * and a muted playsinline <video> autoplays on iOS where the iframe never
 * could — desktop and phone show the same thing.
 *
 * Until the cuts exist, src/data/backdrop.json is empty and this falls back to
 * cross-fading the lecture stills: the same frames, moving, at almost no cost.
 * Both paths are gated on Save-Data, on 2G-class connections, and on the
 * site's motion switch, and neither loads anything before the still has given
 * the page something to show.
 *
 * Generate the cuts with: python3 scripts/make-backdrop-clips.py
 */
import { lectures } from '../data/catalog';
import { asset } from '../i18n/routing';
import clips from '../data/backdrop.json';

interface Props { opacity?: number; count?: number }
const { opacity = 0.5, count = 6 } = Astro.props;

/** lectures that actually have footage, richest first so the cycle opens well */
const picks = lectures
  .filter((l) => l.video.lecture || l.video.guide)
  .slice(0, count)
  .map((l) => ({ id: (l.video.guide ?? l.video.lecture)! }));
const first = picks[0];

type Clip = { id: string; webm: string; mp4: string };
const reel = (clips as Clip[]).map((c) => ({
  webm: asset(c.webm),
  mp4: asset(c.mp4),
}));
---

<div class="ls" style={`--ls-o:${opacity}`} aria-hidden="true">
  <img
    class="ls__still" data-still="a"
    src={`https://i.ytimg.com/vi/${first.id}/maxresdefault.jpg`}
    alt=""
    width="1280" height="720" loading="eager" decoding="async"
  />
  <img class="ls__still ls__still--b" data-still="b" alt="" width="1280" height="720"
       decoding="async" />

  {reel.length > 0 && (
    <video
      class="ls__vid"
      data-lecture-video
      data-reel={JSON.stringify(reel)}
      muted loop playsinline preload="none"
      width="854" height="480"
    ></video>
  )}

  <div class="ls__stage" data-lecture-screen data-picks={JSON.stringify(picks)}></div>
  <div class="ls__grade"></div>
</div>

<style>
  .ls { position: absolute; inset: 0; z-index: -4; overflow: hidden; pointer-events: none; }
  .ls__still, .ls__stage, .ls__vid {
    position: absolute;
    /* overscan: an encoder's edge must never show */
    inset: -8%;
    inline-size: 116%;
    block-size: 116%;
  }
  .ls__still, .ls__vid { object-fit: cover; }
  .ls__still {
    opacity: var(--ls-o);
    filter: saturate(0.45) brightness(0.5) contrast(1.05);
    transition: opacity 1.6s ease;
  }
  .ls__vid {
    opacity: 0;
    filter: saturate(0.42) brightness(0.46) contrast(1.06);
    transition: opacity 1.8s ease;
  }
  .ls__vid[data-on] { opacity: var(--ls-o); }
  .ls:has(.ls__vid[data-on]) .ls__still { opacity: 0; }

  /* the incoming frame of the stills fallback, faded up over the outgoing one */
  .ls__still--b { opacity: 0; }
  .ls__still--b[data-on] { opacity: var(--ls-o); }
  .ls__still--b[data-on] ~ [data-still='a'] { opacity: 0; }

  .ls__stage { display: none; }

  /* On a phone the hall runs well past the fold — pieces stacked two to a row
     — and a backdrop spanning all of it centres the footage somewhere the
     visitor never looks. Holding it to one screen puts it behind the masthead
     and the first pieces, which is where it is actually seen. */
  @media (max-width: 48rem) {
    .ls { block-size: 100svh; inset-block-end: auto; }
  }

  /* keeps the footage as a backdrop rather than a distraction */
  .ls__grade {
    position: absolute; inset: 0;
    background:
      radial-gradient(72% 62% at 50% 42%, rgba(24, 14, 5, 0.34), rgba(10, 6, 3, 0.9) 100%),
      linear-gradient(to bottom, rgba(10, 6, 3, 0.72) 0 14%, rgba(10, 6, 3, 0.3) 42%, rgba(10, 6, 3, 0.92) 100%);
  }
</style>

<script>
  import { motionOn } from '../scripts/motion';

  const wrap = document.querySelector<HTMLElement>('.ls');
  if (wrap) {
    const conn = (navigator as any).connection;
    const saveData = conn?.saveData === true;
    const crawling = /^(slow-)?2g$/.test(conn?.effectiveType ?? '');
    const blocked = () => saveData || crawling || !motionOn();

    const video = wrap.querySelector<HTMLVideoElement>('[data-lecture-video]');
    const stillA = wrap.querySelector<HTMLImageElement>('[data-still="a"]')!;
    const stillB = wrap.querySelector<HTMLImageElement>('[data-still="b"]')!;
    let timer = 0;

    /* ── the cuts, when they exist ────────────────────────────────────────
       Each is a few hundred KB and loops locally, so after the first play the
       backdrop costs nothing at all. They are swapped occasionally for
       variety, not continuously. */
    function startVideo(v: HTMLVideoElement) {
      const reel: { webm: string; mp4: string }[] = JSON.parse(v.dataset.reel ?? '[]');
      if (!reel.length) return false;
      let n = 0;

      const load = () => {
        const c = reel[n % reel.length];
        v.replaceChildren();
        const webm = document.createElement('source');
        webm.src = c.webm; webm.type = 'video/webm';
        const mp4 = document.createElement('source');
        mp4.src = c.mp4; mp4.type = 'video/mp4';
        v.append(webm, mp4);
        v.load();
        // autoplay can still be declined; the stills stay underneath either way
        v.play().then(() => v.setAttribute('data-on', '')).catch(() => {});
      };

      load();
      if (reel.length > 1) {
        timer = window.setInterval(() => {
          if (document.hidden || !motionOn()) return;
          n++;
          load();
        }, 45_000);
      }
      return true;
    }

    /* ── the fallback: the same lecture frames, cross-faded ───────────────
       Two layers alternating, so the outgoing frame is still painted while
       the incoming one arrives. No third-party script, tens of KB a frame. */
    function startStills() {
      const picks: { id: string }[] =
        JSON.parse(wrap!.querySelector<HTMLElement>('[data-lecture-screen]')?.dataset.picks ?? '[]');
      if (picks.length < 2) return;
      let n = 0, showingB = false;
      timer = window.setInterval(() => {
        if (document.hidden || !motionOn()) return;
        n = (n + 1) % picks.length;
        const next = showingB ? stillA : stillB;
        const img = new Image();
        img.onload = () => {
          next.src = img.src;
          showingB = !showingB;
          stillB.toggleAttribute('data-on', showingB);
        };
        img.src = `https://i.ytimg.com/vi/${picks[n].id}/maxresdefault.jpg`;
      }, 9000);
    }

    function start() {
      if (blocked() || wrap!.dataset.live) return;
      wrap!.dataset.live = '1';
      if (video && startVideo(video)) return;
      startStills();
    }

    function stop() {
      clearInterval(timer);
      video?.pause();
      video?.removeAttribute('data-on');
      delete wrap!.dataset.live;
    }

    // wait for a quiet moment so the hall paints first
    const kick = () => setTimeout(start, 900);
    if (document.readyState === 'complete') kick();
    else addEventListener('load', kick, { once: true });

    addEventListener('motionpref', () => (motionOn() ? start() : stop()));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video?.pause();
      else if (wrap.dataset.live) video?.play().catch(() => {});
    });
  }
</script>
