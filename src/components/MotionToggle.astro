---
/**
 * MotionToggle.astro — lets a visitor turn the museum's motion off, and back on.
 *
 * The museum animates by default and does not consult the OS's reduce-motion
 * signal (see src/scripts/motion.ts), so there is nothing to show a new
 * visitor: the button is rendered hidden and revealed by script only for a
 * visitor who has already pressed it once in this browser — to let them turn
 * it back, either way — and never nags anyone else.
 */
import { type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = {
  zh: { on: '開啟動態效果', off: '關閉動態效果' },
  en: { on: 'Turn on motion', off: 'Turn off motion' },
}[lang];
---
<button class="mt" data-motion-toggle hidden type="button" aria-live="polite">
  <span class="mt__dot" aria-hidden="true"></span>
  <span class="mt__label" data-on-label={t.on} data-off-label={t.off}>{t.on}</span>
</button>

<style>
  .mt {
    /* top-right is the language nav and top-left is the style switcher, so
       this sits under the switcher — anywhere else and the header swallows
       the click even though the button paints above it */
    position: absolute;
    inset-block-start: 3.95rem;
    inset-inline-start: clamp(1rem, 3vw, 2.5rem);
    z-index: 61;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.34rem 0.95rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--cream);
    background: color-mix(in srgb, #120c06 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent);
    border-radius: 999px;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: border-color 0.25s, background 0.25s;
  }
  .mt:hover { border-color: var(--gold); background: color-mix(in srgb, #201408 88%, transparent); }
  .mt__dot {
    inline-size: 7px; block-size: 7px; border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 8px var(--gold);
  }
  :global(html[data-motion='on']) .mt__dot { background: #7fd18a; box-shadow: 0 0 8px #7fd18a; }
  /* the style switcher already sits top-left; drop below it when cramped */
  @media (max-width: 62rem) { .mt { inset-block-start: 3.6rem; } }
  @media (max-width: 34rem) {
    .mt { inset-block-start: 6.1rem; inset-inline-start: 0.75rem; padding: 0.28rem 0.75rem; }
  }
</style>

<script>
  import { motionOn, setPref, applyPref, readPref } from '../scripts/motion';

  applyPref();
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  if (btn) {
    const label = btn.querySelector<HTMLElement>('.mt__label')!;

    const paint = () => {
      const on = motionOn();
      label.textContent = on ? label.dataset.offLabel! : label.dataset.onLabel!;
      // only for a visitor who has already chosen, either way; a new visitor
      // sees the museum move and no switch
      btn.hidden = on && readPref() === 'auto';
      btn.setAttribute('aria-pressed', String(on));
    };

    btn.addEventListener('click', () => { setPref(motionOn() ? 'off' : 'on'); paint(); });
    addEventListener('motionpref', paint);
    paint();
  }
</script>
