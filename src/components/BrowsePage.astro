---
import Base from '../layouts/Base.astro';
import ScrollCue from './ScrollCue.astro';
import VideoCard from './VideoCard.astro';
import { useT, type Lang } from '../i18n/ui';
import { videoList, videoCounts, categories, tags, generalLinks, totalSittings } from '../data/catalog';
import RoomBack from './RoomBack.astro';
import PageEmblem from './PageEmblem.astro';
import Explore from './Explore.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const videos = videoList();
const counts = videoCounts();

const cats = Object.entries(categories)
  .filter(([k]) => k !== 'nobel')
  .sort((a, b) => a[1].order - b[1].order);
const tagList = Object.entries(tags);

const KINDS = [
  { key: 'guide',   label: t('browse.kindGuide'),   n: counts.guide },
  { key: 'lecture', label: t('browse.kindLecture'), n: counts.lecture },
  { key: 'record',  label: t('browse.kindRecord'),  n: counts.record },
] as const;

/* the museum's own room behind this page too — see GalleryPage */
import { bright } from '../theme';
---

<Base lang={lang} title={t('browse.title')} segments={['lectures']} bare={bright}>
  {bright && <RoomBack lang={lang} room="video-hall" />}
  {bright && <PageEmblem src="assets/ui/video-emblem.webp" w={720} h={576} outside />}
  {/* The head stands outside the box that fades, exactly as the emblem beside
      it does and for the same reason — see 'what a room is called does not
      dissolve' in bright.css. */}
  <div class:list={['wrap', 'browse', 'browse--top', bright && 'room-head']}>
    {/* the emblem struck for this room, on the rail every room that is not a
        prize room hangs one from — see PageEmblem and .hall-head */}
    <header class:list={['browse__id', bright && 'hall-head']}>
      <h1 class="browse__h">{t('browse.title')}</h1>
      <p class="browse__kinds">{t('browse.kinds')}</p>
    </header>
    <p class="browse__lede hall-note"><span>{t('learn.toolAllD', { n: totalSittings() })}</span></p>
  </div>
  <div class="wrap browse browse--body" data-fade>
    <form class="filters" id="filters" aria-label={t('browse.title')}>
      <label class="search">
        <span class="visually-hidden">{t('browse.search')}</span>
        <svg class="search__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input type="search" name="q" placeholder={t('browse.searchPh')} autocomplete="off" />
      </label>

      <fieldset>
        <legend>{t('browse.filterKind')}</legend>
        <div class="chips">
          <label class="chip"><input type="radio" name="kind" value="" checked /><span class="museum-glass-btn museum-glass-btn--chip">{t('browse.filterAll')}</span></label>
          {KINDS.map((k) => (
            <label class="chip chip--kind" data-kind={k.key}>
              <input type="radio" name="kind" value={k.key} />
              <span class="museum-glass-btn museum-glass-btn--chip">{k.label} <b>{k.n}</b></span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend>{t('browse.filterCat')}</legend>
        <div class="chips">
          <label class="chip"><input type="radio" name="cat" value="" checked /><span class="museum-glass-btn museum-glass-btn--chip">{t('browse.filterAll')}</span></label>
          {cats.map(([k, v]) => (
            <label class="chip" data-cat={k}><input type="radio" name="cat" value={k} /><span class="museum-glass-btn museum-glass-btn--chip">{v[lang]}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend>{t('browse.filterTopic')}</legend>
        <div class="chips">
          <label class="chip"><input type="radio" name="tag" value="" checked /><span class="museum-glass-btn museum-glass-btn--chip">{t('browse.filterAll')}</span></label>
          {tagList.map(([k, v]) => (
            <label class="chip"><input type="radio" name="tag" value={k} /><span class="museum-glass-btn museum-glass-btn--chip">{v[lang]}</span></label>
          ))}
        </div>
      </fieldset>
    </form>

    <p class="count" id="count" aria-live="polite">{t('browse.results', { n: videos.length })}</p>
    <p class="empty" id="empty" hidden>{t('browse.empty')}</p>

    <ul class="grid" id="results" role="list">
      {videos.map((v) => (
        <li
          data-kind={v.kind}
          data-cat={v.category ?? ''}
          data-tags={v.topics.join(' ')}
          data-find={[
            v.personEn, v.personZh,
            v.lecture?.title.en, v.lecture?.title.zh,
            v.lecture?.hook.zh, v.lecture?.hook.en,
            v.lecture?.description.zh, v.lecture?.description.en,
            v.lecture?.affiliation.institution, v.lecture?.affiliation.country,
            v.lecture?.event.host_zh, v.lecture?.event.host_en,
            v.sourceZh, v.sourceEn,
            v.lecture?.prize.year,
          ].filter(Boolean).join(' ').toLowerCase()}>
          <VideoCard lang={lang} v={v} />
        </li>
      ))}
    </ul>
  </div>

  {/* The index of films ends the way the prize rooms and the laureate pages
      do — the same panel, the same list — except that a foot has a page's
      width to lay it out in rather than a 17rem rail. It carries the prize's
      own four, plus the two that are about the series rather than about one
      laureate; and it is the first four that wear the frame, because what the
      frame says here is 'this one is nobelprize.org'. Counted off the list
      itself rather than written as 4, so that a fifth page added to
      catalog.ts is marked without anyone remembering to come back here. */}
  <Explore lang={lang} note={t('explore.noteAll')} variant="panel"
           keys={generalLinks.length}
           items={[
             ...generalLinks.map((l) => ({
               url: l.url,
               title: lang === 'zh' ? l.zh : l.en,
               desc: lang === 'zh' ? l.dzh : l.den,
             })),
             { url: 'https://cge.ntu.edu.tw/cl_n_203079.html',
               title: t('lec.ntuCge'), desc: t('lec.ntuCgeNote') },
             { url: 'https://event.cw.com.tw/2026taiwanbridge/index.html',
               title: t('lec.cwHub'), desc: t('lec.cwHubNote') },
           ]} />

  {bright && <ScrollCue lang={lang} href="#results" />}
</Base>

<style>
  .browse { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .browse__h { font-size: var(--step-3); color: var(--cream); }
  .browse__kinds {
    margin: 0;
    font-size: var(--step-0);
    letter-spacing: 0.16em;
    text-indent: 0.16em;
    color: var(--gold);
  }
  :global(html:not([data-theme='bright'])) .browse__kinds { display: none; }
  :global(html[data-theme='bright']) .browse { padding-block-start: 3.4rem; }
  /* The page is two boxes now — the head, and everything under it — so the
     padding that opens the page belongs to the first of them and nothing at
     all belongs between them. .hall-head places itself by subtracting that
     same 3.4rem, so it has to be on the box the head is in. */
  .browse--top { padding-block-end: 0; }
  .browse--body { padding-block-start: 0; }
  :global(html[data-theme='bright']) .browse--body { padding-block-start: 0; }

  .filters { display: grid; gap: 1.1rem; margin-block: 1.8rem 1.4rem; }
  .search {
    position: relative; display: flex; align-items: center;
    border: 1px solid var(--line); border-radius: var(--radius-control);
    background: var(--surface); padding-inline: .95rem;
    max-inline-size: 30rem;
    transition: border-color .25s var(--ease), background .25s var(--ease);
  }
  .search:focus-within { border-color: var(--line-hi); background: var(--surface-hi); }
  .search__icon { flex: none; color: var(--muted-dim); }
  .search input {
    flex: 1; background: none; border: 0; outline: none;
    padding: .55rem .7rem; font: inherit; font-size: var(--step-0); color: var(--text);
  }
  .search input::placeholder { color: var(--muted-dim); }
  .search input::-webkit-search-cancel-button { filter: invert(.6) sepia(1) hue-rotate(340deg); }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  legend { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-dim); padding: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  /* The chip is painted by the button kit — see
     src/styles/liquid-glass-buttons.css — and nothing here may restyle it:
     Astro stamps its scope attribute on every compound, so a scoped rule
     beats the kit on specificity.

     The count keeps its lighter weight, and focus keeps its ring: the focus
     is on the radio, which the kit's :focus-visible cannot see. */
  .chip span b { font-weight: 400; opacity: 0.62; margin-inline-start: 0.2em; }
  .chip input:checked + span b { opacity: 0.75; }
  .chip input:focus-visible + span {
    outline: 2px solid color-mix(in srgb, var(--museum-red) 72%, white);
    outline-offset: 3px;
  }

  .count { font-size: var(--step--1); color: var(--muted); letter-spacing: 0.1em; margin-block-end: 1.2rem; }
  .empty { color: var(--muted); }
  .grid {
    display: grid; gap: clamp(0.9rem, 2vw, 1.5rem); padding: 0; margin: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
</style>

<script>
  const form = document.getElementById('filters') as HTMLFormElement | null;
  const list = document.getElementById('results');
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');
  if (form && list && count && empty) {
    const items = [...list.querySelectorAll<HTMLElement>('li')];
    const numFmt = (count.textContent ?? '').replace(/\d+/, '{n}');

    const apply = () => {
      const fd = new FormData(form);
      const q = String(fd.get('q') ?? '').trim().toLowerCase();
      const kind = String(fd.get('kind') ?? '');
      const cat = String(fd.get('cat') ?? '');
      const tag = String(fd.get('tag') ?? '');
      let n = 0;
      for (const li of items) {
        const ok =
          (!kind || li.dataset.kind === kind) &&
          (!cat || li.dataset.cat === cat) &&
          (!tag || (li.dataset.tags ?? '').split(' ').includes(tag)) &&
          (!q || (li.dataset.find ?? '').includes(q));
        li.hidden = !ok;
        if (ok) n++;
      }
      count.textContent = numFmt.replace('{n}', String(n));
      empty.hidden = n > 0;
      const url = new URL(location.href);
      for (const [k, v] of [['q', q], ['kind', kind], ['cat', cat], ['tag', tag]] as const) {
        v ? url.searchParams.set(k, v) : url.searchParams.delete(k);
      }
      history.replaceState(null, '', url);
    };

    const p = new URLSearchParams(location.search);
    for (const k of ['kind', 'cat', 'tag']) {
      const v = p.get(k);
      if (v) {
        const el = form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${CSS.escape(v)}"]`);
        if (el) el.checked = true;
      }
    }
    const qEl = form.querySelector<HTMLInputElement>('input[name="q"]');
    const fromUrl = new URLSearchParams(location.search).get('q');
    if (qEl && fromUrl) qEl.value = fromUrl;
    let qt = 0;
    qEl?.addEventListener('input', () => { clearTimeout(qt); qt = window.setTimeout(apply, 160); });
    form.addEventListener('change', apply);
    apply();
  }
</script>
