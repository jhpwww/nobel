---
import '../styles/global.css';
import '../styles/bright.css';
import '../styles/plinth.css';
/* the kit paints; buttons.css is the integration layer and must follow it */
import '../styles/liquid-glass-buttons.css';
import '../styles/buttons.css';
import fonts from '../data/font-manifest.json';
import fontsBright from '../data/font-manifest-bright.json';

/** set at build time — see the bright-museum note in astro.config.mjs */
const bright = process.env.THEME === 'bright';
/** this museum's faces: names, hashed URLs, and its own stylesheet */
const face: Record<string, string> = bright ? fontsBright : fonts;
import PageNav from '../components/PageNav.astro';
import SiteSearch from '../components/SiteSearch.astro';
import LangFlag from '../components/LangFlag.astro';
import { useT, HTML_LANG, LANG_LABEL, type Lang } from '../i18n/ui';
import { home, browse, about, learn, gallery, asset, otherLang } from '../i18n/routing';
import { INTRO } from '../data/catalog';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** path segments of the current page, so the language switch lands on its twin */
  segments?: (string | number)[];
  bare?: boolean;              // the great hall supplies its own header
}
const { lang, title, description, segments = [], bare = false } = Astro.props;
const t = useT(lang);
const other = otherLang(lang, ...segments);
const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- The glass rim is a picture and bright.css is a plain stylesheet, so the
     one thing in it that needs to know where the site is mounted is handed in
     here rather than hard-coded. See scripts/build-glass-frame.py. -->
<html lang={HTML_LANG[lang]} data-theme={bright ? 'bright' : undefined}
      data-home={segments.length === 0 ? '' : undefined}
      style={bright ? `--glass-frame: url('${asset('assets/ui/glass-frame.webp')}');`
                    + ` --plate: url('${asset('assets/ui/name-plate.webp')}');`
                    + ` --key-plate: url('${asset('assets/ui/key-plate.webp')}')` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#120c06" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" hreflang="zh-Hant" href={new URL(otherLang('en', ...segments).href, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(otherLang('zh', ...segments).href, Astro.site)} />

    <link rel="preconnect" href="https://i.ytimg.com" />
    {/* The three faces are self-hosted, subset to the glyphs this site renders
        — see scripts/subset-fonts.mjs. Google Fonts sent 2.1–3.6 MB of CJK
        chunks per page and put a third party in the request path of every
        visit, which the About page's privacy claim is better without.
        Body text is preloaded; the other two are wanted a moment later. */}
    {/* One museum, one set of faces. Both name families like 'Noto Serif TC',
        so the stylesheets are linked rather than bundled — bundling both let
        the browser match the other museum's declaration and fetch a file that
        is not there. */}
    <link rel="stylesheet" href={face._stylesheet} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={bright ? face['source-sans-3'] : face['noto-sans-tc']} />
    {bright && (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={face['noto-sans-tc']} />
    )}

    <!-- decide motion before first paint, so nothing flashes on either setting -->
    <script is:inline>
      (function () {
        var p = 'auto';
        try { p = localStorage.getItem('nlm:motion') || 'auto'; } catch (e) {}
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.setAttribute(
          'data-motion', p === 'auto' ? (reduce ? 'off' : 'on') : p
        );
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>

    {/* The room goes white and comes back. Walking from the hall into a prize
        page is a change of room, and a change of room in a museum is not a
        cut — it is a moment of nothing. This is a plain overlay rather than
        the View Transitions API because that means adopting a client router,
        and the whole site is static files that the browser can already load
        faster than any router would. */}
    {bright && <div class="roomfade" data-on aria-hidden="true"></div>}
    {/* Not inside the `bright &&` it belongs to. Astro hoists every <script>
        in a component and numbers them; a page that renders one of two
        conditional scripts gets the tag it asked for pointing at the OTHER
        one's module — a page that asks for the fade and is handed the bar's
        fold script holds its white sheet for ever. So both scripts are
        unconditional, and each decides for itself whether it has anything
        to do. */}
    <script>import '../scripts/roomfade';</script>
    {/* the bright museum's page-top dissolve is CSS alone — see 'the band
        every page dissolves into' in bright.css */}

    {bare && (
      <header class="topbar topbar--ghost">
        <div class="wrap topbar__in topbar__in--end">
          <nav class="topbar__nav" aria-label={t('nav.hall')}>
            {/* On the hall, on a phone, the keys start folded behind this one
                and open when the pieces withdraw — or when it is pressed. A
                column of five over the room is a column of five over the
                thing it is a door into; while the pieces are at full size the
                room should be what is in the window. It is rendered on every
                page so the markup does not fork, and hidden by CSS everywhere
                the fold does not apply. */}
            <button class="topbar__menu museum-glass-btn museum-glass-btn--nav" type="button"
                    aria-expanded="false" aria-controls="topbar-keys" aria-label={t('nav.menu')}>
              <span class="topbar__bars" aria-hidden="true"></span>
            </button>
            {/* The hall itself is one of these on every page but the hall,
                and there it is named for what pressing it does rather than for
                where it goes — on a page that is already a room in the museum,
                '博物館大廳' reads as a place and '回到大廳' as a door. */}
            {segments.length > 0 && <a class="topbar__key museum-glass-btn museum-glass-btn--nav" href={home(lang)}><span>{t('nav.backHall')}</span></a>}
            {/* the id the fold key points at goes on the first key that is on
                every page: the hall has no '回到大廳' of its own */}
            <a class="topbar__key museum-glass-btn museum-glass-btn--nav" id="topbar-keys" href={browse(lang)}><span>{t('nav.all')}</span></a>
            <a class="topbar__key museum-glass-btn museum-glass-btn--nav" href={learn(lang)}><span>{t('nav.learn')}</span></a>
            <a class="topbar__key museum-glass-btn museum-glass-btn--nav" href={gallery(lang, INTRO)}><span>{t('nav.prize')}</span></a>
            <a class="topbar__key museum-glass-btn museum-glass-btn--nav" href={about(lang)}><span>{t('nav.about')}</span></a>
            {/* Last of the keys, at the owner's word: the four doors are what
                the bar is for, and a search field is what you reach for when
                none of them is the answer. See SiteSearch. */}
            <SiteSearch lang={lang} only="key" />
            {/* The flag never folds. It is the one control a reader may want
                before anything else on the page makes sense to them. */}
            <a class="topbar__lang" href={other.href} lang={other.lang === 'zh' ? 'zh-Hant-TW' : 'en'}
               aria-label={LANG_LABEL[other.lang]} title={LANG_LABEL[other.lang]}>
              <LangFlag to={other.lang} />
            </a>
          </nav>
        </div>
      </header>
    )}
    <script>
      {/* The fold is CSS; this is the press, and — on every page but the
          hall — the point at which the keys open on their own.

            The hall has its own cue for that: its pieces withdraw, and it sets
            the same attribute when they do (see HallBright.astro), so the two
            agree without either knowing about the other. A page that is not
            the hall has no pieces to withdraw, so it counts scrolling instead:
            half a screen, which is the point at which the room the page opened
            with is no longer what is being looked at.

            Only the crossing is acted on, not every frame of it, so a press
            that disagrees with the current scroll position stands until the
            visitor scrolls past the line again. */}
        const root = document.documentElement;
        const btn = document.querySelector('.topbar__menu');
        btn?.addEventListener('click', () => {
          const open = root.toggleAttribute('data-nav-open');
          btn.setAttribute('aria-expanded', String(open));
        });

        /* only the pages that wear the hall's bar have keys to fold */
        if (btn && !root.hasAttribute('data-home')) {
          {/* `false`, not `null`: the attribute starts off the element, so
              false already is the state, and the pair are compared rather
              than the attribute re-set on every frame of a scroll. A null
              seed here is an implicit `any`, which `astro check` fails on —
              this block is type-checked like any other module. */}
          let open = false;
          let queued = false;
          const sync = () => {
            queued = false;
            const v = scrollY >= innerHeight / 2;
            if (v === open) return;
            open = v;
            root.toggleAttribute('data-nav-open', v);
            btn?.setAttribute('aria-expanded', String(v));
          };
          sync();
          addEventListener('scroll', () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(sync);
          }, { passive: true });
          addEventListener('resize', sync, { passive: true });
        }
    </script>

    {!bare && (
      <header class="topbar">
        <div class="wrap topbar__in">
          <a class="topbar__brand" href={home(lang)}>
            <img src={asset('ntu-logo.png')} alt="" width="34" height="34" />
            <span class="topbar__brand-txt">
              <span class="topbar__uni">{t('site.university')}</span>
              <span class="topbar__series">{t('site.tagline')}</span>
            </span>
          </a>
          <nav class="topbar__nav" aria-label={t('nav.hall')}>
            <a class="museum-glass-btn museum-glass-btn--nav" href={home(lang)}><span>{t('nav.backHall')}</span></a>
            <a class="museum-glass-btn museum-glass-btn--nav" href={browse(lang)}><span>{t('nav.all')}</span></a>
            <a class="museum-glass-btn museum-glass-btn--nav" href={learn(lang)}><span>{t('nav.learn')}</span></a>
            <a class="museum-glass-btn museum-glass-btn--nav" href={gallery(lang, INTRO)}><span>{t('nav.prize')}</span></a>
            <a class="museum-glass-btn museum-glass-btn--nav" href={about(lang)}><span>{t('nav.about')}</span></a>
            <SiteSearch lang={lang} only="key" />
            <a class="topbar__lang" href={other.href} lang={other.lang === 'zh' ? 'zh-Hant-TW' : 'en'}
               aria-label={LANG_LABEL[other.lang]} title={LANG_LABEL[other.lang]}>
              <LangFlag to={other.lang} />
            </a>
          </nav>
        </div>
      </header>
    )}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__in">
        <img class="foot__crest" src={asset('ntu-logo.png')} alt="" width="56" height="56" />
        <div class="foot__lines">
          <p class="foot__copy foot__copy--zh" lang="zh-Hant-TW"><span class="foot__uni">國立臺灣大學</span>&nbsp;&nbsp;版權所有，禁止擅自轉貼節錄。本站為教育用途之獨立專案，與諾貝爾基金會無隸屬關係。</p>
          <p class="foot__copy">Copyright &copy; 2026 National Taiwan University - All rights reserved.</p>
        </div>
      </div>
    </footer>

    <SiteSearch lang={lang} only="panel" />
    <PageNav lang={lang} />

    <style>
      .topbar {
        position: sticky;
        inset-block-start: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg-0) 88%, transparent);
        backdrop-filter: blur(10px);
        border-block-end: 1px solid var(--line);
      }
      /* over the hall: no panel, no brand — just a readability scrim so the
         controls stay legible against both the dark vault and the content
         further down the page */
      /* Out of flow, so the hall fills the viewport behind it rather than
         starting below a 54px band of bare body background — and therefore
         transparent to the pointer, because a bar with no panel is a bar with
         no surface. Fixed and full-width, its container was swallowing every
         tap in the strip it covers: on a phone, where the keys stack into a
         column, that strip is 200px tall and lands on the first row of
         sculptures and on the title of every prize page. Only the keys
         themselves take a press. */
      .topbar--ghost { pointer-events: none; }
      .topbar--ghost .topbar__nav a,
      .topbar--ghost button { pointer-events: auto; }
      .topbar--ghost {
        position: fixed;
        inset-inline: 0;
        inset-block-start: 0;
        background: none;
        backdrop-filter: none;
        border-block-end: 0;
      }
      /* the scrim is a pseudo-element so it can fade well past the bar's own
         height — a gradient squeezed into 3.4rem leaves a visible hard edge */
      .topbar--ghost::before {
        content: '';
        position: absolute;
        inset-inline: 0;
        inset-block-start: 0;
        block-size: 9rem;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(15, 10, 5, 0.66), rgba(15, 10, 5, 0.12) 55%, transparent);
      }
      .topbar--ghost .topbar__nav { position: relative; z-index: 1; }
      .topbar--ghost .topbar__in { justify-content: flex-end; min-block-size: 3.4rem; }

      .topbar__in {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-block-size: 4rem;
        flex-wrap: wrap;
      }
      .topbar__brand {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        text-decoration: none;
        color: var(--cream);
      }
      .topbar__brand img { border-radius: 50%; }
      .topbar__brand-txt { display: grid; line-height: 1.25; }
      .topbar__uni { font-size: var(--step--1); color: var(--muted); letter-spacing: 0.1em; }
      .topbar__series { font-family: var(--font-han-serif); font-size: var(--step-0); color: var(--cream); }

      .topbar__nav {
        display: flex; align-items: center; flex-wrap: wrap;
        /* Tight, at the owner's word: the keys are plates with their own edge,
           so the space between them only separates them. The mobile column sets
           its own gaps; see bright.css. */
        row-gap: 0.15rem; column-gap: clamp(0.113rem, 0.313vw, 0.238rem);
        justify-content: flex-end;
      }
      .topbar__nav a {
        /* a nav label is one word: let the bar wrap between items, never inside one */
        white-space: nowrap;
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        color: var(--muted);
        text-decoration: none;
        padding-block: 0.4rem;
        border-block-end: 1px solid transparent;
        transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
      }
      .topbar__nav a:hover { color: var(--gold-bright); border-block-end-color: var(--gold); }
      /* The flag is the button; the words stay for anyone who cannot see it,
         and are shown outright wherever there is room for them. */
      .topbar__lang {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        border: 1px solid var(--line) !important;
        border-radius: 999px;
        padding: 0.3rem 0.55rem !important;
        color: var(--gold) !important;
      }
      .topbar__lang:hover { background: var(--surface-hi); }

      .foot {
        margin-block-start: clamp(4rem, 10vw, 8rem);
        border-block-start: 1px solid var(--line);
        background: var(--bg-1);
        padding-block: 2.5rem 3rem;
      }
      .foot__in {
        display: flex;
        align-items: center;
        gap: clamp(0.7rem, 2vw, 1.4rem);
      }
      .foot__crest {
        flex: none;
        inline-size: clamp(34px, 4.4vw, 56px);
        block-size: auto;
        opacity: 0.92;
      }
      .foot__lines { display: grid; gap: 0.2rem; min-inline-size: 0; }
      /* On a desktop the copyright stays on one line at every width, so it
         scales with the viewport rather than wrapping. */
      .foot__copy {
        margin: 0;
        max-width: none;            /* global `p` caps at 62ch, which forced a wrap */
        color: var(--muted-dim);
        line-height: 1.8;
        white-space: nowrap;
        font-size: clamp(0.62rem, 1.55vw, 0.92rem);
      }
      /* A phone cannot have both. One unbroken line of 一 百 一 十 個 Han
         characters across 350px is 5.4px type, which is not small print, it is
         a texture — so on a phone the line wraps and is legible instead. */
      @media (max-width: 48rem) {
        .foot__copy {
          white-space: normal;
          font-size: clamp(0.68rem, 2.9vw, 0.86rem);
          line-height: 1.65;
        }
      }
      .foot__copy--zh { letter-spacing: 0.01em; }
      /* the university's own name reads first */
      .foot__uni {
        color: var(--cream);
        font-size: 1.22em;
        letter-spacing: 0.04em;
      }
      /* the crest takes width the line needs, so both shrink together here */
      @media (max-width: 26rem) {
        .foot .wrap { width: min(100% - 0.75rem, 76rem); }
        .foot__in { gap: 0.5rem; }
        .foot__crest { inline-size: 26px; }
      }
    </style>
  </body>
</html>
