---
import LecturePage from '../../../components/LecturePage.astro';
import { allLectures } from '../../../data/catalog';

export function getStaticPaths() {
  /* Both collections: the 31 of 臺灣橋樑計畫 and the NTU records.
     build-catalog.py refuses a duplicate id, so one page per address. */
  return allLectures().map((rec) => ({ params: { id: rec.id }, props: { rec } }));
}
const { rec } = Astro.props;
---
<LecturePage lang="en" rec={rec} />
